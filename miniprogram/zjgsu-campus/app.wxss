/* app.wxss 全局样式 */
page {
  background-color: #f4f5f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 页面进入动画：navigateTo 的系统转场结束时内容是「啪一下」全出来的，
   这里给整页内容一个 280ms 的淡入，视觉上接住转场，不再生硬。
   挂在 .container 上 = 全部 32 个页面自动生效，新页面也不用记得加 */
/* 注意：这里只能动 opacity，绝不能加 transform —— transform 一旦出现在
   动画里（fill-mode: both 会让它动画结束后仍然常驻），.container 就成了
   fixed 元素的包含块，页内所有 position:fixed（发帖按钮、详情页底部的
   「写评价」栏、备忘页的弹层）都会退化成「相对内容定位」，跟着内容跑，
   沉不到屏幕右下角。之前发帖按钮浮在半空就是这个原因。 */
@keyframes pageIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
  animation: pageIn 0.28s ease-out both;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn-primary {
  background: #1a5fb4;
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  padding: 22rpx 0;
  border: none;
}
.btn-primary::after { border: none; }
.btn-primary.btn-disabled { background: #b9c6d8; }

.btn-ghost {
  background: #eef3fb;
  color: #1a5fb4;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border: none;
}
.btn-ghost::after { border: none; }

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #1a5fb4;
  background: #eef3fb;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin: 0 12rpx 12rpx 0;
}
.tag.gray { color: #6b7280; background: #f0f1f3; }

/* 文字 */
.muted { color: #8a9099; font-size: 24rpx; }
.title-lg { font-size: 36rpx; font-weight: 600; }
.title-md { font-size: 30rpx; font-weight: 600; }

/* 星星 */
.star { color: #d9dde3; font-size: 28rpx; }
.star.on { color: #ff9f1c; }

/* 空状态 */
.empty {
  text-align: center;
  color: #b0b6be;
  padding: 120rpx 0;
  font-size: 26rpx;
}

/* 顶部搜索条 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 24rpx;
}
.search-bar input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 16rpx;
}
.search-icon { color: #b0b6be; font-size: 30rpx; }

/* 浮动发帖/发布按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1a5fb4;
  color: #fff;
  font-size: 56rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(26, 95, 180, 0.4);
}

/* ---------------------------------------------------------------
   按压反馈
   view 上挂 bindtap 时，微信默认不给任何视觉反馈，
   手指按下去界面纹丝不动，用户会以为没点中、反复戳。
   这里统一给「可点元素」加按下变暗 + 轻微缩放。
   button 自带按压态，不用管；这里管的是到处在用的 view。
   --------------------------------------------------------------- */
.tap {
  transition: transform .08s ease, opacity .08s ease;
}
.tap:active {
  transform: scale(0.96);
  opacity: .7;
}

/* 卡片类可点元素：按下整块微微下沉，反馈比按钮更含蓄 */
.tap-card {
  transition: transform .1s ease, box-shadow .1s ease;
}
.tap-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 列表行：按下变灰底，最接近"我确实点到了这一行"的直觉 */
.tap-row {
  transition: background-color .1s ease;
}
.tap-row:active {
  background-color: #eef1f5;
}

/* ---------------- 顶部 Banner 轮播（论坛 / 闲置分享 / 活动三个板块共用） ---------------- */
/* 里面是最热树洞 / 最急寻物 / 最火闲置，4 秒自动切；
   手指碰到轮播区域立即停（JS 里把 autoplay 关掉），移开恢复 —— 不跟手指抢滚动 */
.top-banner {
  height: 168rpx;
  margin: 0 4rpx 8rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.top-banner-item {
  display: flex;
  align-items: center;
  height: 168rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #1a5fb4 0%, #3577cf 60%, #5b8fd9 100%);
  color: #fff;
}
.top-banner-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}
.top-banner-main {
  flex: 1;
  min-width: 0;
}
.top-banner-tag {
  display: inline-block;
  font-size: 20rpx;
  line-height: 1.5;
  color: #dcebff;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 999rpx;
  padding: 0 14rpx;
  margin-bottom: 6rpx;
}
.top-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.top-banner-desc {
  font-size: 22rpx;
  color: #dcebff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.top-banner-go {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 12rpx;
}
/* 指示点：轮播底下一条小圆点，当前页亮白 */
.top-banner-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin: 0 0 12rpx;
}
.top-banner-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #d3d9e0;
  transition: all .25s ease;
}
.top-banner-dot.on {
  width: 28rpx;
  background: #1a5fb4;
}

/* ---------------- 帖子卡片入场动效（论坛话题流） ---------------- */
/* 新渲染出来的卡片淡入 + 轻缩放上浮；同一批最多 10 张，每张错开 30ms，
   有瀑布流「一层层冒出来」的沉浸感，又不至于等太久。
   已显示过的卡片不会重播（小程序节点复用），纯手动滑动体验不受影响 */
.post-anim {
  animation: postIn .3s ease both;
}
@keyframes postIn {
  from {
    opacity: 0;
    transform: scale(0.96) translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}
