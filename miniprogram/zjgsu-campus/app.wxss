/* ==========================================================================
   app.wxss —— 校园小站设计系统（原生版）
   迁移自 Vue3 + Tailwind 高保真原型（tailwind.config.ts）。

   设计令牌一览
     主色  brand-500 #2B5AED / brand-600 #2047C9 / brand-50  #eff4ff
     画布  canvas    #F5F7FA
     文字  ink       #172033 / muted #6F7B91 / faint #98A3B8
     描边  line      #E8EDF5
     场景  forum #7357FF / market #F58A32 / campus #19A66A
           profile 青蓝（.scene-profile 系列）
     圆角  外层卡片 32rpx / 内层 24rpx / 胶囊 999rpx
     阴影  卡片     0 8rpx 24rpx rgba(0,0,0,.05)
     字号  主标题 36rpx(700) / 正文 28rpx / 辅助 24rpx / 标签 20-22rpx
     热区  ≥ 88rpx

   两条硬约束（踩过坑，别改）：
   1) .container / .page-scroll 只允许动 opacity。一旦出现 transform，它们
      会成为 fixed 元素的包含块，页内所有 position:fixed（悬浮发帖按钮、
      底部输入栏、BottomSheet）都会退化成相对定位，沉不到屏幕底部。
   2) 不用 backdrop-filter / @property / clamp 等浏览器专属 API。毛玻璃一律
      用半透明背景 + 同色描边降级，视觉接近但兼容性稳。
   ========================================================================== */

page {
  background-color: #f5f7fa;
  color: #172033;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
input,
textarea {
  box-sizing: border-box;
}

/* --------------------------------------------------------------------------
   页面骨架
   -------------------------------------------------------------------------- */
.container {
  padding: 24rpx;
  min-height: 100vh;
}

@keyframes pageIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 只动 opacity，绝不加 transform，理由见文件头 */
.container,
.page-scroll {
  animation: pageIn 0.28s ease-out both;
}

.page-scroll {
  padding-bottom: 240rpx; /* 给底部 tabBar + 悬浮按钮留位 */
}

/* 固定底栏 / 悬浮按钮 / 抽屉的公共壳 */
.fixed-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 60;
}

.fab {
  position: fixed;
  right: 32rpx;
  z-index: 60;
}

/* --------------------------------------------------------------------------
   卡片
   -------------------------------------------------------------------------- */
.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.card--flat {
  box-shadow: none;
  border: 2rpx solid #e8edf5;
}

.card--flush {
  padding: 0;
  overflow: hidden;
}

/* 内层容器：24rpx 圆角，用在卡片内部的区块/条 */
.inner {
  border-radius: 24rpx;
}

.divider {
  height: 2rpx;
  background: #e8edf5;
  margin: 20rpx 0;
}

/* --------------------------------------------------------------------------
   文字
   -------------------------------------------------------------------------- */
.title-lg {            /* 主标题 36rpx 加粗 */
  font-size: 36rpx;
  font-weight: 700;
  color: #172033;
  line-height: 1.4;
}
.title-md { font-size: 30rpx; font-weight: 600; color: #172033; }
.title-sm { font-size: 28rpx; font-weight: 600; color: #172033; }
.body-text { font-size: 28rpx; color: #172033; }
.muted { font-size: 24rpx; color: #6f7b91; }
.faint { font-size: 22rpx; color: #98a3b8; }
.label { font-size: 20rpx; color: #98a3b8; }

.hint {
  font-size: 24rpx;
  color: #6f7b91;
  line-height: 1.7;
}

.strong { font-weight: 700; }
.center { text-align: center; }
.truncate { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.clamp2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* --------------------------------------------------------------------------
   场景色（论坛紫 / 闲置橙 / 校园绿 / 个人资料青蓝）
   -------------------------------------------------------------------------- */
.scene-brand   { color: #2b5aed; }
.scene-forum   { color: #7357ff; }
.scene-market  { color: #f58a32; }
.scene-campus  { color: #19a66a; }
.scene-profile { color: #2f9fd6; }
.scene-danger  { color: #dd4b55; }

.bg-brand-50   { background-color: #eff4ff; }
.bg-brand      { background-color: #2b5aed; }
.bg-forum-soft { background-color: #f1edff; }
.bg-forum      { background-color: #7357ff; }
.bg-market-soft{ background-color: #fff3e9; }
.bg-market     { background-color: #f58a32; }
.bg-campus-soft{ background-color: #e9f8f1; }
.bg-campus     { background-color: #19a66a; }
.bg-profile-soft { background-color: #e7f5fd; }
.bg-profile    { background-color: #2f9fd6; }
.bg-danger-soft{ background-color: #fff0f1; }
.bg-slate-50   { background-color: #f6f8fb; }
.bg-slate-100  { background-color: #eef1f6; }
.bg-line       { background-color: #e8edf5; }
.bg-white      { background-color: #ffffff; }
.bg-canvas     { background-color: #f5f7fa; }

.text-brand   { color: #2b5aed; }
.text-forum   { color: #7357ff; }
.text-market  { color: #f58a32; }
.text-campus  { color: #19a66a; }
.text-profile { color: #2f9fd6; }
.text-danger  { color: #dd4b55; }
.text-white   { color: #ffffff; }
.text-muted   { color: #6f7b91; }
.text-faint   { color: #98a3b8; }
.text-amber   { color: #d98c0b; }

/* 主色进度条 / 标签底色，供 vote-card 等组件复用 */
.brand-soft-bg    { background-color: #eff4ff; }
.brand-soft-text  { color: #2047c9; }
.forum-soft-bg    { background-color: #f1edff; }
.forum-soft-text  { color: #7357ff; }
.market-soft-bg   { background-color: #fff3e9; }
.market-soft-text { color: #d9731f; }
.campus-soft-bg   { background-color: #e9f8f1; }
.campus-soft-text { color: #128a56; }

/* --------------------------------------------------------------------------
   按钮 / 胶囊
   -------------------------------------------------------------------------- */
.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.pill--sm { padding: 0 24rpx; font-size: 24rpx; }
.pill--block { display: flex; width: 100%; }

.btn-primary {
  background: #2b5aed;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(43, 90, 237, 0.18);
}
.btn-secondary {
  background: #eff4ff;
  color: #2047c9;
  border: 2rpx solid #dce7ff;
}
.btn-danger {
  background: #fff0f1;
  color: #dd4b55;
}
.btn-disabled {
  background: #b9c6d8;
  color: #ffffff;
  box-shadow: none;
}

/* 按压反馈：所有可点击 view/button 都要带 .tap 或 .pressable */
.tap,
.pressable {
  transition: opacity 0.15s ease, background-color 0.15s ease, transform 0.12s ease;
}
.pressable:active,
.tap:active {
  opacity: 0.72;
  transform: scale(0.985);
}
/* 热区：至少 88rpx */
.hit {
  min-height: 88rpx;
  min-width: 88rpx;
  display: flex;
  align-items: center;
}

/* --------------------------------------------------------------------------
   标签
   -------------------------------------------------------------------------- */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  line-height: 1.5;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #eff4ff;
  color: #2047c9;
}
.tag--gray   { background: #eef1f6; color: #6f7b91; }
.tag--campus { background: #e9f8f1; color: #128a56; }
.tag--forum  { background: #f1edff; color: #7357ff; }
.tag--market { background: #fff3e9; color: #d9731f; }
.tag--danger { background: #fff0f1; color: #dd4b55; }

/* --------------------------------------------------------------------------
   列表行（我的 / 私信 / 收藏等）
   -------------------------------------------------------------------------- */
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 24rpx 32rpx;
  background: #ffffff;
}
.row + .row { border-top: 2rpx solid #e8edf5; }

/* --------------------------------------------------------------------------
   搜索框 / 筛选
   -------------------------------------------------------------------------- */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.search-bar input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #172033;
}

/* 横向滚动条：隐藏原生滚动条，保持胶囊排布 */
.no-scrollbar ::-webkit-scrollbar { display: none; }
.no-scrollbar { scrollbar-width: none; }
.chip-row {
  display: flex;
  gap: 16rpx;
  white-space: nowrap;
  padding-bottom: 4rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #ffffff;
  color: #6f7b91;
  border: 2rpx solid #e8edf5;
}
.chip-on {
  background: #2b5aed;
  color: #ffffff;
  border-color: #2b5aed;
  box-shadow: 0 4rpx 16rpx rgba(43, 90, 237, 0.2);
}
.chip-empty { opacity: 0.45; }

/* 分段控件（课程/老师这类二选一） */
.segmented {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #eef1f6;
}
.segmented-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #6f7b91;
  transition: background-color 0.2s ease, color 0.2s ease;
}
.segmented-item-on {
  background: #ffffff;
  color: #2b5aed;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  font-weight: 600;
}

/* 顶部吸顶筛选栏 */
.sticky-filter {
  position: sticky;
  top: 0;
  z-index: 40;
  padding: 16rpx 0;
  background: #f5f7fa;
}
.sticky-filter--blur {
  /* 毛玻璃降级：半透明 + 同色描边，不用 backdrop-filter */
  background: rgba(245, 247, 250, 0.94);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.8);
}

/* --------------------------------------------------------------------------
   BottomSheet（半屏抽屉）
   -------------------------------------------------------------------------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(23, 32, 51, 0.35);
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 95;
  max-height: 76vh;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(23, 32, 51, 0.14);
  padding: 24rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(0);
  transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.sheet--closed { transform: translateY(105%); }
.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e0e5ee;
  margin: 0 auto 24rpx;
}

/* --------------------------------------------------------------------------
   骨架屏
   -------------------------------------------------------------------------- */
@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
.skeleton {
  background: #eef1f6;
  border-radius: 16rpx;
  animation: skeletonPulse 1.4s ease-in-out infinite;
}

/* --------------------------------------------------------------------------
   空状态
   -------------------------------------------------------------------------- */
.empty {
  padding: 80rpx 48rpx;
  text-align: center;
  color: #6f7b91;
}
.empty-title { font-size: 30rpx; font-weight: 600; color: #172033; }
.empty-desc { margin-top: 12rpx; font-size: 24rpx; color: #6f7b91; line-height: 1.7; }
