<!-- utils/banner.wxml —— 顶部 Banner 轮播片段（论坛 / 闲置分享 / 活动三个板块 include） -->
<!-- 数据与方法都在各页面：banner（条目数组）、bannerIdx（当前页）、bannerAutoplay（自动切换开关）。
     自动切换 4 秒一张；手指一碰立刻停（bannerAutoplay=false），抬手 / 划出恢复，
     这两件事由 bannerTouchStart / bannerTouchEnd / bannerTouchCancel 三个事件负责。 -->
<swiper
  wx:if="{{banner.length}}"
  class="top-banner"
  autoplay="{{bannerAutoplay}}"
  interval="4000"
  duration="600"
  circular="{{banner.length > 1}}"
  current="{{bannerIdx}}"
  bindchange="onBannerChange"
  bindtouchstart="onBannerTouchStart"
  bindtouchend="onBannerTouchEnd"
  bindtouchcancel="onBannerTouchCancel"
>
  <swiper-item wx:for="{{banner}}" wx:key="key" wx:for-item="b">
    <view class="top-banner-item tap" data-idx="{{index}}" bindtap="onBannerTap">
      <view class="top-banner-icon">{{b.icon}}</view>
      <view class="top-banner-main">
        <view class="top-banner-tag">{{b.tag}}</view>
        <view class="top-banner-title">{{b.title}}</view>
        <view wx:if="{{b.desc}}" class="top-banner-desc">{{b.desc}}</view>
      </view>
      <view class="top-banner-go">›</view>
    </view>
  </swiper-item>
</swiper>
<view wx:if="{{banner.length > 1}}" class="top-banner-dots">
  <view
    wx:for="{{banner}}"
    wx:key="key"
    class="top-banner-dot {{bannerIdx === index ? 'on' : ''}}"
  ></view>
</view>
