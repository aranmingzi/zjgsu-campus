<view class="container">
  <view class="card">
    <view class="f-label">我要发的是</view>
    <view class="type-row">
      <view
        wx:for="{{types}}"
        wx:key="key"
        class="type {{typeMap[item.key] ? 'on' : ''}} tap"
        data-k="{{item.key}}"
        bindtap="onType"
      >{{item.icon}} {{item.label}}</view>
    </view>
  </view>

  <view class="card">
    <input
      class="f-input"
      placeholder="一句话说清，如「校园卡」"
      value="{{title}}"
      data-k="title"
      maxlength="40"
      bindinput="onInput"
    />
    <textarea
      class="f-textarea"
      placeholder="什么时候在哪、有什么特征、希望对方怎么做"
      value="{{desc}}"
      data-k="desc"
      maxlength="500"
      bindinput="onInput"
      auto-height
    >
    </textarea>
    <view class="f-counter">{{desc.length}}/500</view>
  </view>

  <!-- 一卡一件事：地点（+价格）一张、联系方式一张，和页面其他卡的节奏一致。
       以前三件事挤一张卡，靠淡线分隔，怎么看都糊 -->
  <view class="card">
    <view class="f-label">在哪里</view>
    <input
      class="f-input"
      placeholder="比如「教学楼」「健身房门口」"
      value="{{location}}"
      data-k="location"
      maxlength="40"
      bindinput="onInput"
    />
    <view wx:if="{{showPrice}}" class="f-line">
      <text class="f-prefix">¥</text>
      <input
        class="f-input f-price"
        placeholder="参考价，可接受面议就留空"
        value="{{price}}"
        data-k="price"
        maxlength="20"
        bindinput="onInput"
      />
    </view>
  </view>

  <view class="card">
    <view class="f-label">怎么联系你</view>
    <input
      class="f-input"
      placeholder="手机号 / 微信号，找到你"
      value="{{contact}}"
      data-k="contact"
      maxlength="40"
      bindinput="onInput"
    />
    <view class="ct-row">
      <view
        wx:for="{{contactTypes}}"
        wx:key="key"
        class="ct {{contactTypeMap[item.key] ? 'on' : ''}} tap"
        data-k="{{item.key}}"
        bindtap="onContactType"
      >{{item.label}}</view>
    </view>
    <view class="f-privacy">联系方式只在这条信息里公开</view>
  </view>

  <!-- 闲置分类 + 教材对应的课程名（只在「闲置分享」时出现） -->
  <view wx:if="{{showCategory}}" class="card">
    <view class="f-label">这是什么类型的闲置</view>
    <view class="ct-row">
      <view
        wx:for="{{cats}}"
        wx:for-item="c"
        wx:key="key"
        class="ct {{catMap[c.key] ? 'on' : ''}} tap"
        data-k="{{c.key}}"
        bindtap="onCategory"
      >{{c.icon}} {{c.label}}</view>
    </view>
    <view wx:if="{{category === 'book'}}" class="f-line">
      <input
        class="f-input"
        placeholder="课程名，如「中级财务会计」"
        value="{{courseName}}"
        data-k="courseName"
        maxlength="30"
        bindinput="onInput"
      />
    </view>
  </view>

  <view class="card">
    <view class="f-label">图片（选填，最多 6 张）</view>
    <view class="img-grid">
      <view
        wx:for="{{images}}"
        wx:key="*this"
        class="img-cell"
      >
        <image class="img" src="{{item}}" mode="aspectFill"></image>
        <view class="img-del tap" data-i="{{index}}" catchtap="removeImage">✕</view>
      </view>
      <view wx:if="{{images.length < 6}}" class="img-cell add tap" bindtap="chooseImages">＋</view>
    </view>
  </view>

  <view class="card f-foot">
    <view class="f-btns">
      <button class="btn-ghost f-draft tap" bindtap="onDraft">存草稿</button>
      <button class="btn-primary f-submit tap" bindtap="onSubmit" disabled="{{uploading}}">
        {{uploading ? '上传中…' : '发布'}}
      </button>
    </view>
  </view>
</view>
