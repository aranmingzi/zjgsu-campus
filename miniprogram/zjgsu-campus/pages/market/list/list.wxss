/* 失物招领 / 二手交易 列表 */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  padding: 14rpx 0;
  border-radius: 12rpx;
}
.tab.on {
  background: #1a5fb4;
  color: #fff;
  font-weight: 500;
}

/* 我发布的入口：tabBar 化之后必须有这里，
   不然发了东西找不着地方管理 */
/* 学习资料入口：跟「我发布的」同一行的水平卡片 */
.res-entry {
  display: flex;
  align-items: center;
  background: #fff7e8;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 20rpx;
}
.res-icon { font-size: 40rpx; }
.res-body { flex: 1; margin-left: 18rpx; overflow: hidden; }
.res-title { font-size: 28rpx; color: #1f2430; }
.res-sub {
  font-size: 22rpx;
  color: #9a8b6f;
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 380rpx;
}
.res-go { font-size: 25rpx; color: #c98a1c; }

.my-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
}
.my-entry-txt {
  font-size: 28rpx;
  color: #1f2430;
}
.my-entry-go {
  font-size: 26rpx;
  color: #1a5fb4;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}
.clear-btn {
  color: #b0b6be;
  padding: 0 12rpx;
}

.m-item {
  padding-bottom: 20rpx;
}

.m-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.m-kind {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.k-lost { color: #c2410c; background: #fff1e8; }
.k-found { color: #0f6e56; background: #e1f5ee; }
.k-sell { color: #185fa5; background: #e6f1fb; }

.m-done {
  margin-left: auto;
  font-size: 22rpx;
  color: #9aa0a6;
  background: #f0f1f3;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.m-mine {
  margin-left: auto;
  font-size: 22rpx;
  color: #fff;
  background: #1a5fb4;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.m-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.5;
}
.m-desc {
  font-size: 26rpx;
  color: #5f6672;
  margin-top: 10rpx;
  line-height: 1.6;
}

.m-imgs {
  display: flex;
  margin-top: 16rpx;
  gap: 12rpx;
}
.m-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
}

.m-foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  gap: 20rpx;
}
.m-loc { font-size: 24rpx; color: #8a9099; }
.m-price { font-size: 30rpx; color: #d85a30; font-weight: 600; }
.m-time { margin-left: auto; }

.load-end {
  text-align: center;
  color: #b0b6be;
  font-size: 24rpx;
  padding: 30rpx 0 120rpx;
}

.empty-icon { font-size: 70rpx; }
.empty-hint {
  font-size: 24rpx;
  color: #c4c9d0;
  margin-top: 16rpx;
}

/* 骨架屏 */
.sk-wrap { padding-top: 10rpx; }
.sk-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f1f3 25%, #e6e8eb 37%, #f0f1f3 63%);
  background-size: 400% 100%;
  animation: sk 1.2s ease-in-out infinite;
  margin-bottom: 16rpx;
}
.sk-title { width: 55%; height: 30rpx; }
.sk-short { width: 35%; }
.sk-mid { width: 80%; margin-bottom: 0; }
@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* 分类筛选（教材专区） */
.cat-row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 0 16rpx;
}
.cat-chip {
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  color: #5f6368;
  background: #fff;
  border: 1rpx solid #e3e6ea;
  border-radius: 28rpx;
}
.cat-chip.on {
  color: #fff;
  background: #1a5fb4;
  border-color: #1a5fb4;
}
.m-course {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #1a5fb4;
  background: #f0f5fc;
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

/* 精准 / 模糊 切换：和课程页、论坛页同一个样子 */
.mode-row {
  display: flex;
  align-items: center;
  margin: 0 0 16rpx;
}
.mode-chip {
  font-size: 24rpx;
  color: #6b7280;
  background: #fff;
  border: 1rpx solid #e6e9ee;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin-right: 14rpx;
}
.mode-chip.on {
  color: #fff;
  background: #1a5fb4;
  border-color: #1a5fb4;
  font-weight: 600;
}
.mode-hint {
  font-size: 21rpx;
  color: #b0b6be;
  margin-left: auto;
}
