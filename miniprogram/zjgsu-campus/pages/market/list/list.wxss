/* pages/market/list/list.wxss —— 闲置 / 失物招领 列表
   场景色：闲置橙 #F58A32 / 浅底 #FFF3E9 / 标签文字 #D9731F
   只写本页语义类，通用的（.card / .tag--market / .skeleton / .pressable）都走 app.wxss */

/* ---------- 吸顶：搜索 + 分类胶囊 ---------- */
.list-pill { margin-top: 16rpx; }

.search-bar__icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.search-bar__input { flex: 1; min-width: 0; font-size: 28rpx; }
.search-bar__clear { padding: 0 12rpx; }
.search-bar__clear-icon { width: 32rpx; height: 32rpx; }

/* ---------- 学习资料共享入口卡 ---------- */
.res-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: #fff3e9;
  box-shadow: 0 8rpx 24rpx rgba(245, 138, 50, 0.1);
}
.res-entry--hover { opacity: 0.72; }
.res-entry__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #f58a32;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.res-entry__icon image { width: 44rpx; height: 44rpx; }
.res-entry__body { flex: 1; min-width: 0; }
.res-entry__title { font-size: 28rpx; font-weight: 600; color: #172033; }
.res-entry__sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6f7b91;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.res-entry__go { flex-shrink: 0; font-size: 24rpx; font-weight: 600; color: #d9731f; }
.res-entry__chevron { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* ---------- 我发布的入口 ---------- */
.my-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.my-entry--hover { opacity: 0.72; }
.my-entry__icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.my-entry__title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600; }
.my-entry__go { flex-shrink: 0; font-size: 24rpx; color: #6f7b91; }
.my-entry__chevron { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* ---------- 信息墙标题 ---------- */
.wall-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

/* ---------- 骨架屏 ---------- */
.sk-wrap { margin-bottom: 24rpx; }
.sk-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.sk-line { margin-bottom: 16rpx; }
.sk-title { width: 55%; height: 30rpx; }
.sk-short { width: 35%; }
.sk-mid { width: 80%; margin-bottom: 0; }

/* ---------- 空状态：牛皮纸袋 ---------- */
.empty-bag { padding: 12rpx 0 32rpx; }
.empty-bag__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 48rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.empty-bag__img { width: 400rpx; height: 340rpx; }
.empty-bag__title { margin-top: 8rpx; font-size: 30rpx; font-weight: 600; color: #172033; }
.empty-bag__desc {
  margin-top: 12rpx;
  max-width: 440rpx;
  font-size: 24rpx;
  color: #6f7b91;
  line-height: 1.7;
}
.empty-bag__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 88rpx;
  margin-top: 32rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  background: #f58a32;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(245, 138, 50, 0.22);
}
.empty-bag__cta--hover { opacity: 0.72; }
.empty-bag__cta-icon { width: 32rpx; height: 32rpx; }

/* ---------- 信息墙卡片 ---------- */
.m-item { padding: 28rpx; }
.m-item--hover { opacity: 0.72; }

.m-item__top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.m-item__kind { display: inline-flex; align-items: center; gap: 6rpx; }
.m-item__kind-icon { width: 24rpx; height: 24rpx; }
.m-item__state {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #6f7b91;
  background: #eef1f6;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.m-item__state--mine { color: #ffffff; background: #f58a32; }

.m-item__title { font-size: 30rpx; font-weight: 600; line-height: 1.45; color: #172033; }
.m-item__course {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #2047c9;
  background: #eff4ff;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.m-item__desc { margin-top: 12rpx; font-size: 26rpx; color: #6f7b91; line-height: 1.6; }

.m-item__imgs { display: flex; gap: 12rpx; margin-top: 20rpx; }
.m-item__img {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #f4f5f7;
}

.m-item__foot { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.m-item__loc { flex: 1; min-width: 0; display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: #98a3b8; }
.m-item__loc image { width: 24rpx; height: 24rpx; flex-shrink: 0; }
.m-item__loc text { min-width: 0; }
.m-item__price { flex-shrink: 0; font-size: 32rpx; font-weight: 700; color: #f58a32; }
.m-item__time { flex-shrink: 0; }

.load-end { text-align: center; color: #98a3b8; font-size: 24rpx; padding: 16rpx 0 140rpx; }

/* ---------- 悬浮发布按钮（.fab 只是固定壳，尺寸在本页补全） ---------- */
.ml-fab {
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: #f58a32;
  box-shadow: 0 10rpx 28rpx rgba(245, 138, 50, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ml-fab--hover { opacity: 0.78; }
.ml-fab__icon { width: 52rpx; height: 52rpx; }
