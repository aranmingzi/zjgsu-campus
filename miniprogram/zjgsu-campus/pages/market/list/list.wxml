<!-- pages/market/list/list.wxml —— 闲置 / 失物招领 列表（tab 页，用原生导航条） -->
<view class="container">
  <!-- 吸顶区：搜索 + 分类胶囊（全部 / 寻物 / 招领 / 闲置），橙色场景色 -->
  <sticky-filter blur>
    <view class="search-bar">
      <image class="search-bar__icon" src="/assets/icons/search--faint.svg" mode="aspectFit" />
      <input
        class="search-bar__input"
        placeholder="搜丢失的物品 / 闲置"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onSearch"
        bindconfirm="onSearch"
      />
      <view
        wx:if="{{keyword}}"
        class="search-bar__clear hit pressable"
        bindtap="onSearchClear"
      >
        <image class="search-bar__clear-icon" src="/assets/icons/x--muted.svg" mode="aspectFit" />
      </view>
    </view>

    <pill-selector
      class="list-pill"
      items="{{tabKeys}}"
      value="{{tab}}"
      labels="{{tabLabels}}"
      accent="market"
      bindchange="onPillChange"
    />
  </sticky-filter>

  <!-- 顶部 Banner：全站最热树洞 / 最急寻物 / 最火闲置，自动缓慢切换，触摸即停 -->
  <include src="/utils/banner.wxml"/>

  <!-- 学习资料共享：笔记、真题和讲义，上传后全校都能用 -->
  <view
    class="res-entry pressable"
    hover-class="res-entry--hover"
    hover-stay-time="80"
    bindtap="goResources"
  >
    <view class="res-entry__icon">
      <image src="/assets/icons/book-open-check--white.svg" mode="aspectFit" />
    </view>
    <view class="res-entry__body">
      <view class="res-entry__title">学习资料共享</view>
      <view class="res-entry__sub">笔记、真题和讲义，上传后全校同学都能用</view>
    </view>
    <text class="res-entry__go">去分享</text>
    <image class="res-entry__chevron" src="/assets/icons/chevron-right--market.svg" mode="aspectFit" />
  </view>

  <!-- 我发布的：管理、标记已解决、删除都在这个页面里 -->
  <view
    class="my-entry pressable"
    hover-class="my-entry--hover"
    hover-stay-time="80"
    bindtap="myTap"
  >
    <image class="my-entry__icon" src="/assets/icons/shopping-bag--muted.svg" mode="aspectFit" />
    <text class="my-entry__title">我发布的</text>
    <text class="my-entry__go">管理</text>
    <image class="my-entry__chevron" src="/assets/icons/chevron-right--muted.svg" mode="aspectFit" />
  </view>

  <view class="wall-head">
    <text class="title-md">校园信息墙</text>
    <text class="faint">{{items.length}} 条示例</text>
  </view>

  <!-- 首屏骨架屏：只有第一次加载才有，之后都是直接出结果 -->
  <view wx:if="{{loading}}" class="sk-wrap">
    <view class="sk-card">
      <view class="skeleton sk-line sk-title"></view>
      <view class="skeleton sk-line sk-short"></view>
      <view class="skeleton sk-line sk-mid"></view>
    </view>
    <view class="sk-card">
      <view class="skeleton sk-line sk-title"></view>
      <view class="skeleton sk-line sk-mid"></view>
    </view>
  </view>

  <!-- 空状态：牛皮纸袋插画 + 文案 + 发布 CTA -->
  <view wx:elif="{{items.length === 0}}" class="empty-bag">
    <view class="empty-bag__card">
      <image
        class="empty-bag__img"
        src="/assets/illustrations/empty-market-bag.svg"
        mode="aspectFit"
      />
      <view class="empty-bag__title">这里空空如也</view>
      <view class="empty-bag__desc">快去发布你的第一件闲置吧，让好物在校园里继续流转。</view>
      <view
        class="empty-bag__cta pressable"
        hover-class="empty-bag__cta--hover"
        hover-stay-time="80"
        bindtap="goEdit"
      >
        <image class="empty-bag__cta-icon" src="/assets/icons/plus--white.svg" mode="aspectFit" />
        <text>发布第一件闲置</text>
      </view>
    </view>
  </view>

  <view wx:else>
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="card m-item pressable"
      data-id="{{item.id}}"
      hover-class="m-item--hover"
      hover-stay-time="80"
      bindtap="goDetail"
    >
      <view class="m-item__top">
        <view class="m-item__kind {{item.type === 'sell' ? 'tag--market' : 'tag--brand'}}">
          <image
            class="m-item__kind-icon"
            src="{{item.type === 'sell' ? '/assets/icons/shopping-bag--market.svg' : '/assets/icons/tag--brand.svg'}}"
            mode="aspectFit"
          />
          <text>{{item.type === 'sell' ? '闲置' : (item.type === 'found' ? '招领' : '寻物')}}</text>
        </view>
        <view wx:if="{{item.done}}" class="m-item__state">已解决</view>
        <view wx:elif="{{item.isMine}}" class="m-item__state m-item__state--mine">我发布的</view>
      </view>

      <view class="m-item__title">{{item.title}}</view>
      <!-- 教材按课程名挂，搜「微积分」就能找到对应的书 -->
      <view wx:if="{{item.courseName}}" class="m-item__course">教材 · {{item.courseName}}</view>
      <view wx:if="{{item.desc}}" class="m-item__desc clamp2">{{item.desc}}</view>

      <view wx:if="{{item.images && item.images.length}}" class="m-item__imgs">
        <image
          wx:for="{{item.images}}"
          wx:for-item="src"
          wx:key="*this"
          class="m-item__img"
          src="{{src}}"
          mode="aspectFill"
          lazy-load
          data-imgs="{{item.images}}"
          catchtap="previewImages"
        ></image>
      </view>

      <view class="m-item__foot">
        <view wx:if="{{item.location}}" class="m-item__loc">
          <image src="/assets/icons/map-pin--muted.svg" mode="aspectFit" />
          <text class="truncate">{{item.location}}</text>
        </view>
        <text wx:if="{{item.price}}" class="m-item__price">¥{{item.price}}</text>
        <text class="faint m-item__time">{{item.time}}</text>
      </view>
    </view>

    <view wx:if="{{noMore}}" class="load-end">— 到底了 —</view>
  </view>

  <!-- 悬浮发布按钮：tabBar 之上，压在固定底栏位置 -->
  <view
    class="fab ml-fab pressable"
    hover-class="ml-fab--hover"
    hover-stay-time="80"
    bindtap="goEdit"
  >
    <image class="ml-fab__icon" src="/assets/icons/plus--white.svg" mode="aspectFit" />
  </view>
</view>
