.empty-btn {
  margin-top: 30rpx;
  display: inline-block;
  color: #1a5fb4;
  background: #eef3fb;
  border-radius: 999rpx;
  padding: 18rpx 50rpx;
  font-size: 28rpx;
}

.m-done { margin-left: auto; }
.m-kind { display: inline-block; }
.m-top { display: flex; align-items: center; margin-bottom: 12rpx; }
.k-lost { color: #c2410c; background: #fff1e8; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; }
.k-found { color: #0f6e56; background: #e1f5ee; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; }
.k-sell { color: #185fa5; background: #e6f1fb; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; }
.m-title { font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.m-desc { font-size: 26rpx; color: #5f6672; margin-top: 10rpx; line-height: 1.6; }
.m-foot { display: flex; align-items: center; margin-top: 16rpx; }
.m-time { margin-left: auto; }
.m-price { font-size: 30rpx; color: #d85a30; font-weight: 600; }

.sk-wrap { padding-top: 10rpx; }
.sk-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f1f3 25%, #e6e8eb 37%, #f0f1f3 63%);
  background-size: 400% 100%;
  animation: sk 1.2s ease-in-out infinite;
  margin-bottom: 16rpx;
}
.sk-title { width: 55%; height: 30rpx; }
.sk-mid { width: 80%; margin-bottom: 0; }
@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
