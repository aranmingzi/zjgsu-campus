/* pages/mine/favorites/favorites.wxss —— 我的收藏
   复用 app.wxss：.container / .card / .tag / .segmented / .segmented-item-on /
   .clamp2 / .faint。本页独有的全部是 fv-*，场景色沿用设计令牌。 */

.fv-page { padding-top: 8rpx; }
.fv-tabs { margin-bottom: 20rpx; }

.fv-loading { padding: 60rpx 0; text-align: center; font-size: 26rpx; color: #98a3b8; }

.fv-count { margin: 0 8rpx 12rpx; }

/* ---------- 收藏卡片 ---------- */
.fv-item { padding-bottom: 20rpx; }
.fv-item--hover { opacity: 0.72; }

.fv-item__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

/* 四种内容各用一种场景色，扫一眼就知道收的是课、是贴还是闲置 */
.fv-tag.t-course { background: #eff4ff; color: #2047c9; }
.fv-tag.t-post { background: #f1edff; color: #7357ff; }
.fv-tag.t-review { background: #e9f8f1; color: #128a56; }
.fv-tag.t-market { background: #fff3e9; color: #d9731f; }

.fv-item__unfavorite {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 4rpx 0 16rpx;
  font-size: 24rpx;
  color: #6f7b91;
}
.fv-item__unfavorite--hover { opacity: 0.6; }
.fv-item__unfavorite-icon { width: 30rpx; height: 30rpx; }

.fv-item__title { font-size: 30rpx; font-weight: 600; color: #172033; line-height: 1.5; }
.fv-item__desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6f7b91;
  line-height: 1.6;
}
