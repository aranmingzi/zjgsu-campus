<!-- pages/mine/mine.wxml —— 我的（tab 页：原生导航条 + 原生 tabBar，不加 custom）
     Web 参考：src/views/mine/MineHomeView.vue
     顶部青蓝 → 主色渐变个人区 / 三个数字卡 / 四个入口行（tone 分色）/ 去树洞卡 /
     两个隐私入口行。行分组用 app.wxss 的 .row + .card--flush（分隔由 .row + .row 给出）。
     数据字段全部沿用 mine.js：user / myReviews / myPosts / favoriteCount / draftCount /
     unreadChat / memoStreak / friendCount / isMod / registered。 -->
<view class="container mn-page">

  <!-- ---------------- 个人区：整块可点，进「编辑资料」 ---------------- -->
  <view
    class="mn-hero pressable"
    hover-class="mn-hero--hover"
    hover-stay-time="80"
    bindtap="onEditProfile"
  >
    <view class="mn-hero__row">
      <view class="mn-hero__avatar">
        <image
          wx:if="{{user.avatar}}"
          class="mn-hero__avatar-img"
          src="{{user.avatar}}"
          mode="aspectFill"
        ></image>
        <view wx:else class="mn-hero__avatar-text">{{user.avatarText || '我'}}</view>
      </view>

      <view class="mn-hero__main">
        <view class="mn-hero__name-row">
          <text class="mn-hero__name truncate">{{user.nickName}}</text>
          <text wx:if="{{registered}}" class="mn-hero__badge">已认证</text>
        </view>
        <view wx:if="{{user.college}}" class="mn-hero__line truncate">{{user.college}}</view>
        <view wx:if="{{user.motto}}" class="mn-hero__line mn-hero__line--sub truncate">{{user.motto}}</view>
      </view>

      <image class="mn-hero__go" src="/assets/icons/chevron-right--white.svg" mode="aspectFit" />
    </view>

    <view class="mn-hero__edit">编辑个人资料</view>
  </view>

  <!-- 头像 / 昵称没设过时提示一下：同学按昵称找人，光靠默认名等于隐身 -->
  <view
    wx:if="{{profileIncomplete}}"
    class="card mn-tip pressable"
    hover-class="mn-tip--hover"
    hover-stay-time="80"
    bindtap="onEditProfile"
  >
    <image class="mn-tip__icon" src="/assets/icons/sparkles--amber.svg" mode="aspectFit" />
    <view class="mn-tip__text">
      <view class="mn-tip__title">完善一下头像，同学更容易找到你</view>
      <view class="mn-tip__sub">点这里设置头像和昵称，选好的头像会自动保存到云端</view>
    </view>
  </view>

  <!-- ---------------- 三个数字卡 ---------------- -->
  <view class="mn-stats">
    <view class="card mn-stat">
      <view class="mn-stat__num scene-brand">{{myReviews.length}}</view>
      <view class="mn-stat__label">课程评价</view>
    </view>
    <view class="card mn-stat">
      <view class="mn-stat__num scene-forum">{{myPosts.length}}</view>
      <view class="mn-stat__label">我的帖子</view>
    </view>
    <view class="card mn-stat">
      <view class="mn-stat__num scene-market">{{favoriteCount}}</view>
      <view class="mn-stat__label">我的收藏</view>
    </view>
  </view>

  <!-- ---------------- 四个常用入口：按 tone 分色图标方块 ---------------- -->
  <view class="card card--flush mn-rows">
    <view class="row pressable" hover-class="mn-row--hover" hover-stay-time="80" bindtap="onChats">
      <view class="mn-ico mn-ico--brand">
        <image class="mn-ico__img" src="/assets/icons/message-circle--brand.svg" mode="aspectFit" />
      </view>
      <view class="mn-row__main">
        <view class="mn-row__title">我的私信</view>
        <view class="mn-row__desc truncate">
          {{unreadChat > 0 ? unreadChat + ' 条未读' : (friendCount > 0 ? friendCount + ' 位同学' : '查看同学发来的消息')}}
        </view>
      </view>
      <image class="mn-row__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>

    <view class="row pressable" hover-class="mn-row--hover" hover-stay-time="80" bindtap="onFavorites">
      <view class="mn-ico mn-ico--market">
        <image class="mn-ico__img" src="/assets/icons/bookmark--market.svg" mode="aspectFit" />
      </view>
      <view class="mn-row__main">
        <view class="mn-row__title">我的收藏</view>
        <view class="mn-row__desc truncate">
          {{favoriteCount > 0 ? favoriteCount + ' 项收藏' : '还没有收藏任何内容'}}
        </view>
      </view>
      <image class="mn-row__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>

    <view class="row pressable" hover-class="mn-row--hover" hover-stay-time="80" bindtap="goMemo">
      <view class="mn-ico mn-ico--campus">
        <image class="mn-ico__img" src="/assets/icons/notebook-pen--campus.svg" mode="aspectFit" />
      </view>
      <view class="mn-row__main">
        <view class="mn-row__title">我的备忘</view>
        <view class="mn-row__desc truncate">{{memoStreak ? '已连续 ' + memoStreak + ' 天' : '记下今天要做的事'}}</view>
      </view>
      <image class="mn-row__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>

    <view class="row pressable" hover-class="mn-row--hover" hover-stay-time="80" bindtap="onDrafts">
      <view class="mn-ico mn-ico--forum">
        <image class="mn-ico__img" src="/assets/icons/file-text--forum.svg" mode="aspectFit" />
      </view>
      <view class="mn-row__main">
        <view class="mn-row__title">我的草稿</view>
        <view class="mn-row__desc truncate">
          {{draftCount > 0 ? draftCount + ' 篇没写完' : '继续没有写完的内容'}}
        </view>
      </view>
      <image class="mn-row__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- ---------------- 去树洞 ---------------- -->
  <treehole-entry
    title="去树洞放松一下"
    subtitle="匿名心事不会出现在主论坛"
    bind:tap="onHole"
  />

  <!-- ---------------- 两个隐私入口 ---------------- -->
  <view class="card card--flush mn-rows">
    <view class="row pressable" hover-class="mn-row--hover" hover-stay-time="80" bindtap="onOpenPrivacy">
      <view class="mn-ico mn-ico--slate">
        <image class="mn-ico__img" src="/assets/icons/lock--muted.svg" mode="aspectFit" />
      </view>
      <view class="mn-row__main">
        <view class="mn-row__title">隐私保护指引</view>
        <view class="mn-row__desc truncate">了解昵称、头像和联系方式的展示范围</view>
      </view>
      <image class="mn-row__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>

    <view class="row pressable" hover-class="mn-row--hover" hover-stay-time="80" bindtap="onModeration">
      <view class="mn-ico mn-ico--slate">
        <image class="mn-ico__img" src="/assets/icons/shield-check--muted.svg" mode="aspectFit" />
      </view>
      <view class="mn-row__main">
        <view class="mn-row__title">内容审核</view>
        <view class="mn-row__desc truncate">举报队列与人工复核入口</view>
      </view>
      <image class="mn-row__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- ---------------- 我的课程评价 ---------------- -->
  <view class="card">
    <view class="mn-head">
      <text class="title-md">我的课程评价（{{myReviews.length}}）</text>
    </view>
    <view wx:if="{{myReviews.length === 0}}" class="mn-none">还没有评价，去「课程评价」写一条吧</view>
    <view
      wx:for="{{myReviews}}"
      wx:key="id"
      wx:for-item="r"
      class="mn-mini pressable"
      hover-class="mn-mini--hover"
      hover-stay-time="80"
      data-id="{{r.courseId}}"
      bindtap="goCourse"
    >
      <view class="mn-mini__top">
        <view class="mn-mini__left">
          <text class="mn-mini__name truncate">{{r.courseName}}</text>
          <view class="mn-stars">
            <image
              wx:for="{{[1,2,3,4,5]}}"
              wx:for-item="s"
              wx:key="*this"
              class="mn-star"
              src="{{s <= r.starOn ? '/assets/icons/star--amber.svg' : '/assets/icons/star--faint.svg'}}"
              mode="aspectFit"
            ></image>
          </view>
        </view>
        <view
          wx:if="{{r.canDelete}}"
          class="mn-del pressable"
          data-id="{{r.id}}"
          catchtap="onDeleteReview"
        >删除</view>
      </view>
      <view class="mn-mini__content clamp2">{{r.content}}</view>
    </view>
  </view>

  <!-- ---------------- 我的帖子 ---------------- -->
  <view class="card">
    <view class="mn-head">
      <text class="title-md">我的帖子（{{myPosts.length}}）</text>
      <text wx:if="{{myPosts.length}}" class="mn-clear pressable" catchtap="onClearPosts">清空</text>
    </view>
    <view wx:if="{{myPosts.length === 0}}" class="mn-none">还没有发帖，去「论坛」发一条吧</view>
    <view
      wx:for="{{myPosts}}"
      wx:key="id"
      wx:for-item="p"
      class="mn-mini pressable"
      hover-class="mn-mini--hover"
      hover-stay-time="80"
      data-id="{{p.id}}"
      bindtap="goPost"
    >
      <view class="mn-mini__top">
        <text class="mn-mini__name truncate">{{p.title}}</text>
        <text wx:if="{{p.hidden}}" class="mn-board mn-board--hidden">已暂停展示</text>
        <text wx:else class="mn-board">{{p.board}}</text>
        <view
          wx:if="{{p.canDelete}}"
          class="mn-del pressable"
          data-id="{{p.id}}"
          catchtap="onDeletePost"
        >删除</view>
      </view>
      <view wx:if="{{p.hidden}}" class="mn-restore pressable" data-id="{{p.id}}" catchtap="onRestorePost">
        <image class="mn-restore__icon" src="/assets/icons/clock--muted.svg" mode="aspectFit" />
        <text class="mn-restore__text">这条因举报暂停展示了，确认没违规？点这里恢复</text>
      </view>
      <view class="mn-mini__content clamp2">{{p.content}}</view>
    </view>
  </view>

  <!-- ---------------- 应用说明 / 环境自检 / 清除本机缓存 ---------------- -->
  <view class="card card--flush mn-rows">
    <view class="row pressable" hover-class="mn-row--hover" hover-stay-time="80" bindtap="onGuide">
      <view class="mn-ico mn-ico--brand">
        <image class="mn-ico__img" src="/assets/icons/sparkles--brand.svg" mode="aspectFit" />
      </view>
      <view class="mn-row__main">
        <view class="mn-row__title">应用说明</view>
        <view class="mn-row__desc truncate">五个底部标签 + 五个小工具都是干什么的，点开看一遍</view>
      </view>
      <image class="mn-row__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>

    <view
      wx:if="{{isMod}}"
      class="row pressable"
      hover-class="mn-row--hover"
      hover-stay-time="80"
      bindtap="onDiag"
    >
      <view class="mn-ico mn-ico--slate">
        <image class="mn-ico__img" src="/assets/icons/loader--muted.svg" mode="aspectFit" />
      </view>
      <view class="mn-row__main">
        <view class="mn-row__title">环境自检</view>
        <view class="mn-row__desc truncate">检查云函数能不能通、数据库集合齐不齐</view>
      </view>
      <image class="mn-row__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>

    <view class="row pressable" hover-class="mn-row--hover" hover-stay-time="80" bindtap="onClearCache">
      <view class="mn-ico mn-ico--slate">
        <image class="mn-ico__img" src="/assets/icons/trash-2--muted.svg" mode="aspectFit" />
      </view>
      <view class="mn-row__main">
        <view class="mn-row__title">清除本机缓存</view>
        <view class="mn-row__desc truncate">让页面恢复正常速度（云端数据不受影响）</view>
      </view>
      <image class="mn-row__go" src="/assets/icons/chevron-right--faint.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- ---------------- 身份没拿到时的警示条 ---------------- -->
  <view
    wx:if="{{!registered}}"
    class="mn-alert pressable"
    hover-class="mn-alert--hover"
    hover-stay-time="80"
    bindtap="onDiag"
  >
    <view class="mn-alert__title">还没拿到身份，有些功能会跟着出问题</view>
    <!-- 文案刻意不写「发帖会失败」：服务端认人靠的是微信塞给云函数的身份，
         跟客户端拿没拿到 openid 没关系。点这里跑一次「环境自检」看缺什么 -->
    <view class="mn-alert__hint">多半是 login 云函数没部署（表现为：预览正常、体验版同学全废）。点这里跑一次「环境自检」看缺什么</view>
  </view>

  <view class="mn-foot">
    <image class="mn-foot__icon" src="/assets/icons/life-buoy--faint.svg" mode="aspectFit" />
    <text class="faint">商砖小站 · 高保真页面骨架</text>
  </view>
</view>
