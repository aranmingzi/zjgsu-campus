/* pages/mine/drafts/drafts.wxss —— 草稿箱
   复用 app.wxss：.container / .card / .tag / .muted / .faint / .clamp2。 */

.dt-page { padding-top: 8rpx; }
.dt-loading { padding: 60rpx 0; text-align: center; font-size: 26rpx; color: #98a3b8; }

/* ---------- 顶部计数 + 清空 ---------- */
.dt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 8rpx 12rpx;
}
.dt-clear {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  color: #dd4b55;
}
.dt-clear--hover { opacity: 0.6; }
.dt-clear__icon { width: 30rpx; height: 30rpx; }

/* ---------- 草稿卡片 ---------- */
.dt-item { padding-bottom: 24rpx; }
.dt-item--hover { opacity: 0.72; }

.dt-item__top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.dt-tag { background: #eff4ff; color: #2047c9; }
.dt-time { flex-shrink: 0; }

.dt-del {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  margin-left: auto;
  padding: 0 8rpx;
  font-size: 24rpx;
  color: #dd4b55;
}
.dt-del--hover { opacity: 0.6; }
.dt-del__icon { width: 30rpx; height: 30rpx; }

.dt-item__title { font-size: 30rpx; font-weight: 600; color: #172033; line-height: 1.5; }
.dt-item__preview {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6f7b91;
  line-height: 1.6;
}
