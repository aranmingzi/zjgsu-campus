<view class="container">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <view wx:elif="{{items.length === 0}}" class="empty">
    <view class="empty-icon">📝</view>
    <view>没有未写完的内容</view>
    <view class="empty-hint">发帖或写评价时点「存草稿」，写到一半退出来也不会丢</view>
  </view>

  <view wx:else>
    <view class="head">
      <text class="count">共 {{items.length}} 篇</text>
      <text class="clear tap" bindtap="clear">清空</text>
    </view>

    <view
      wx:for="{{items}}"
      wx:key="id"
      class="card d-item tap"
      data-id="{{item.id}}"
      data-type="{{item.type}}"
      bindtap="open"
    >
      <view class="d-top">
        <text class="d-type">{{item.typeName}}</text>
        <text class="muted d-time">{{item.time}}</text>
      </view>
      <view class="d-title">{{item.title}}</view>
      <view class="d-preview">{{item.preview}}</view>
      <view class="d-del tap" catchtap="remove" data-id="{{item.id}}">删除</view>
    </view>
  </view>
</view>
