/* pages/mine/mine.wxss —— 我的
   复用 app.wxss：.container / .card / .card--flush / .row / .truncate / .clamp2 /
   .title-md / .muted / .faint / .pressable。这里只写本页独有的 mn-* 语义类。
   注意：.container 上不能出现 transform（会让页内 fixed 元素退化），本文件没有。 */

/* ---------------- 顶部渐变个人区 ---------------- */
.mn-hero {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-bottom: 24rpx;
  padding: 40rpx 32rpx 28rpx;
  border-radius: 32rpx;
  /* 个人资料青蓝 → 主色，和 Web 版 MineHomeView 的渐变一致 */
  background: linear-gradient(135deg, #2f9fd6 0%, #2b5aed 100%);
  box-shadow: 0 12rpx 32rpx rgba(43, 90, 237, 0.22);
}
.mn-hero--hover { opacity: 0.88; }

.mn-hero__row { display: flex; align-items: center; gap: 24rpx; }

.mn-hero__avatar {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.35);
  overflow: hidden;
}
.mn-hero__avatar-img { width: 132rpx; height: 132rpx; }
.mn-hero__avatar-text {
  width: 132rpx;
  height: 132rpx;
  line-height: 132rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
}

.mn-hero__main { flex: 1; min-width: 0; }
.mn-hero__name-row { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.mn-hero__name {
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}
.mn-hero__badge {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1.5;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}
.mn-hero__line { margin-top: 8rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.78); }
.mn-hero__line--sub { color: rgba(255, 255, 255, 0.62); }

.mn-hero__go { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.mn-hero__edit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  min-height: 72rpx;
  margin-top: 28rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.18);
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.mn-page { padding-top: 8rpx; }

/* ---------------- 头像昵称提示 ---------------- */
.mn-tip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff8e6;
  border: 2rpx solid #f4e3b4;
}
.mn-tip--hover { opacity: 0.78; }
.mn-tip__icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.mn-tip__text { flex: 1; min-width: 0; }
.mn-tip__title { font-size: 28rpx; font-weight: 600; color: #633806; }
.mn-tip__sub { margin-top: 4rpx; font-size: 22rpx; color: #854f0b; line-height: 1.6; }

/* ---------------- 三个数字卡 ---------------- */
.mn-stats { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.mn-stat {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  padding: 24rpx 16rpx;
  text-align: center;
}
.mn-stat__num { font-size: 44rpx; font-weight: 700; line-height: 1.15; }
.mn-stat__label { margin-top: 8rpx; font-size: 22rpx; color: #6f7b91; }

/* ---------------- 入口行 ---------------- */
.mn-rows { margin-bottom: 24rpx; }
.mn-row--hover { background: #f7f9fc; }

.mn-ico {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mn-ico__img { width: 36rpx; height: 36rpx; }
.mn-ico--brand { background: #eff4ff; }
.mn-ico--market { background: #fff3e9; }
.mn-ico--campus { background: #e9f8f1; }
.mn-ico--forum { background: #f1edff; }
.mn-ico--slate { background: #eef1f6; }

.mn-row__main { flex: 1; min-width: 0; }
.mn-row__title { font-size: 28rpx; font-weight: 600; color: #172033; line-height: 1.4; }
.mn-row__desc { margin-top: 4rpx; font-size: 22rpx; color: #6f7b91; line-height: 1.5; }
.mn-row__go { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* ---------------- 我的评价 / 帖子 ---------------- */
.mn-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}
.mn-clear {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #dd4b55;
  background: #fff0f1;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}
.mn-none { padding: 32rpx 0; text-align: center; font-size: 24rpx; color: #98a3b8; }

.mn-mini {
  padding: 24rpx 0;
  border-top: 2rpx solid #eef1f6;
}
.mn-mini:first-of-type { border-top: none; padding-top: 8rpx; }
.mn-mini--hover { opacity: 0.72; }

.mn-mini__top { display: flex; align-items: center; gap: 12rpx; }
.mn-mini__left { flex: 1; min-width: 0; display: flex; align-items: center; gap: 12rpx; }
.mn-mini__name { min-width: 0; font-size: 28rpx; font-weight: 600; color: #172033; }

.mn-stars { flex-shrink: 0; display: flex; align-items: center; gap: 2rpx; }
.mn-star { width: 24rpx; height: 24rpx; }

.mn-board {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #2047c9;
  background: #eff4ff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.mn-board--hidden { color: #d98c0b; background: #fff8e6; }

.mn-del {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 22rpx;
  color: #dd4b55;
  background: #fff0f1;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.mn-mini__content {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6f7b91;
  line-height: 1.6;
}

.mn-restore {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 56rpx;
  margin: 12rpx 0 8rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #d98c0b;
  background: #fff8e6;
  border-radius: 24rpx;
  box-sizing: border-box;
}
.mn-restore__icon { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.mn-restore__text { flex: 1; min-width: 0; }

/* ---------------- 身份警示条 ---------------- */
.mn-alert {
  margin-bottom: 8rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: #fff0f1;
  border: 2rpx solid #f8d5d7;
}
.mn-alert--hover { opacity: 0.78; }
.mn-alert__title { font-size: 28rpx; font-weight: 600; color: #dd4b55; }
.mn-alert__hint { margin-top: 8rpx; font-size: 22rpx; color: #a8606a; line-height: 1.6; }

/* ---------------- 页脚 ---------------- */
.mn-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 12rpx 0 8rpx;
}
.mn-foot__icon { width: 28rpx; height: 28rpx; }
