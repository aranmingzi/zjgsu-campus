<view class="container">
  <!-- 顶部三个数：连续天数是这类工具唯一的「上瘾点」，必须放最大 -->
  <view class="memo-top">
    <view class="stat">
      <view class="stat-num hot">{{streak}}</view>
      <view class="stat-label">连续记天数</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{total}}</view>
      <view class="stat-label">累计记录</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{month}}</view>
      <view class="stat-label">{{monthLabel}}记录</view>
    </view>
  </view>

  <view wx:if="{{hasToday}}" class="memo-tip">今天已经记过了，顺手补一句也好。</view>

  <view wx:else class="memo-tip">今天还没记，花一分钟写下两句，明天就多一分「回头看」的乐趣。</view>

  <view wx:if="{{total === 0}}" class="card memo-intro">
    <view class="intro-icon">📔</view>
    <view class="intro-title">这里只属于你自己</view>
    <view class="intro-sub">
      记下今天的三两句话：吃了什么、想通了什么、明天要做什么。
      别人看不到，你的同学也翻不到，只有你自己能翻。
    </view>
    <view class="intro-btn tap" bindtap="openForm">写下第一条</view>
  </view>

  <view class="memo-search">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="在本机记录里搜关键词"
      placeholder-class="search-ph"
      bindinput="onSearch"
    />
    <text wx:if="{{keyword}}" class="search-clear tap" bindtap="onClearSearch">清空</text>
  </view>

  <block wx:for="{{groups}}" wx:key="date">
    <view class="day-head">
      <text class="day-date">{{item.date}}</text>
      <text class="day-week">{{item.week}}</text>
    </view>

    <view
      wx:for="{{item.items}}"
      wx:for-item="m"
      wx:key="id"
      class="card memo-item tap"
      data-item="{{m}}"
      bindtap="onEdit"
    >
      <view class="memo-mood">{{m.moodIcon}}</view>
      <view class="memo-body">
        <view class="memo-text">{{m.brief}}</view>
        <view class="memo-meta">{{m.moodName}}</view>
      </view>
      <view class="memo-del tap" catchtap="onRemove" data-item="{{m}}">删除</view>
    </view>
  </block>

  <view wx:if="{{groups.length === 0 && keyword}}" class="bottom-note">没搜到包含「{{keyword}}」的记录。</view>
  <view wx:elif="{{groups.length > 0}}" class="bottom-note">点任意一条可以改，改完立刻生效。记录存在云端，换手机还在。</view>

  <view class="fab fab-text tap" bindtap="openForm">＋ 写一条</view>

  <view wx:if="{{showForm}}" class="mask tap" bindtap="closeForm">
    <view class="sheet tap" catchtap="noop">
      <view class="sheet-title">{{editing ? '改一条' : '写一条'}}</view>

      <view class="form-row">
        <text class="form-label">日期</text>
        <picker mode="date" value="{{form.date}}" bindchange="onFormDate">
          <view class="form-picker">{{form.date}}</view>
        </picker>
      </view>

      <view class="form-label">今天的心情</view>
      <view class="mood-row">
        <view
          wx:for="{{moods}}"
          wx:key="key"
          class="mood {{moodMap[item.key] ? 'on' : ''}} tap"
          data-k="{{item.key}}"
          bindtap="onFormMood"
        >
          <text class="mood-icon">{{item.icon}}</text>
          <text class="mood-name">{{item.name}}</text>
        </view>
      </view>

      <view class="form-label">想说点什么</view>
      <textarea
        class="memo-input"
        placeholder="今天发生了什么？"
        placeholder-class="memo-ph"
        auto-height
        maxlength="2000"
        show-confirm-bar="{{false}}"
        value="{{form.text}}"
        bindinput="onFormText"
      ></textarea>

      <view class="sheet-ops">
        <view class="sheet-btn tap" bindtap="closeForm">取消</view>
        <view class="sheet-btn primary tap" bindtap="onSave">{{editing ? '保存修改' : '记下来'}}</view>
      </view>
    </view>
  </view>
</view>
