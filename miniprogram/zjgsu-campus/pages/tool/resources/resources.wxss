.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 22rpx;
  margin-bottom: 16rpx;
}
.search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.cat-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.cat-chip {
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  color: #5f6368;
  background: #fff;
  border: 1rpx solid #e3e6ea;
  border-radius: 28rpx;
}
.cat-chip.on {
  color: #fff;
  background: #1a5fb4;
  border-color: #1a5fb4;
}
.share-entry {
  display: flex;
  align-items: center;
}
.share-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}
.share-main {
  flex: 1;
}
.share-title {
  font-size: 28rpx;
}
.share-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.form-card {
  padding: 24rpx 28rpx;
}
.file-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}
.file-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.file-name {
  font-size: 26rpx;
  color: #1f2329;
}
.file-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.field {
  width: 100%;
  box-sizing: border-box;
  /* 定高修复：input 只给 padding 不给高度会截字 */
  height: 88rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  margin-top: 16rpx;
}
.type-row {
  display: flex;
  margin: 20rpx 0;
}
.type {
  padding: 10rpx 22rpx;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: #5f6368;
  background: #f7f8fa;
  border-radius: 28rpx;
}
.type.on {
  color: #fff;
  background: #1a5fb4;
}
.res-item {
  margin-bottom: 20rpx;
}
.res-head {
  display: flex;
  align-items: flex-start;
}
.res-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}
.res-main {
  flex: 1;
}
.res-title {
  font-size: 28rpx;
  color: #1f2329;
}
.res-meta {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.res-desc {
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.6;
}
.res-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f1f3;
}
.res-by {
  font-size: 22rpx;
}
.res-ops {
  display: flex;
}
.res-op {
  padding: 8rpx 20rpx;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #5f6368;
  background: #f7f8fa;
  border-radius: 24rpx;
}
.res-op.on {
  color: #e64340;
  background: #fdecec;
}
.res-op.primary {
  color: #fff;
  background: #1a5fb4;
}
.res-op.del {
  color: #d9534f;
}
