/* pages/tool/resources/resources.wxss —— 学习资料
   复用 app.wxss：.container / .card / .card--flat / .muted / .faint / .clamp2 /
   .search-bar / .chip / .chip-on / .chip-row / .truncate。本页独有全部是 rs-*。 */

.rs-page { padding-top: 8rpx; }
.rs-loading { padding: 60rpx 0; text-align: center; font-size: 26rpx; color: #98a3b8; }

/* ---------------- 搜索 ---------------- */
.rs-search { margin-bottom: 20rpx; }
.rs-search__icon { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.rs-search__input { height: 88rpx; }
.rs-search__ph { color: #98a3b8; }

.rs-cats { margin: 4rpx 0 20rpx; }

/* ---------------- 分享入口 ---------------- */
.rs-share { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.rs-share--hover { opacity: 0.78; }
.rs-share__ico {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #eff4ff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rs-share__ico-img { width: 40rpx; height: 40rpx; }
.rs-share__main { flex: 1; min-width: 0; }
.rs-share__title { font-size: 28rpx; font-weight: 600; color: #172033; }
.rs-share__sub { margin-top: 4rpx; font-size: 22rpx; line-height: 1.5; }
.rs-share__go { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* ---------------- 上传表单 ---------------- */
.rs-form { padding-bottom: 28rpx; }

.rs-file {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 120rpx;
  margin-top: 8rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f6f8fb;
}
.rs-file--hover { opacity: 0.72; }
.rs-file__ico {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rs-file__ico-img { width: 36rpx; height: 36rpx; }
.rs-file__main { flex: 1; min-width: 0; }
.rs-file__name { font-size: 26rpx; color: #172033; }
.rs-file__sub { margin-top: 4rpx; font-size: 22rpx; }
.rs-file__go { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* input 必须定高，否则默认行高会把字拦腰截断 */
.rs-field {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #172033;
  background: #f6f8fb;
  border-radius: 24rpx;
}
.rs-types { margin: 8rpx 0 0; }
.rs-submit { margin-top: 24rpx; }

/* ---------------- 资料卡片 ---------------- */
.rs-item { margin-bottom: 20rpx; }

.rs-head { display: flex; align-items: flex-start; gap: 20rpx; }
.rs-head__ico {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #eff4ff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rs-head__ico-img { width: 40rpx; height: 40rpx; }
.rs-main { flex: 1; min-width: 0; }
.rs-title { font-size: 30rpx; font-weight: 600; color: #172033; line-height: 1.45; }
.rs-meta { margin-top: 6rpx; font-size: 24rpx; }
.rs-desc { margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; }

.rs-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #eef1f6;
}
.rs-by { flex-shrink: 1; min-width: 0; font-size: 22rpx; }
.rs-ops { flex-shrink: 0; display: flex; gap: 8rpx; }

.rs-op {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6f7b91;
  background: #f6f8fb;
}
.rs-op--hover { opacity: 0.7; }
.rs-op__icon { width: 30rpx; height: 30rpx; }
.rs-op--on { color: #128a56; background: #e9f8f1; }
.rs-op--primary { color: #ffffff; background: #2b5aed; }
.rs-op--danger { color: #dd4b55; background: #fff0f1; }
