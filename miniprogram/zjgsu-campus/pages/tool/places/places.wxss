.cat-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}
.cat-chip {
  padding: 10rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  color: #5f6368;
  background: #fff;
  border: 1rpx solid #e3e6ea;
  border-radius: 28rpx;
}
.cat-chip.on {
  color: #fff;
  background: #1a5fb4;
  border-color: #1a5fb4;
}
.add-entry {
  display: flex;
  align-items: center;
}
.add-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}
.add-main {
  flex: 1;
}
.add-title {
  font-size: 28rpx;
}
.add-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.form-card {
  padding: 24rpx 28rpx;
}
.loc-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}
.loc-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.loc-name {
  font-size: 26rpx;
  color: #1f2329;
}
.loc-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.field {
  width: 100%;
  box-sizing: border-box;
  /* 定高修复：只留水平内边距，否则 input 默认高度会把字切一半 */
  height: 88rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  margin-top: 16rpx;
}
.type-row {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0;
}
.type {
  padding: 10rpx 22rpx;
  margin: 0 14rpx 14rpx 0;
  font-size: 24rpx;
  color: #5f6368;
  background: #f7f8fa;
  border-radius: 28rpx;
}
.type.on {
  color: #fff;
  background: #1a5fb4;
}
.pl-item {
  margin-bottom: 20rpx;
}
.pl-head {
  display: flex;
  align-items: flex-start;
}
.pl-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}
.pl-main {
  flex: 1;
}
.pl-name {
  font-size: 28rpx;
  color: #1f2329;
}
.pl-desc {
  font-size: 24rpx;
  margin-top: 6rpx;
  line-height: 1.6;
}
.pl-addr {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.pl-ops {
  display: flex;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f1f3;
}
.pl-op {
  padding: 8rpx 22rpx;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: #5f6368;
  background: #f7f8fa;
  border-radius: 24rpx;
}
.pl-op.primary {
  color: #fff;
  background: #1a5fb4;
}
.pl-op.del {
  color: #d9534f;
}
