/* pages/tool/places/places.wxss —— 校园地点 / 地图
   复用 app.wxss：.container / .card / .tag / .muted / .faint / .truncate /
   .chip / .chip-on / .chip-row / .title-md。本页独有全部是 pl-*。
   地图、bottom-sheet 都用 position: fixed / 原生 map，.container 上没有 transform。 */

.pl-page { padding-top: 8rpx; }
.pl-loading { padding: 60rpx 0; text-align: center; font-size: 26rpx; color: #98a3b8; }

/* ---------------- 顶部地图 ---------------- */
.pl-map-wrap {
  position: relative;
  width: 100%;
  height: 460rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #e7f5fd;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.pl-map { width: 100%; height: 460rpx; }

.pl-map--empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #eef1f6;
}
.pl-map__icon { width: 88rpx; height: 88rpx; }
.pl-map__hint { font-size: 24rpx; color: #98a3b8; }

.pl-map__foot {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  color: #6f7b91;
}
.pl-map__foot-icon { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.pl-map__foot text { flex: 1; min-width: 0; }

/* ---------------- 分类 ---------------- */
.pl-cats { margin-bottom: 4rpx; }

/* ---------------- 补充地点入口 ---------------- */
.pl-add { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.pl-add--hover { opacity: 0.78; }
.pl-add__ico {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #e9f8f1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pl-add__ico-img { width: 40rpx; height: 40rpx; }
.pl-add__main { flex: 1; min-width: 0; }
.pl-add__title { font-size: 28rpx; font-weight: 600; color: #172033; }
.pl-add__sub { margin-top: 4rpx; font-size: 22rpx; line-height: 1.5; }
.pl-add__go { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* ---------------- 添加表单 ---------------- */
.pl-form { padding-bottom: 28rpx; }
.pl-loc {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 120rpx;
  margin-top: 8rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f6f8fb;
}
.pl-loc--hover { opacity: 0.72; }
.pl-loc__ico {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pl-loc__ico-img { width: 36rpx; height: 36rpx; }
.pl-loc__main { flex: 1; min-width: 0; }
.pl-loc__name { font-size: 26rpx; color: #172033; }
.pl-loc__sub { margin-top: 4rpx; font-size: 22rpx; }
.pl-loc__go { width: 28rpx; height: 28rpx; flex-shrink: 0; }

/* input 必须定高，否则默认行高会把字拦腰截断 */
.pl-field {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #172033;
  background: #f6f8fb;
  border-radius: 24rpx;
}
.pl-types { margin: 8rpx 0 0; }
.pl-submit { margin-top: 24rpx; }

/* ---------------- 地点列表 ---------------- */
.pl-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 8rpx 12rpx;
}
.pl-head__main { min-width: 0; }
.pl-head__sub { margin-top: 4rpx; font-size: 22rpx; }
.pl-head__count { flex-shrink: 0; }

.pl-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.pl-item--hover { opacity: 0.72; }

.pl-item__ico {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #e9f8f1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pl-item__ico-img { width: 40rpx; height: 40rpx; }

.pl-item__main { flex: 1; min-width: 0; }
.pl-item__name-row { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.pl-item__name { min-width: 0; font-size: 30rpx; font-weight: 600; color: #172033; }
.pl-item__tag { flex-shrink: 0; font-size: 20rpx; }
.pl-item__desc { margin-top: 6rpx; font-size: 24rpx; line-height: 1.5; }
.pl-item__addr { margin-top: 4rpx; font-size: 22rpx; }

.pl-item__nav {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-height: 88rpx;
  padding-left: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2b5aed;
}
.pl-item__nav-icon { width: 28rpx; height: 28rpx; }

.pl-del {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 88rpx;
  padding-left: 8rpx;
  font-size: 24rpx;
  color: #dd4b55;
}
.pl-del--hover { opacity: 0.6; }
.pl-del__icon { width: 28rpx; height: 28rpx; }

/* ---------------- 到达方式抽屉内容 ---------------- */
.pl-sheet__opts { display: flex; flex-direction: column; gap: 16rpx; }

.pl-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f6f8fb;
}
.pl-opt--hover { opacity: 0.72; }
.pl-opt__ico {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pl-opt__ico--brand { background: #eff4ff; }
.pl-opt__ico--campus { background: #e9f8f1; }
.pl-opt__ico-img { width: 40rpx; height: 40rpx; }

.pl-opt__main { flex: 1; min-width: 0; }
.pl-opt__title { font-size: 28rpx; font-weight: 600; color: #172033; }
.pl-opt__desc { margin-top: 4rpx; font-size: 22rpx; }
.pl-opt__go { width: 28rpx; height: 28rpx; flex-shrink: 0; }
