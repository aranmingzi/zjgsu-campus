/* pages/user/profile —— 我的资料。类名统一 pf-*，
   .card / .title-sm / .muted / .tap 这些语义类来自 app.wxss，这里不重复定义。 */

/* ---------- 顶部渐变：个人资料青蓝 #2F9FD6 → 主色 #2B5AED ---------- */
.pf-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 44rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(160deg, #2f9fd6 0%, #2b5aed 100%);
  box-shadow: 0 12rpx 32rpx rgba(47, 159, 214, 0.24);
}

.pf-avatar {
  margin-bottom: 24rpx;
}

.pf-nick {
  width: 100%;
  max-width: 480rpx;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}
/* placeholder 伪类在 input 上要单独给，沿用上一版的白色半透明 */
.pf-nick-ph { color: rgba(255, 255, 255, 0.7); }

.pf-hero-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ---------- 分区标题 ---------- */
.pf-sec {
  font-size: 30rpx;
  font-weight: 600;
  color: #172033;
  margin-bottom: 8rpx;
}

.pf-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 0 4rpx;
}
.pf-row + .pf-field { margin-top: 8rpx; }

.pf-row-label {
  font-size: 28rpx;
  color: #6f7b91;
  width: 180rpx;
  flex-shrink: 0;
}
.pf-row-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #2047c9;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pf-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ---------- 输入块 / 圆角输入 ---------- */
.pf-field { margin-top: 8rpx; }
.pf-field-label {
  display: block;
  font-size: 24rpx;
  color: #6f7b91;
  margin-bottom: 8rpx;
}

.pf-input {
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  /* input 不给固定高度会被默认行高拦腰截字，必须定高 + 只留水平内边距 */
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #f6f8fb;
  color: #172033;
}
.pf-input--mt { margin-top: 24rpx; }

/* ---------- 身份 ID ---------- */
.pf-id {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #eff4ff;
}
.pf-id-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.pf-id-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #2047c9;
  line-height: 1.6;
  word-break: break-all;
}

/* ---------- 隐私档位 ---------- */
.pf-current {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
}
.pf-current-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}
.pf-current-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.pf-current-text .muted { margin-top: 4rpx; }

.pf-privacy { margin-top: 20rpx; }

.pf-none { margin-top: 20rpx; }

.pf-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f6f8fb;
  font-size: 22rpx;
  color: #6f7b91;
  line-height: 1.7;
}
.pf-tip-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

/* ---------- 底部操作 ---------- */
.pf-actions {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pf-cancel {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6f7b91;
}
.pf-cancel--hover { opacity: 0.72; }
.pf-reset {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #98a3b8;
}
