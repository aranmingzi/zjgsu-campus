.grow { flex: 1; min-width: 0; }

.row { display: flex; align-items: center; gap: 24rpx; }

.avatar-btn {
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
}
.avatar-btn::after { border: none; }

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a5fb4, #4a86d6);
  color: #fff;
  font-size: 44rpx;
  line-height: 120rpx;
  text-align: center;
}

/* 定高修复：nickname input 不给固定高度会被默认 1.4rem 拦腰截字 */
.nick { font-size: 32rpx; height: 88rpx; padding: 0 4rpx; }

.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }

.picker-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}
.picker-label { font-size: 28rpx; width: 180rpx; color: #4a5057; }
.picker-value { flex: 1; color: #1a5fb4; font-size: 28rpx; }
.arrow { color: #b0b6be; font-size: 32rpx; }

.motto {
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  /* input 不给固定高度会被默认 1.4rem 拦腰截字，必须定高 + 只留水平内边距 */
  height: 88rpx;
  padding: 0 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

.openid-tip {
  display: block; /* text 默认行内，margin-top 不生效，撑成块级 */
  margin-top: 16rpx;
  font-size: 22rpx;
}

.tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a9099;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

.reset {
  text-align: center;
  color: #8a9099;
  font-size: 26rpx;
  padding: 24rpx;
}
