<view class="container">
  <view class="card">
    <view class="section-title">头像与昵称</view>
    <view class="row">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar">{{avatarText}}</view>
      </button>
      <view class="grow">
        <!-- type="nickname" 让微信在键盘上方直接给一个「使用微信昵称」，
             一键拉取平台昵称，不用用户自己想名字 -->
        <input
          class="nick"
          type="nickname"
          placeholder="取个昵称，也可直接用微信昵称"
          value="{{nickName}}"
          bindinput="onNick"
          maxlength="20"
        />
        <view class="muted">全校同学按昵称找人，别写班级名这类隐私信息</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">我的身份</view>
    <picker mode="selector" range="{{colleges}}" value="{{collegeIdx}}" bindchange="onCollege">
      <view class="picker-row">
        <text class="picker-label">所在学院</text>
        <text class="picker-value">{{colleges[collegeIdx] || '未填写'}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
    <input class="motto" placeholder="一句话介绍自己（可不填）" value="{{motto}}" bindinput="onMotto" maxlength="40" />
    <!-- user-select 让这行字长按也能选中复制（微信 text 组件的能力）；
         点一下走 onCopyOpenid 弹窗复制，两条路都通 -->
    <text class="muted openid-tip tap" user-select="{{true}}" bindtap="onCopyOpenid">{{openidTip}}</text>
  </view>

  <view class="card">
    <view class="section-title">我的联系方式</view>
    <!-- range 是对象数组时必须写 range-key，否则选项会显示成 [object Object] -->
    <picker mode="selector" range="{{contactTypes}}" range-key="label" value="{{contactTypeIdx}}" bindchange="onContactType">
      <view class="picker-row">
        <text class="picker-label">公开方式</text>
        <text class="picker-value">{{contactTypes[contactTypeIdx].label}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
    <input wx:if="{{contactTypes[contactTypeIdx].key}}" class="motto" placeholder="{{contactPlaceholder}}"
           value="{{contactValue}}" bindinput="onContactValue" maxlength="40" />
    <view wx:else class="muted">当前设置：谁都看不到你的联系方式</view>
    <view class=" tip">联系方式只在对方「同意添加你」之后才会对他显示，别人翻不到你的主页也看不到。</view>
  </view>

  <view class="btn-primary tap" bindtap="onSave">保存资料</view>
  <view class="reset tap" bindtap="onReset">恢复默认</view>
</view>
