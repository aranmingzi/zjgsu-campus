/* pages/user/card —— 同学名片。类名统一 cd-*，
   .card / .title-lg / .muted / .bg-profile-soft 等语义类来自 app.wxss。 */

/* ---------- 名片头 ---------- */
.cd-hero {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 40rpx 28rpx;
}

.cd-avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 999rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #2f9fd6, #2b5aed);
  box-shadow: 0 8rpx 24rpx rgba(47, 159, 214, 0.28);
}
.cd-avatar-img {
  width: 100%;
  height: 100%;
}
.cd-avatar-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 700;
}

.cd-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.cd-tag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 8rpx;
  max-width: 100%;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #e7f5fd;
  color: #2f9fd6;
  font-size: 22rpx;
  line-height: 1.5;
}
.cd-tag-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.cd-motto {
  font-size: 24rpx;
  color: #6f7b91;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ---------- 分区标题（图标 + 文字） ---------- */
.cd-sec {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #172033;
  margin-bottom: 16rpx;
}
.cd-sec-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.cd-btn { margin-top: 24rpx; }
.cd-btn-icon {
  width: 32rpx;
  height: 32rpx;
}

.cd-tip {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #6f7b91;
  line-height: 1.7;
}

/* ---------- 联系方式 ---------- */
.cd-contact { border-left: 8rpx solid #2f9fd6; }

.cd-contact-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
}
.cd-contact-label {
  font-size: 24rpx;
  color: #2f9fd6;
  flex-shrink: 0;
}
.cd-contact-value {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #172033;
}

/* ---------- 已发起等待 ---------- */
.cd-waiting {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #fff3e9;
  color: #d9731f;
  font-size: 26rpx;
  line-height: 1.6;
}
.cd-waiting-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

/* ---------- 留言输入框 ---------- */
.cd-msg-box { margin: 20rpx 0 8rpx; }
.cd-msg-input {
  width: 100%;
  box-sizing: border-box;
  background: #f6f8fb;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  min-height: 140rpx;
}
