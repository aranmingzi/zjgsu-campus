<view class="container" wx:if="{{profile}}">
  <view class="card profile">
    <view wx:if="{{!profile.avatarUrl}}" class="avatar">{{profile.avatarText}}</view>
    <image wx:if="{{profile.avatarUrl}}" class="avatar-img" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
    <view class="profile-info">
      <view class="title-lg">{{profile.nickName}}</view>
      <view wx:if="{{profile.college}}" class="muted">{{profile.college}}</view>
      <view wx:elif="{{profile.motto}}" class="muted">{{profile.motto}}</view>
      <view wx:else class="muted">还没填写学院</view>
    </view>
  </view>

  <view wx:if="{{blockedMe && !isMe}}" class="card">
    <view class="section-title">你已拉黑 TA</view>
    <view class="muted">TA 发不出请求给你，也不会出现在你的提醒里。</view>
    <view class="btn-ghost tap" bindtap="onToggleBlock">解除拉黑</view>
  </view>

  <view wx:if="{{isMe}}" class="card">
    <view class="section-title">这是你自己的名片</view>
    <view class="muted">同学只能看到你愿意展示的部分。</view>
    <view class="btn-primary tap" bindtap="onEditMine">编辑我的资料</view>
  </view>

  <!-- 好友：可以看到联系方式 -->
  <view wx:if="{{isFriend && profile.contactValue}}" class="card contact-card">
    <view class="section-title">我们的联系方式</view>
    <view class="contact-row">
      <text class="contact-label">{{contactLabel}}</text>
      <text class="contact-value">{{profile.contactValue}}</text>
    </view>
    <button class="btn-ghost copy-btn tap" bindtap="onCopy" data-v="{{profile.contactValue}}">复制</button>
    <view class="tip">只有同意之后才看得到，不同意就一直看不到。</view>
  </view>

  <view wx:if="{{isFriend && !profile.contactValue}}" class="card">
    <view class="section-title">你们已经是同学关系</view>
    <view class="muted">对方还没填联系方式，等他补充后这里就会显示。</view>
  </view>

  <!-- 陌生人：想认识 -->
  <view wx:if="{{!isMe && !isFriend}}" class="card">
    <view class="section-title">{{waiting ? '已发起，等对方通过' : '想认识TA'}}</view>
    <view wx:if="{{waiting}}" class="waiting">对方通过以后，你就能看到对方的{{profile.contactType ? contactLabel : '联系方式'}}。</view>
    <block wx:else>
      <view class="tip">发起后对方会收到提醒，对方同意你们才能互相看到联系方式。</view>
      <view wx:if="{{showMsg}}" class="msg-box">
        <textarea class="msg-input" placeholder="说一句（可不填）" value="{{msg}}" bindinput="onMsg" maxlength="50" auto-height />
      </view>
      <view class="btn-primary tap" bindtap="onRequest">想认识</view>
      <view wx:if="{{showMsg}}" class="btn-ghost tap" bindtap="toggleMsg">收起留言</view>
      <view wx:else class="btn-ghost tap" bindtap="toggleMsg">附一句留言</view>
    </block>
    <view class="btn-ghost danger-ghost tap" bindtap="onToggleBlock">拉黑 TA</view>
  </view>
</view>
