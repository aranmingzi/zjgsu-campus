/* pages/user/chats —— 私信列表。类名统一 cs-*，
   .card / .card--flush / .skeleton / .truncate 这些来自 app.wxss。 */

/* ---------- 骨架屏（容器用 .skeleton 语义类，这里只管尺寸） ---------- */
.cs-sk { margin-bottom: 24rpx; }
.cs-sk-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
}
.cs-sk-row:last-child { margin-bottom: 0; }
.cs-sk-avatar { width: 96rpx; height: 96rpx; border-radius: 999rpx; }
.cs-sk-body { flex: 1; min-width: 0; }
.cs-sk-line { height: 24rpx; border-radius: 12rpx; margin-bottom: 16rpx; }
.cs-sk-line--short { width: 40%; }
.cs-sk-line--mid { width: 85%; margin-bottom: 0; }

/* ---------- 会话列表 ---------- */
.cs-list { padding: 0; }

.cs-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  min-height: 148rpx;
}
.cs-item + .cs-item { border-top: 2rpx solid #e8edf5; }

.cs-avatar-wrap { position: relative; flex-shrink: 0; }
.cs-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #e7f5fd;
}
.cs-avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2f9fd6;
  font-size: 36rpx;
  font-weight: 600;
}
.cs-dot {
  position: absolute;
  right: 0;
  top: 0;
  min-width: 24rpx;
  height: 24rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #dd4b55;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 24rpx;
  text-align: center;
}

.cs-main {
  flex: 1;
  min-width: 0;
}
.cs-top {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.cs-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #172033;
}
.cs-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #98a3b8;
}
.cs-last {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #6f7b91;
}
