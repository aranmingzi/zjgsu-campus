/* pages/user/friends —— 我的同学。类名统一 fr-*，
   .card / .segmented / .chip / .search-bar / .muted 等语义类来自 app.wxss，这里不重复。 */

.fr-tabs { margin-bottom: 24rpx; }

/* ---------- 同学行 ---------- */
.fr-person {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 8rpx 0;
}

.fr-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #2f9fd6, #2b5aed);
  box-shadow: 0 8rpx 24rpx rgba(47, 159, 214, 0.18);
}
.fr-avatar--blocked { background: #eef1f6; color: #98a3b8; box-shadow: none; }

.fr-info {
  flex: 1;
  min-width: 0;
}

.fr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #172033;
}
.fr-college {
  font-size: 24rpx;
  color: #6f7b91;
  font-weight: 400;
  margin-left: 8rpx;
}
.fr-contact {
  font-size: 24rpx;
  color: #2f9fd6;
  margin-top: 6rpx;
}

.fr-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* ---------- 请求 / 黑名单里的操作按钮 ---------- */
.fr-req { padding-bottom: 8rpx; }

.fr-ops {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 20rpx;
}
.fr-op { flex: 1; min-width: 0; }

/* ---------- 搜索 ---------- */
.fr-search { margin-bottom: 16rpx; }
.fr-search-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.fr-search-input { flex: 1; min-width: 0; font-size: 28rpx; }
.fr-do {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 88rpx;
  padding-left: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2f9fd6;
}

.fr-modes { margin-bottom: 8rpx; }

/* ---------- 提示 ---------- */
.fr-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 4rpx 0 24rpx;
  font-size: 22rpx;
  color: #6f7b91;
  line-height: 1.7;
}
.fr-tip--top { margin: 0 0 16rpx; }
.fr-tip-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

/* ---------- 底部入口 ---------- */
.fr-more { margin-top: 8rpx; }
