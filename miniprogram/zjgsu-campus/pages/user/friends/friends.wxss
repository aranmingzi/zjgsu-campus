.tabs {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #8a9099;
  padding: 16rpx 0;
  border-radius: 16rpx;
}
.tab.on {
  background: #1a5fb4;
  color: #fff;
  font-weight: 600;
}

.person {
  display: flex;
  align-items: center;
  position: relative;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a5fb4, #4a86d6);
  color: #fff;
  font-size: 36rpx;
  line-height: 96rpx;
  text-align: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.p-info { flex: 1; min-width: 0; }
.p-name { font-size: 30rpx; font-weight: 600; }
.p-college { font-size: 24rpx; color: #8a9099; font-weight: 400; margin-left: 8rpx; }
.p-contact { font-size: 24rpx; color: #1a5fb4; margin-top: 6rpx; }
.arrow { color: #c7ccd3; font-size: 34rpx; margin-left: 12rpx; }

.req-actions {
  display: flex;
  margin-top: 20rpx;
  width: 100%;
}
.mini-yes { flex: 1; margin-right: 16rpx; }
.mini-no { flex: 0 0 200rpx; }

.tip {
  margin: 8rpx 0 24rpx;
  font-size: 22rpx;
  color: #8a9099;
  line-height: 1.6;
}

.empty-sm { font-size: 24rpx; color: #b0b6be; margin-top: 12rpx; }

.do-search {
  color: #1a5fb4;
  font-size: 26rpx;
  padding-left: 20rpx;
  flex-shrink: 0;
}

/* 精准 / 模糊 切换：和课程页、论坛、闲置一个样子，同学在哪儿看到的一样 */
.mode-row {
  display: flex;
  align-items: center;
  margin: 0 0 16rpx;
}
.mode-chip {
  font-size: 24rpx;
  color: #6b7280;
  background: #fff;
  border: 1rpx solid #e6e9ee;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin-right: 14rpx;
}
.mode-chip.on {
  color: #fff;
  background: #1a5fb4;
  border-color: #1a5fb4;
  font-weight: 600;
}
