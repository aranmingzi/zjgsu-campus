.hero {
  padding: 32rpx 8rpx 8rpx;
}
.hero-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #1a5fb4;
}
.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
}
.hero-date {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b0b6be;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.block {
  padding-bottom: 24rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #f0f1f3;
}
.block:last-child {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: none;
}

.tab-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}
.tab-icon { font-size: 32rpx; margin-right: 12rpx; }
.tab-name { font-size: 30rpx; font-weight: 600; }
.tab-sub { font-size: 24rpx; color: #8a9099; margin-left: 14rpx; }

.sec-line {
  font-size: 26rpx;
  color: #4a5057;
  line-height: 1.75;
}
.sec-note {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  background: #fff8e8;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #8a6d1a;
  line-height: 1.7;
}

.tool-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}
.tool-row:last-child { border-bottom: none; padding-bottom: 0; }
.tool-icon { font-size: 34rpx; width: 52rpx; flex: none; }
.tool-body { flex: 1; min-width: 0; }
.tool-name { font-size: 28rpx; font-weight: 600; }
/* 入口所在页面：四个工具散在不同页，不写清楚等于让人自己找 */
.tool-from {
  margin-left: 12rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #1a5fb4;
}
.tool-desc { font-size: 24rpx; color: #6b7280; margin-top: 4rpx; line-height: 1.7; }

.warn-card { background: #fffaf0; }
.warn-line { color: #8a6d1a; }
