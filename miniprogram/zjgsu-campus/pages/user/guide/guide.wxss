/* pages/user/guide —— 应用说明。类名统一 gd-*，
   .card / .title-lg / .muted / .bg-brand-50 / .bg-profile-soft 来自 app.wxss。 */

/* ---------- 顶部渐变：个人资料青蓝 #2F9FD6 → 主色 #2B5AED ---------- */
.gd-hero {
  padding: 28rpx 40rpx 44rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(160deg, #2f9fd6 0%, #2b5aed 100%);
  box-shadow: 0 12rpx 32rpx rgba(47, 159, 214, 0.22);
}
.gd-hero-title {
  color: #ffffff;
}
.gd-hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.7;
}
.gd-hero-date {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.66);
}

.gd-sec {
  font-size: 30rpx;
  font-weight: 600;
  color: #172033;
  margin-bottom: 18rpx;
}

/* ---------- 五个底部标签 ---------- */
.gd-block {
  padding-bottom: 28rpx;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid #e8edf5;
}
.gd-block:last-child {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: none;
}

.gd-tab-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.gd-tab-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gd-tab-icon-img { width: 44rpx; height: 44rpx; }

.gd-tab-text {
  flex: 1;
  min-width: 0;
}
.gd-tab-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #172033;
}

/* ---------- 说明行 ---------- */
.gd-line {
  position: relative;
  padding-left: 24rpx;
  font-size: 26rpx;
  color: #4a5057;
  line-height: 1.75;
}
/* 小圆点当项目符号，比手打「·」稳，换行也不会错位 */
.gd-line::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 20rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #c3d3ea;
}

.gd-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #fff3e9;
  font-size: 24rpx;
  color: #d9731f;
  line-height: 1.7;
}
.gd-note-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

/* ---------- 五个小工具 ---------- */
.gd-tool {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #e8edf5;
}
.gd-tool:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.gd-tool-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gd-tool-icon-img { width: 40rpx; height: 40rpx; }

.gd-tool-body {
  flex: 1;
  min-width: 0;
}
.gd-tool-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #172033;
}
/* 入口所在页面：四个工具散在不同页，不写清楚等于让人自己找 */
.gd-tool-from {
  margin-left: 12rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #2f9fd6;
}
.gd-tool-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6f7b91;
  line-height: 1.7;
}

/* ---------- 提醒卡 ---------- */
.gd-warn { background: #fffaf0; }
.gd-line--warn { color: #8a6d1a; }
.gd-line--warn::before { background: #e8b869; }
