<view class="page">
  <scroll-view class="body" scroll-y="true" scroll-into-view="{{scrollTo}}" scroll-with-animation="true">
    <view wx:if="{{loading}}" class="sk-tip">加载中…</view>

    <view wx:elif="{{messages.length === 0}}" class="notice">
      还没有对话，发第一句话认识一下吧
    </view>

    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="row {{item.mine ? 'row-mine' : ''}}"
    >
      <view id="msg-{{item.id}}" class="msg">
        <view class="bubble {{item.mine ? 'b-mine' : ''}} {{item.failed ? 'b-failed' : ''}}">{{item.text}}</view>
        <view class="clock">
          {{item.clock}}<text wx:if="{{item.pending && !item.failed}}"> · 发送中</text><text wx:elif="{{item.failed}}"> · 未送达</text>
        </view>
      </view>
    </view>
    <view class="bottom-space"></view>
  </scroll-view>

  <view wx:if="{{contact}}" class="contact-bar tap" bindtap="copyContact">
    {{contactLabel}}：{{contact}}　<text class="contact-copy">点击复制</text>
  </view>

  <view class="input-bar">
    <input
      class="input"
      placeholder="说点什么…"
      value="{{input}}"
      maxlength="300"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onConfirm"
      adjust-position="true"
    />
    <view class="send tap" bindtap="onSendTap">发送</view>
  </view>
</view>
