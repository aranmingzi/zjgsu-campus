.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f4f5f7;
}

.body {
  flex: 1;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.notice {
  text-align: center;
  color: #b0b6be;
  font-size: 24rpx;
  padding: 60rpx 0;
}

.bottom-space { height: 30rpx; }

.row {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 28rpx;
}
.row-mine { justify-content: flex-end; }

.msg { max-width: 76%; }

.bubble {
  background: #fff;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.6;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  border-top-left-radius: 6rpx;
  word-break: break-word;
}
.b-mine {
  background: #1a5fb4;
  color: #fff;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 6rpx;
}
.b-failed { background: #f3c9c9; color: #a32d2d; }

.clock {
  font-size: 20rpx;
  color: #b0b6be;
  margin-top: 8rpx;
  text-align: left;
}
.row-mine .clock { text-align: right; }

.sk-tip { text-align: center; color: #b0b6be; font-size: 24rpx; padding: 60rpx 0; }

.contact-bar {
  margin: 0 24rpx 12rpx;
  background: #eef3fb;
  color: #185fa5;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 16rpx 22rpx;
}
.contact-copy { color: #1a5fb4; margin-left: 6rpx; }

.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f1f3;
}
.input {
  flex: 1;
  background: #f4f5f7;
  border-radius: 999rpx;
  /* 定高修复：聊天输入框单行显示，字不再被默认高度切一半 */
  height: 76rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  max-height: 180rpx;
}
.send {
  background: #1a5fb4;
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 16rpx 34rpx;
  flex-shrink: 0;
}
