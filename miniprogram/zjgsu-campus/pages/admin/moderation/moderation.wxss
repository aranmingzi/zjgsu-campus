/* pages/admin/moderation/moderation.wxss —— 内容审核
   规格来源：docs/native-ui-contract.md + src/views/mine/MineHomeView.vue 的「内容审核」入口行。
   复用 app.wxss 的 .card / .inner / .tag / .pressable / .hit / .segmented，
   这里只写本页特有的语义类，不重复声明上面的令牌。
   两条硬约束：
     1) 本页面任何祖先节点都不出现 transform（.container 只跑 opacity 动画），
        否则下面 position:fixed 的批量条会退化成相对定位；
     2) 全 rpx，不碰 window / document / backdrop-filter / clamp。 */

/* ---------- 页面骨架 ---------- */
.mod-page {
  /* 底部批量条 + 安全区留位，别让最后一张卡被压住 */
  padding-bottom: 300rpx;
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

.sec-title {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  flex-wrap: wrap;
  font-size: 30rpx;
  font-weight: 600;
  color: #172033;
  margin: 4rpx 4rpx 20rpx;
}
.sec-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #98a3b8;
}

/* 分段标签：32rpx 以下宽度也不溢出，短文案优先 */
.seg-label { font-size: 26rpx; }
.seg-item--hover { opacity: 0.72; }

/* ---------- 审核员在场 / 引导卡 ---------- */
.mod-brief {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
/* 图标方块：浅灰底 + 线性 outline 图标，沿用「内容审核」入口行的约定 */
.mod-brief__icon {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #eef1f6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mod-brief__icon-img { width: 44rpx; height: 44rpx; }
.mod-brief__body { flex: 1; min-width: 0; }

.auto-note {
  background: #f1faf5;
  border: 2rpx solid #cdebdc;
}
.auto-note__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #128a56;
  margin-bottom: 10rpx;
}
.auto-note__row {
  font-size: 24rpx;
  color: #2b6b45;
  line-height: 1.75;
}
.auto-note__hl { color: #128a56; font-weight: 600; }
.auto-note__note {
  margin-top: 12rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #a9dfc4;
  font-size: 23rpx;
  color: #5f7a6c;
  line-height: 1.7;
}

.setup-card .title-sm { margin-bottom: 16rpx; }
.setup-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.step-no {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #2b5aed;
  color: #ffffff;
  font-size: 20rpx;
}
.step-txt {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #4b525a;
  line-height: 1.6;
}
.setup-btn { margin-top: 20rpx; }
.setup-id {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #98a3b8;
  word-break: break-all;
  text-align: center;
}

.diag-card { background: #f6f8fb; padding: 20rpx 24rpx; }
.diag-line {
  font-size: 24rpx;
  color: #4a5057;
  line-height: 1.8;
  word-break: break-all;
}
.diag-hint {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed #e0e5ee;
  font-size: 22rpx;
  color: #b07a12;
  line-height: 1.7;
}

.guide-card {
  background: #fff8ec;
  border: 2rpx solid #f6e3bd;
}
.guide-card__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #a86a1c;
  margin-bottom: 10rpx;
}
.guide-card__row {
  font-size: 24rpx;
  color: #7a5a1c;
  line-height: 1.8;
}
.guide-card__row--dim { color: #a08a5a; margin-top: 6rpx; }

.guide-more {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}
.guide-more--hover { opacity: 0.72; }
.guide-more__icon { width: 32rpx; height: 32rpx; flex: none; }

.tip {
  font-size: 24rpx;
  color: #a86a1c;
  background: #fff8ec;
  border: 2rpx solid #f6e3bd;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

/* ---------- 举报队列卡片 ---------- */
.rep-card { overflow: hidden; }

.rep-card__head {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 16rpx;
}

/* 复选框：88rpx 热区 + 44rpx 视觉方框 */
.rep-check {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -12rpx;
}
.rep-check__box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 2rpx solid #cfd6e2;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.16s ease, border-color 0.16s ease;
}
.rep-check--on .rep-check__box {
  background: #2b5aed;
  border-color: #2b5aed;
}
.rep-check--hover { opacity: 0.7; }
.rep-check__icon { width: 28rpx; height: 28rpx; }

.rep-card__tags {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.rep-card__time {
  margin-left: auto;
  font-size: 22rpx;
  color: #98a3b8;
}

.rep-card__body { font-size: 27rpx; color: #172033; line-height: 1.7; }
.rep-card__who {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  font-size: 23rpx;
  color: #6f7b91;
}
.rep-card__who-icon { width: 28rpx; height: 28rpx; flex: none; }
.rep-card__title { margin-top: 8rpx; }
.rep-card__desc { color: #4b525a; margin-top: 6rpx; }
.rep-card__detail {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #f6f8fb;
  font-size: 24rpx;
  color: #6f7b91;
  line-height: 1.65;
}

/* 证据图片：一行最多 3 张，lazy-load 沿用 JS 的分屏加载 */
.rep-evidence {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.rep-evidence__img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: #f6f8fb;
}

.rep-ops {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 8rpx;
}
.op {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e3e6ea;
  background: #ffffff;
  font-size: 25rpx;
  color: #6f7b91;
}
.op--hover { opacity: 0.72; }
/* 通过 = 校园绿 #19A66A */
.op--pass {
  background: #e9f8f1;
  border-color: #bfe6d3;
  color: #128a56;
  font-weight: 600;
}
/* 驳回 = 危险色 #DD4B55 */
.op--danger {
  background: #fff0f1;
  border-color: #f6ccd0;
  color: #dd4b55;
  font-weight: 600;
}

.bottom-note {
  font-size: 23rpx;
  color: #98a3b8;
  line-height: 1.7;
  padding: 8rpx 6rpx 20rpx;
}
.bottom-note__hl {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  color: #7a5a1c;
  border-left: 6rpx solid #f0d8a0;
}

/* ---------- 置顶管理 ---------- */
.pin-card { margin-bottom: 0; }
.pin-main { flex: 1; min-width: 0; }
.pin-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #172033;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pin-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  min-width: 0;
}
.pin-meta__icon { width: 26rpx; height: 26rpx; flex: none; }
.pin-flag {
  flex: none;
  min-width: 120rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #eef1f6;
  color: #6f7b91;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pin-flag--on {
  background: #2b5aed;
  color: #ffffff;
}
.row--hover { background: #f7f9fc; }

/* ---------- 通知与数据 ---------- */
.setup-btn-wrap { margin-bottom: 24rpx; }
.cfg-card { background: #ffffff; }
.cfg-label {
  font-size: 26rpx;
  color: #4b525a;
  margin-bottom: 14rpx;
}
.cfg-input {
  width: 100%;
  box-sizing: border-box;
  font-size: 26rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f6f8fb;
  border: 2rpx solid #e8edf5;
  border-radius: 24rpx;
}
.cfg-hint {
  font-size: 22rpx;
  color: #128a56;
  margin-top: 12rpx;
}

/* ---------- 底部批量操作条（position:fixed） ---------- */
.batch-bar {
  bottom: 0;
  padding: 0 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to bottom, rgba(245, 247, 250, 0), #f5f7fa 40%);
}
.batch-bar__inner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 2rpx solid #e8edf5;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 51, 0.12);
}
.batch-bar__count {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #6f7b91;
}
.batch-bar__icon { width: 30rpx; height: 30rpx; }
.batch-bar__ops {
  display: flex;
  gap: 16rpx;
}
.batch-btn {
  flex: 1;
  min-width: 0;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.batch-btn--hover { opacity: 0.72; }
.batch-btn--off { opacity: 0.45; }
/* 驳回 = 危险色 #DD4B55（主按钮实心 / 次按钮描边） */
.batch-btn--danger {
  background: #dd4b55;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(221, 75, 85, 0.24);
}
.batch-btn--danger-ghost {
  background: #ffffff;
  color: #dd4b55;
  border: 2rpx solid #f6ccd0;
}
