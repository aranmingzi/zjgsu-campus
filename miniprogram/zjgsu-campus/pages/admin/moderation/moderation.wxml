<!-- pages/admin/moderation/moderation.wxml —— 内容审核
     举报队列 / 证据核对 / 批量处理 / 置顶管理 / 通知与数据
     视觉规格见 docs/native-ui-contract.md：
       · 举报卡片圆角 32rpx（.card），内层 24rpx（.inner）
       · 驳回 = 危险色 #DD4B55，通过 = 校园绿 #19A66A
       · 底部批量条 position:fixed（容器链路上绝不能出现 transform）
     云函数调用参数、分页/懒加载一律沿用 moderation.js，这里只改渲染。 -->
<app-header title="内容审核" showBack />

<view class="container mod-page">

  <!-- 分区切换：320 / 375 / 430 都不挤，短文案 + 26rpx -->
  <view class="sticky-filter">
    <view class="segmented">
      <view
        class="segmented-item {{tab === 'reports' ? 'segmented-item-on' : ''}}"
        data-tab="reports"
        bindtap="switchTab"
        hover-class="seg-item--hover"
        hover-stay-time="80"
      >
        <text class="seg-label">举报{{pending ? ' (' + pending + ')' : ''}}</text>
      </view>
      <view
        class="segmented-item {{tab === 'pin' ? 'segmented-item-on' : ''}}"
        data-tab="pin"
        bindtap="switchTab"
        hover-class="seg-item--hover"
        hover-stay-time="80"
      >
        <text class="seg-label">置顶{{pinnedCount ? ' (' + pinnedCount + ')' : ''}}</text>
      </view>
      <view
        class="segmented-item {{tab === 'notice' ? 'segmented-item-on' : ''}}"
        data-tab="notice"
        bindtap="switchTab"
        hover-class="seg-item--hover"
        hover-stay-time="80"
      >
        <text class="seg-label">通知</text>
      </view>
    </view>
  </view>

  <!-- ==================== 举报队列 ==================== -->
  <block wx:if="{{tab === 'reports'}}">

    <!-- 已进审核员名单：日常只需要底部那条「全部驳回」 -->
    <view wx:if="{{isMod}}" class="card mod-brief">
      <view class="mod-brief__icon">
        <image class="mod-brief__icon-img" src="/assets/icons/shield-check--campus.svg" mode="aspectFit" />
      </view>
      <view class="mod-brief__body">
        <view class="title-sm">你是审核员，一键清完就收工</view>
        <view class="muted">举报会先自动处置一轮，只有系统拿不准的才留到下面。</view>
      </view>
    </view>

    <view wx:if="{{isMod}}" class="card auto-note">
      <view class="auto-note__title">自动处置规则（这部分不用你判）</view>
      <view class="auto-note__row">
        <text class="auto-note__hl">同一条内容 24 小时内被 5 人举报</text> → 直接删除
      </view>
      <view class="auto-note__row">
        <text class="auto-note__hl">2 人指认广告 / 隐私 / 违规交易，且有人写了可查证的线索</text>（链接、联系方式、金额、时间地点）→ 直接删除
      </view>
      <view class="auto-note__row">
        2 人指认同样这几类，但只说「是广告」没给事实 → <text class="auto-note__hl">先下架</text>，进队列等你判
      </view>
      <view class="auto-note__row">3 人举报（一般原因）→ 先下架，进队列等你判</view>
      <view class="auto-note__note">
        冷启动期（全站举报还很冷清）会自动放宽门槛：下架 3→2 人，直接删除 5→3 人，
        另外「1 人 + 内容命中屏蔽词 + 他写了可查线索」也算数。社团招新、同好群这类正常社交内容永远不会被自动删除。
      </view>
      <view class="auto-note__note">
        已经处置完的不会再出现在下面的队列里。被暂停展示的内容也不会从全校消失 ——
        论坛列表顶部「因举报暂停展示」就是它们的入口。
      </view>
    </view>

    <!-- 成为审核员只能在服务端配名单 -->
    <view wx:else class="card setup-card">
      <view class="title-sm">成为审核员</view>
      <view class="setup-step">
        <text class="step-no">1</text>
        <text class="step-txt">把下面这个身份 ID 填进云函数「user」的环境变量 MODERATORS，多个用英文逗号隔开</text>
      </view>
      <view class="setup-step">
        <text class="step-no">2</text>
        <text class="step-txt">重新进一次本页就成了。真上线之后建议只填你自己一个 ID</text>
      </view>
      <base-button
        class="setup-btn"
        variant="primary"
        size="lg"
        block
        bind:tap="onCopyOpenid"
      >{{myOpenid ? '复制我的身份 ID' : '还没拿到身份，等一秒再点'}}</base-button>
      <view class="setup-id">当前身份 ID：{{myOpenid || '读取中…'}}</view>

      <!-- 两边判定分开摆：不一致 = 环境变量没生效；一致但不认 = ID 本身配错了 -->
      <view class="card card--flat diag-card inner">
        <view class="diag-line">
          前端名单（config.js）：
          <text class="{{localOk ? 'text-campus' : 'text-danger'}}">{{localOk ? '有你' : '没有你'}}</text>
        </view>
        <view class="diag-line">
          云函数（环境变量）：
          <text class="{{isMod ? 'text-campus' : 'text-danger'}}">{{diagDone ? (isMod ? '认你' : '不认你') : '检查中…'}}</text>
        </view>
        <view wx:if="{{diagHint}}" class="diag-hint">{{diagHint}}</view>
      </view>
    </view>

    <!-- 环境自检缺了什么：说人话，别让人对着报错猜 -->
    <view wx:if="{{needSetup && setupSteps.length}}" class="card guide-card">
      <view class="guide-card__title">还需要你在控制台点几下（照着做，两分钟）</view>
      <view wx:for="{{setupSteps}}" wx:key="*this" class="guide-card__row">{{item}}</view>
      <view class="guide-card__row guide-card__row--dim">
        建集合：开发者工具 → 云开发 → 数据库 → 点「+」→ 输集合名 → 权限选「所有用户可读，仅创建者可写」→ 确定 → 回来下拉刷新
      </view>
    </view>

    <view wx:if="{{needSetup && setupSteps.length === 0 && !isMod}}" class="card guide-card">
      <view class="guide-card__title">云函数可能还没部署</view>
      <view class="guide-card__row">
        在开发者工具里右键 cloudfunctions\user →「上传并部署：云端安装依赖」，等提示部署成功后，回来下拉刷新这个页面。
      </view>
    </view>

    <view wx:if="{{tip}}" class="tip">{{tip}}</view>

    <empty-state
      wx:if="{{isMod && queue.length === 0}}"
      icon="shield-check"
      iconColor="campus"
      title="队列已清空"
      description="这段时间不需要人工介入。"
      actionLabel="刷新队列"
      bind:action="loadQueue"
    />

    <!-- 举报队列卡片 -->
    <view wx:for="{{queue}}" wx:key="repId" wx:for-item="item" class="card rep-card">
      <view class="rep-card__head">
        <!-- 88rpx 热区，中间 44rpx 是视觉方框，选中态换成主色填充 -->
        <view
          class="rep-check {{checkedMap[item.repId] ? 'rep-check--on' : ''}}"
          data-rep="{{item.repId}}"
          catchtap="toggleCheck"
          hover-class="rep-check--hover"
          hover-stay-time="80"
        >
          <view class="rep-check__box">
            <image
              wx:if="{{checkedMap[item.repId]}}"
              class="rep-check__icon"
              src="/assets/icons/check--white.svg"
              mode="aspectFit"
            />
          </view>
        </view>

        <view class="rep-card__tags">
          <text class="tag tag--danger">{{item.reason}}</text>
          <text wx:if="{{item.reviewOnly}}" class="tag tag--market">{{abuseBadge || '观察期'}}</text>
          <text wx:if="{{item.reportCount}}" class="tag tag--gray">{{item.reportCount}} 人举报</text>
          <text class="rep-card__time">{{item.time}}</text>
        </view>
      </view>

      <view class="rep-card__body">
        <view class="rep-card__who">
          <image class="rep-card__who-icon" src="/assets/icons/file-text--muted.svg" mode="aspectFit" />
          <text class="muted truncate">{{item.targetNick}}</text>
          <text class="label">
            {{item.targetType === 'review' ? '课程评价' : '论坛帖子'}}{{item.board ? ' · ' + item.board : ''}}
          </text>
        </view>

        <view wx:if="{{item.title}}" class="body-text strong clamp2 rep-card__title">{{item.title}}</view>
        <view class="rep-card__desc">{{item.desc}}</view>
        <view wx:if="{{item.detail}}" class="rep-card__detail inner">举报说明：{{item.detail}}</view>

        <!-- 证据图片：接口给了图就横向排，图走 lazy-load，不进首屏就不下载 -->
        <view wx:if="{{item.evidence && item.evidence.length > 0}}" class="rep-evidence">
          <image
            wx:for="{{item.evidence}}"
            wx:for-item="src"
            wx:key="*this"
            class="rep-evidence__img"
            src="{{src}}"
            mode="aspectFill"
            lazy-load
          />
        </view>
      </view>

      <view class="rep-ops">
        <view
          wx:if="{{item.contentStatus === 'hidden'}}"
          class="op op--pass"
          data-item="{{item}}"
          catchtap="restoreOne"
          hover-class="op--hover"
          hover-stay-time="80"
        >通过并恢复展示</view>
        <view
          class="op"
          data-rep="{{item.repId}}"
          catchtap="toggleCheck"
          hover-class="op--hover"
          hover-stay-time="80"
        >{{checkedMap[item.repId] ? '取消勾选' : '勾选驳回'}}</view>
        <view
          class="op op--danger"
          data-item="{{item}}"
          catchtap="confirmOne"
          hover-class="op--hover"
          hover-stay-time="80"
        >确认违规</view>
      </view>
    </view>

    <view wx:if="{{isMod && queue.length > 0}}" class="bottom-note">
      勾选后可用底部「驳回已选」批量清掉同一类的举报。默认「全部驳回」最省事，
      只有确实违规的才用卡片上的「确认违规」。
      <view wx:if="{{hasAbuse}}" class="bottom-note__hl">
        带「{{abuseBadge || '观察期'}}」标签的这几条来自正在观察期的同学 ——
        系统没拿它们自动处置过，是等你自己判的。驳回会计数，但只要有一条你判「确认违规」，
        他的观察期当场就解除了，不用一直背着。
      </view>
    </view>
  </block>

  <!-- ==================== 置顶管理 ==================== -->
  <block wx:if="{{tab === 'pin'}}">
    <view class="sec-title">
      <text>置顶帖子</text>
      <text class="sec-sub">最多同时 3 条，置顶帖在所有排序里都排最前</text>
    </view>
    <view wx:if="{{!isMod && myOpenid}}" class="setup-btn-wrap">
      <base-button variant="secondary" block bind:tap="onCopyOpenid">复制我的身份 ID，填进 MODERATORS</base-button>
    </view>
    <view wx:if="{{isMod && !pinList.length}}" class="card guide-card">
      <view class="guide-card__row">本地还没有帖子缓存，先切回「举报」或者进一次论坛。</view>
    </view>

    <view class="card card--flush pin-card">
      <view wx:for="{{pinList}}" wx:key="id" wx:for-item="item" class="row pressable" data-id="{{item.id}}" catchtap="togglePin">
        <view class="pin-main">
          <view class="pin-title">{{item.title}}</view>
          <view class="pin-meta">
            <image class="pin-meta__icon" src="/assets/icons/message-square--faint.svg" mode="aspectFit" />
            <text class="muted truncate">{{item.board}} · {{item.time}}</text>
            <image class="pin-meta__icon" src="/assets/icons/thumbs-up--faint.svg" mode="aspectFit" />
            <text class="label">{{item.likes}}</text>
            <image class="pin-meta__icon" src="/assets/icons/message-square--faint.svg" mode="aspectFit" />
            <text class="label">{{item.comments}}</text>
          </view>
        </view>
        <view class="pin-flag {{item.pinned ? 'pin-flag--on' : ''}}">
          {{item.pinned ? '已置顶' : '置顶'}}
        </view>
      </view>
    </view>

    <view wx:if="{{isMod}}" class="bottom-note">置顶是运营位，别贪多：最多 3 条，多了学生反而不点。</view>
  </block>

  <!-- ==================== 通知与数据 ==================== -->
  <block wx:if="{{tab === 'notice'}}">
    <view class="sec-title"><text>订阅消息模板 ID</text></view>
    <view class="card guide-card">
      <view class="guide-card__row">1. mp 后台 → 功能 → 订阅消息 → 公共模板库：评论类选「评论回复通知」，私信类选「新信件提醒」</view>
      <view class="guide-card__row">2. 关键词勾选顺序：评论 = 回复者→原评论→回复内容→时间；私信 = 提醒内容→温馨提示→更新时间</view>
      <view class="guide-card__row">3. 提交后到「我的模板」→ 详情里复制模板 ID，粘到下面的框里保存。留空只是收不到提醒，其他功能照常</view>
    </view>
    <view class="pressable guide-more" bindtap="copyTemplateGuide" hover-class="guide-more--hover" hover-stay-time="80">
      <image class="guide-more__icon" src="/assets/icons/filter--brand.svg" mode="aspectFit" />
      <text class="muted">不知道去哪找？点这里看图文说明</text>
    </view>

    <view class="card cfg-card">
      <view class="cfg-label">回复提醒模板 ID</view>
      <input
        class="cfg-input"
        placeholder="「评论回复通知」模板 ID"
        value="{{submsgInput.reply}}"
        data-k="reply"
        bindinput="onCfgInput"
      />
      <view wx:if="{{submsgFromEnv.reply}}" class="cfg-hint">检测到环境变量里已配了回复模板，上面留空就用它的。</view>

      <view class="cfg-label">私信提醒模板 ID</view>
      <input
        class="cfg-input"
        placeholder="「新信件提醒」模板 ID"
        value="{{submsgInput.chat}}"
        data-k="chat"
        bindinput="onCfgInput"
      />
      <view wx:if="{{submsgFromEnv.chat}}" class="cfg-hint">检测到环境变量里已配了私信模板，上面留空就用它的。</view>
    </view>

    <view wx:if="{{cfgTip}}" class="tip">{{cfgTip}}</view>
    <base-button variant="primary" block bind:tap="saveCfg">保存模板 ID</base-button>

    <view class="sec-title"><text>校历数据</text></view>
    <view class="card guide-card">
      <view class="guide-card__row">当前校历已按教务处官方通知内置：期中 11/2、四六级口语 11/21、四六级笔试 12/12、考研初试 12/26、期末 1/4、寒假 1/18。</view>
    </view>
    <base-button variant="secondary" block bind:tap="importCalendar">一键导入官方校历</base-button>
    <view class="bottom-note">改过校历节点、或者学校出了新通知，点上面这条会整体替换成官方版本。</view>
  </block>
</view>

<!-- 底部批量操作条：position:fixed 挂在页面根节点上，
     它的任何祖先（.container / .sticky-filter）都没有 transform，固定定位才沉得下去 -->
<view wx:if="{{tab === 'reports' && isMod && queue.length > 0}}" class="batch-bar fixed-bar">
  <view class="batch-bar__inner">
    <view class="batch-bar__count">
      <image class="batch-bar__icon" src="/assets/icons/list-checks--brand.svg" mode="aspectFit" />
      <text>已选 {{checked.length}} / {{pending}} 条</text>
    </view>
    <view class="batch-bar__ops">
      <view
        class="batch-btn batch-btn--danger {{checked.length ? '' : 'batch-btn--off'}}"
        bindtap="rejectChecked"
        hover-class="batch-btn--hover"
        hover-stay-time="80"
      >驳回已选</view>
      <view
        class="batch-btn batch-btn--danger-ghost"
        bindtap="rejectAll"
        hover-class="batch-btn--hover"
        hover-stay-time="80"
      >全部驳回</view>
    </view>
  </view>
</view>
