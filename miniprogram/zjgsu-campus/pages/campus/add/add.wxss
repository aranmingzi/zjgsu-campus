/* pages/campus/add/add —— 发起校园活动表单
   表单控件统一走「浅灰底 + 校园绿聚焦描边」，与 app.wxss 的令牌保持一致。 */

.add-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 25rpx;
  color: #6f7b91;
  margin: 28rpx 0 12rpx;
}
.add-label:first-child { margin-top: 0; }
.add-req { color: #dd4b55; }

.add-types {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.add-type {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e8edf5;
  background: #ffffff;
  color: #6f7b91;
  font-size: 26rpx;
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}
.add-type.on {
  background: #e9f8f1;
  border-color: #19a66a;
  color: #128a56;
  font-weight: 600;
}
.add-type__icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.add-type__label { max-width: 120rpx; overflow: hidden; white-space: nowrap; }
.add-type__check {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-left: 2rpx;
}

.add-input,
.add-textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f6f8fb;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #172033;
  border: 2rpx solid transparent;
  transition: border-color 0.2s ease, background-color 0.2s ease;
}
.add-input {
  min-height: 92rpx;
  padding: 20rpx 24rpx;
}
.add-textarea {
  min-height: 200rpx;
  max-height: 560rpx;
  padding: 20rpx 24rpx;
  line-height: 1.7;
}
.add-ph { color: #98a3b8; }

.add-time {
  display: flex;
  gap: 16rpx;
}
.add-time__cell {
  flex: 1;
  min-width: 0;
}
.add-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #f6f8fb;
  font-size: 28rpx;
  color: #172033;
}
.add-picker__icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.add-picker.ph { color: #98a3b8; }

.add-count {
  text-align: right;
  font-size: 22rpx;
  color: #98a3b8;
  margin-top: 10rpx;
}

.add-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  margin: 8rpx 0 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}
.add-submit::after { border: none; }
.add-submit--hover { opacity: 0.86; }

.add-tip {
  font-size: 22rpx;
  color: #98a3b8;
  text-align: center;
  line-height: 1.7;
  padding: 20rpx 24rpx 60rpx;
}
