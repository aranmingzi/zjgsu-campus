/* pages/campus/campus —— 校园 Tab 样式 */

/* 顶部分段：选中项下面一条白线，手指一动就知道切到哪块了 */
.seg {
  display: flex;
  background: #e9edf3;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #6b7280;
  padding: 14rpx 0;
  border-radius: 999rpx;
  position: relative;
}
.seg-item.on {
  color: #1a5fb4;
  font-weight: 600;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 发布引导条 */
.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(90deg, #eaf1fc, #f5f9ff);
  border-radius: 18rpx;
  padding: 22rpx 26rpx;
  margin-bottom: 24rpx;
}
.notice-txt { font-size: 25rpx; color: #40536b; }
.notice-go { font-size: 25rpx; color: #1a5fb4; font-weight: 600; }

/* 官网同步条 */
.sync-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.sync-title { font-size: 26rpx; color: #1f2329; font-weight: 600; }
.sync-sub { font-size: 22rpx; color: #8a9099; margin-top: 6rpx; }
.sync-btn {
  font-size: 24rpx;
  color: #1a5fb4;
  background: #eef3fb;
  border-radius: 999rpx;
  padding: 13rpx 30rpx;
  margin-left: 20rpx;
  white-space: nowrap;
}
.sync-btn.on { color: #9aa1a9; background: #f2f4f7; }

/* 活动分类切换：官方的和同学组织的性质不同，得能单独看 */
.filt-row {
  display: flex;
  flex-wrap: wrap;
  margin: 0 0 18rpx;
}
.filt-chip {
  font-size: 23rpx;
  color: #6b7280;
  background: #fff;
  border: 1rpx solid #e6e9ee;
  border-radius: 999rpx;
  padding: 9rpx 22rpx;
  margin: 0 14rpx 14rpx 0;
}
.filt-chip.on {
  color: #fff;
  background: #1a5fb4;
  border-color: #1a5fb4;
  font-weight: 600;
}
.filt-empty {
  font-size: 24rpx;
  color: #9aa0a6;
  text-align: center;
  padding: 30rpx 0;
}

/* 区块小标题：把「官网的」和「同学发的」在视觉上分开 */
.sec-head {
  font-size: 23rpx;
  color: #9aa1a9;
  letter-spacing: 1rpx;
  margin: 10rpx 0 14rpx;
}

/* 官方活动卡片上的来源标记与原文入口 */
.ev-src {
  font-size: 22rpx;
  color: #8a6d3b;
  background: #fdf6e3;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-left: 12rpx;
}
.ev-link { font-size: 22rpx; color: #1a5fb4; margin-left: auto; }
.ev-wrap { margin-bottom: 20rpx; }

/* 活动卡片 */
.ev-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.ev-type {
  font-size: 22rpx;
  color: #1a5fb4;
  background: #eef3fb;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.ev-joined {
  margin-left: auto;
  font-size: 22rpx;
  color: #0f8b5f;
  background: #e8f8f1;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.ev-mine {
  margin-left: auto;
  font-size: 22rpx;
  color: #8a6d3b;
  background: #fdf6e3;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.ev-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 8rpx;
}
.ev-row { font-size: 25rpx; color: #5b636d; }
.ev-desc {
  font-size: 25rpx;
  color: #6b7280;
  margin-top: 10rpx;
  /* 详情最多两行，多了截断：列表页看不完，进详情看 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ev-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}

/* 校历 */
.next-card {
  background: linear-gradient(135deg, #1a5fb4, #3d86e0);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  color: #fff;
}
.next-label { font-size: 23rpx; opacity: .85; }
.next-text { font-size: 32rpx; font-weight: 600; margin-top: 8rpx; }

.cal-item { display: flex; align-items: flex-start; }
.cal-item.past { opacity: .5; }
.cal-left {
  width: 190rpx;
  text-align: center;
  border-right: 1rpx solid #eef0f3;
  padding-right: 20rpx;
  margin-right: 20rpx;
}
.cal-date { font-size: 26rpx; color: #5b636d; }
.cal-days { font-size: 24rpx; color: #1a5fb4; margin-top: 4rpx; }
.cal-right { flex: 1; }
.cal-name { font-size: 29rpx; font-weight: 600; }
.cal-note { font-size: 23rpx; color: #8a9099; margin-top: 4rpx; }

/* 地点 */
.cat-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}
.cat-chip {
  font-size: 24rpx;
  color: #6b7280;
  background: #fff;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin: 0 14rpx 14rpx 0;
}
.cat-chip.on {
  color: #fff;
  background: #1a5fb4;
}

.pl-item { display: flex; align-items: center; }
.pl-icon {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 32rpx;
  background: #f4f7fb;
  border-radius: 14rpx;
  margin-right: 20rpx;
}
.pl-body { flex: 1; }
.pl-name { font-size: 29rpx; font-weight: 600; }
.pl-desc { font-size: 23rpx; color: #8a9099; }
.pl-go { font-size: 24rpx; color: #1a5fb4; }

/* 底部入口行 */
.more-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  margin: 8rpx 0 40rpx;
  font-size: 26rpx;
  color: #5b636d;
}
.more-go { color: #b0b6be; }

/* 骨架屏 */
.sk-wrap { margin-top: 8rpx; }
.sk-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: #eef0f3;
  margin-bottom: 14rpx;
}
.sk-title { width: 60%; height: 30rpx; }
.sk-mid { width: 85%; }
.sk-short { width: 40%; margin-bottom: 0; }

.empty-icon { font-size: 64rpx; }
.empty-hint { font-size: 24rpx; color: #c6cbd2; margin-top: 10rpx; }
