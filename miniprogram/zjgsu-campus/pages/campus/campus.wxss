/* pages/campus/campus —— 校园 Tab（活动信息 / 校历 / 地点地图）
   底部留出 tabBar + 悬浮按钮的位置，内容不会被压住。
   三档切换的选中色统一走校园绿 #19A66A / 浅底 #E9F8F1；
   过渡只碰 background-color / color / opacity，不做位移，容器上也不加 transform
   （.container 一旦有 transform，页内的悬浮按钮会退化成相对定位）。 */

/* --------------------------------------------------------------------------
   顶部 Banner（utils/banner.wxml 被 include 到这里）
   这页之前漏了 banner 的样式，轮播会裸奔；现在按「白底卡 + 32rpx 圆角 +
   0 8rpx 24rpx 阴影」的统一令牌补齐，图标走线性 outline（bannerTone=brand）。
   -------------------------------------------------------------------------- */
.top-banner {
  margin: 24rpx 0 0;
  border-radius: 32rpx;
  overflow: hidden;
}
.top-banner-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 160rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.top-banner-icon {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
}
.top-banner-main { flex: 1; min-width: 0; }
.top-banner-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #ffffff;
  background: #f58a32;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.top-banner-title {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.top-banner-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6f7b91;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.top-banner-go {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
}
.top-banner-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 12rpx;
  margin-bottom: 20rpx;
}
.top-banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #dfe4ec;
}
.top-banner-dot.on { background: #f58a32; width: 28rpx; }

.hub {
  padding-bottom: 220rpx;
}

/* --------------------------------------------------------------------------
   三档分段控件
   -------------------------------------------------------------------------- */
.hub-seg {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border-radius: 999rpx;
  background: #eef1f6;
}
.hub-seg__item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 96rpx;
  border-radius: 999rpx;
  transition: background-color 0.26s ease, color 0.26s ease;
}
.hub-seg__icon {
  width: 34rpx;
  height: 34rpx;
  transition: opacity 0.26s ease;
}
.hub-seg__label {
  font-size: 22rpx;
  color: #6f7b91;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  transition: color 0.26s ease;
}
.hub-seg__item.on {
  background: #e9f8f1;
}
.hub-seg__item.on .hub-seg__label {
  color: #19a66a;
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   发布入口卡
   -------------------------------------------------------------------------- */
.hub-publish {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(90deg, #e9f8f1 0%, #ffffff 72%);
  border: 2rpx solid #e9f8f1;
  box-shadow: none;
}
.hub-publish__icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(25, 166, 106, 0.14);
}
.hub-publish__icon-img {
  width: 40rpx;
  height: 40rpx;
}
.hub-publish__body {
  flex: 1;
  min-width: 0;
}
.hub-publish__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #172033;
}
.hub-publish__sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6f7b91;
}
.hub-publish__go {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-height: 88rpx;
  padding-left: 8rpx;
}
.hub-publish__go-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #19a66a;
}
.hub-publish__go-icon {
  width: 28rpx;
  height: 28rpx;
}

/* --------------------------------------------------------------------------
   官网同步条
   -------------------------------------------------------------------------- */
.hub-sync {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  box-shadow: none;
  border: 2rpx solid #eef1f6;
}
.hub-sync__main {
  flex: 1;
  min-width: 0;
}
.hub-sync__title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #172033;
}
.hub-sync__icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}
.hub-sync__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #98a3b8;
}
.hub-sync__btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #e9f8f1;
  color: #128a56;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}
.hub-sync__btn-icon {
  width: 30rpx;
  height: 30rpx;
}
/* 同步中：图标转起来，文字保持不动，避免按钮宽度跳 */
.hub-sync__btn.spin .hub-sync__btn-icon {
  animation: hubSpin 0.9s linear infinite;
}
@keyframes hubSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* --------------------------------------------------------------------------
   活动过滤 + 区块标题
   -------------------------------------------------------------------------- */
.hub-filt {
  display: flex;
  flex-wrap: wrap;
  margin: 0 0 20rpx;
}
.hub-filt__chip {
  font-size: 22rpx;
  color: #6f7b91;
  background: #ffffff;
  border: 2rpx solid #e8edf5;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  margin: 0 14rpx 14rpx 0;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}
.hub-filt__chip.on {
  color: #ffffff;
  background: #19a66a;
  border-color: #19a66a;
  font-weight: 600;
}
.hub-filt__empty {
  font-size: 24rpx;
  color: #98a3b8;
  text-align: center;
  padding: 30rpx 0;
}
.hub-sec {
  margin-bottom: 8rpx;
}
.hub-sec__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-left: 4rpx;
  font-size: 22rpx;
  color: #128a56;
  margin: 6rpx 0 14rpx;
}
.hub-sec__icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

/* --------------------------------------------------------------------------
   活动卡
   -------------------------------------------------------------------------- */
.ev__top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 44rpx;
}
.ev__tag--official {
  background: #eff4ff;
  color: #2047c9;
}
.ev__src {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #98a3b8;
}
.ev__link {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 22rpx;
  color: #2b5aed;
}
.ev__link-icon {
  width: 24rpx;
  height: 24rpx;
}
.ev__badge {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #128a56;
  background: #e9f8f1;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.ev__badge--joined {
  color: #2047c9;
  background: #eff4ff;
}

.ev__title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #172033;
  line-height: 1.5;
}
.ev__row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6f7b91;
  min-width: 0;
}
.ev__row-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
.ev__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6f7b91;
  line-height: 1.6;
}

.ev__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #e8edf5;
}
.ev__stat {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #6f7b91;
}
.ev__stat-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
.ev__more {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-height: 88rpx;
  padding-left: 8rpx;
}
.ev__more-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #19a66a;
}
.ev__foot-icon {
  width: 26rpx;
  height: 26rpx;
}

/* --------------------------------------------------------------------------
   校历
   -------------------------------------------------------------------------- */
.cal-hero {
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #19a66a 0%, #0f8f58 100%);
  box-shadow: 0 12rpx 28rpx rgba(25, 166, 106, 0.22);
  color: #ffffff;
}
.cal-hero__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}
.cal-hero__icon {
  width: 30rpx;
  height: 30rpx;
}
.cal-hero__text {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.cal-list {
  padding-left: 8rpx;
}
.cal-item {
  position: relative;
  padding-left: 36rpx;
  transition: opacity 0.3s ease;
}
.cal-item.past { opacity: 0.5; }
/* 时间轴竖线：从第一个节点连到最后一个 */
.cal-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 56rpx;
  bottom: -14rpx;
  width: 2rpx;
  background: #19a66a;
  opacity: 0.35;
}
.cal-item__dot {
  position: absolute;
  left: 6rpx;
  top: 52rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #19a66a;
  box-shadow: 0 0 0 6rpx #e9f8f1;
}
.cal-item__body {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.cal-item__main {
  flex: 1;
  min-width: 0;
}
.cal-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #172033;
  line-height: 1.5;
}
.cal-item__date {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6f7b91;
}
.cal-item__note {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #98a3b8;
  line-height: 1.6;
}
.cal-item__days {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 220rpx;
  min-height: 56rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #e9f8f1;
  color: #128a56;
  font-size: 22rpx;
}
.cal-item__days-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

/* --------------------------------------------------------------------------
   地点地图
   -------------------------------------------------------------------------- */
.hub-cats {
  margin-bottom: 20rpx;
}
.hub-cats__scroll {
  white-space: nowrap;
}
.hub-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e8edf5;
  background: #ffffff;
  color: #6f7b91;
  font-size: 26rpx;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}
.hub-chip--on {
  background: #19a66a;
  border-color: #19a66a;
  color: #ffffff;
  font-weight: 600;
}

.pl {
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: background-color 0.24s ease, border-color 0.24s ease;
}
.pl.on {
  border-color: #19a66a;
  background: #f7fdfb;
}
.pl__icon {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #e9f8f1;
}
.pl__icon-img {
  width: 44rpx;
  height: 44rpx;
}
.pl__body {
  flex: 1;
  min-width: 0;
}
.pl__name {
  font-size: 29rpx;
  font-weight: 600;
  color: #172033;
}
.pl__meta {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  min-width: 0;
}
.pl__cat {
  flex-shrink: 0;
  color: #128a56;
  background: #e9f8f1;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.pl__desc {
  min-width: 0;
  color: #98a3b8;
}
.pl__go {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 2rpx;
  min-height: 88rpx;
}
.pl__go-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #19a66a;
}
.pl__go-icon {
  width: 26rpx;
  height: 26rpx;
}

/* --------------------------------------------------------------------------
   底部公共入口行 + 悬浮发布按钮
   -------------------------------------------------------------------------- */
.hub-more {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 112rpx;
  margin-top: 8rpx;
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.hub-more__icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}
.hub-more__text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #6f7b91;
}
.hub-more__go {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  color: #98a3b8;
}

.hub-fab {
  right: 32rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #19a66a;
  box-shadow: 0 10rpx 26rpx rgba(25, 166, 106, 0.34);
}
.hub-fab__icon {
  width: 48rpx;
  height: 48rpx;
}

/* --------------------------------------------------------------------------
   空状态配图
   -------------------------------------------------------------------------- */
.empty-art {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 16rpx;
}
