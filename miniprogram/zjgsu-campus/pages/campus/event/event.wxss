/* pages/campus/event/event —— 活动详情 */

.ev-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.ev-type {
  font-size: 22rpx;
  color: #1a5fb4;
  background: #eef3fb;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.ev-mine {
  margin-left: auto;
  font-size: 22rpx;
  color: #8a6d3b;
  background: #fdf6e3;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.ev-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.ev-row { font-size: 26rpx; color: #5b636d; margin-bottom: 6rpx; }
.ev-desc {
  font-size: 27rpx;
  color: #3d434b;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f1f3;
  white-space: pre-wrap;
}

.sec-title { font-size: 26rpx; color: #6b7280; margin-bottom: 14rpx; }
.contact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f2f4f7;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1a5fb4;
}
.contact-go { font-size: 24rpx; color: #8a9099; }

.act {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  font-size: 27rpx;
  text-align: center;
  margin-top: 8rpx;
}
.act-danger { color: #c0392b; background: #fdecea; }

.foot-space { height: 200rpx; }

/* 底部操作条：常驻可见，报名不用滚到底找按钮 */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #eef0f3;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}
.bar-btn {
  text-align: center;
  background: #1a5fb4;
  color: #fff;
  font-size: 31rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
}
.bar-btn.joined {
  background: #eef3fb;
  color: #1a5fb4;
}
