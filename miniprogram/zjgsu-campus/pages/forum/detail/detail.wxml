<!-- pages/forum/detail/detail.wxml —— 帖子详情（投票 + 留言） -->
<app-header title="{{post ? post.board : '帖子详情'}}" showBack />

<view class="container detail-page">
  <!-- 被限时多人举报自动删掉：说清为什么，别让人以为是没加载出来 -->
  <view wx:if="{{gone}}" class="card">
    <view class="title-lg">这条内容已经被删除</view>
    <view class="hint">因为 24 小时内有多名同学举报它违规，系统已经自动删除，不用等人工处理。</view>
    <view class="muted">如果这是误判，可以联系审核员恢复。</view>
    <view class="btn-ghost tap detail__back" bindtap="goBack">返回论坛</view>
  </view>

  <!-- 按 id 没取到内容：说清楚原因，别留一片空白让人以为程序坏了 -->
  <view wx:if="{{missing}}" class="card">
    <view class="title-lg">这条内容不见了</view>
    <view class="hint">它可能已经被删除，或者当前账号没有查看权限。链接失效的话，从列表里重新找找看。</view>
    <view class="btn-ghost tap detail__back" bindtap="goBack">返回论坛</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="detail__head">
        <view class="tag tag--forum">{{post.board}}</view>
        <view wx:if="{{post.kind === 'topic'}}" class="tag tag--campus">
          <image class="detail__mini-icon" src="/assets/icons/list-checks--campus.svg" mode="aspectFit" />
          <text>信息墙</text>
        </view>
        <text class="detail__time">{{post.time}}</text>
      </view>

      <view wx:if="{{post.courseName}}" class="detail__course tap" data-id="{{post.courseId}}" bindtap="goCourse">
        <image class="detail__mini-icon" src="/assets/icons/book-open--brand.svg" mode="aspectFit" />
        <text class="detail__course-text">{{post.courseName}}</text>
        <text class="detail__course-go">查看课程详情 ›</text>
      </view>

      <view class="title-lg detail__title">{{post.title}}</view>
      <!-- 信息墙的正文位是空的，补一句说明，顺便告诉他信息该去哪儿看 -->
      <view wx:if="{{post.kind === 'topic'}}" class="detail__topic-intro">
        这条只列了主题，具体信息收在下面 —— 需要的话往这儿留言，也有人在这里留了。
      </view>
      <view wx:else class="detail__body">{{post.content}}</view>

      <view wx:if="{{postImages.length}}" class="detail__images">
        <image wx:for="{{postImages}}" wx:key="*this" class="detail__img tap" src="{{item}}" mode="aspectFill" data-imgs="{{postImages}}" bindtap="previewImages"></image>
      </view>

      <view class="detail__meta">
        <text>{{post.showAuthor}}</text>
        <!-- 匿名帖不给主页入口：点进去就等于把人认出来了 -->
        <text wx:if="{{post.authorOpenid && !post.anonymous}}" class="detail__author tap" data-openid="{{post.authorOpenid}}" catchtap="goAuthor"> · 看TA的主页 ›</text>
      </view>

      <view class="detail__ops">
        <!-- 树洞帖的赞叫「抱抱」，且没有踩 -->
        <view class="detail__op {{post.liked ? 'detail__op--on' : ''}} tap" bindtap="onLike">
          <image class="detail__op-icon" src="{{post.liked ? '/assets/icons/thumbs-up--brand600.svg' : '/assets/icons/thumbs-up--muted.svg'}}" mode="aspectFit" />
          <text>{{isHole ? '抱抱 ' : ''}}{{post.likes}}</text>
        </view>
        <view wx:if="{{!isHole}}" class="detail__op {{post.disliked ? 'detail__op--no' : ''}} tap" bindtap="onDislike">
          <image class="detail__op-icon" src="{{post.disliked ? '/assets/icons/thumbs-down--brand600.svg' : '/assets/icons/thumbs-down--muted.svg'}}" mode="aspectFit" />
          <text>{{post.dislikes}}</text>
        </view>
        <button class="detail__op detail__op--btn" open-type="share" size="mini">
          <image class="detail__op-icon" src="/assets/icons/share-2--muted.svg" mode="aspectFit" />
          <text>分享</text>
        </button>
        <view class="detail__op detail__op--fav {{favorited ? 'detail__op--fav-on' : ''}} tap" catchtap="onFavorite">
          <image class="detail__op-icon" src="{{favorited ? '/assets/icons/star--market.svg' : '/assets/icons/star--muted.svg'}}" mode="aspectFit" />
          <text>{{favorited ? '已收藏' : '收藏'}}</text>
        </view>
        <view wx:if="{{post.hidden && canRestore}}" class="detail__op tap" catchtap="onRestore">恢复展示</view>
        <view wx:elif="{{post.hidden}}" class="detail__op detail__op--warn tap" catchtap="onReport">继续举报</view>
        <view wx:elif="{{isMine}}" class="detail__op tap" catchtap="onDelete">删除帖子</view>
        <view wx:elif="{{canChat}}" class="detail__op tap" catchtap="goChat">打个招呼</view>
        <view wx:else class="detail__op tap" catchtap="onReport">举报</view>
      </view>

      <view wx:if="{{post.status === 'deleted'}}" class="detail__tip">
        这条内容已经在全校范围内被删除：24 小时内有多名同学举报，系统自动处理的，不用等人工确认。
        确认是误判的话，点「恢复展示」就能放回来。
      </view>
      <view wx:elif="{{post.hidden}}" class="detail__tip">
        这条内容已因举报暂停展示。确认没有违规的话，点「恢复展示」即可。
      </view>
    </view>

    <!-- 投票帖：顶部一张概览，下面一张 vote-card 承载「未投票 / 已投票 / 已结束」三态 -->
    <view wx:if="{{post.kind === 'vote' && post.voteData}}" class="poll-hero">
      <view class="poll-hero__ring">
        <view class="poll-hero__core">
          <text class="poll-hero__count">{{post.voteData.totalVotes}}</text>
          <text class="poll-hero__unit">人已参与</text>
        </view>
      </view>
      <view class="poll-hero__text">
        <view class="poll-hero__mode">{{post.voteData.multiple ? '多选' : '单选'}} · {{post.voteData.anonymous ? '匿名投票' : '公开投票'}}</view>
        <view class="poll-hero__deadline">
          <image class="poll-hero__clock" src="/assets/icons/clock--white.svg" mode="aspectFit" />
          <text>{{post.voteData.ended ? '投票已结束，结果仅供查看' : '投票进行中，每 10 秒自动更新'}}</text>
        </view>
      </view>
    </view>

    <vote-card wx:if="{{post.kind === 'vote' && post.voteData}}" voteData="{{post.voteData}}" />

    <!-- 信息墙的评论区要跟普通帖区分开：这里叫「N 条信息」 -->
    <view class="detail__section">
      <image class="detail__section-icon" src="/assets/icons/message-circle--brand.svg" mode="aspectFit" />
      <text>{{post.kind === 'topic' ? '信息（' + post.comments.length + '）' : '评论（' + post.comments.length + '）'}}</text>
    </view>

    <view wx:if="{{post.comments.length === 0}}" class="empty">{{post.kind === 'topic' ? '还什么都没有，第一个留下的' : '还没有评论，抢沙发～'}}</view>

    <view wx:for="{{post.comments}}" wx:key="id" wx:for-item="c" class="card comment">
      <view class="comment__head">
        <text class="comment__name">{{c.author}}</text>
        <text class="muted comment__time">{{c.time}}</text>
        <text wx:if="{{c.canRemove}}" class="comment__del tap" data-id="{{c.id}}" catchtap="onRemoveComment">删除</text>
        <text wx:elif="{{!c.reported}}" class="comment__report tap" data-id="{{c.id}}" catchtap="onReportComment">举报</text>
        <text wx:else class="comment__reported">已举报</text>
      </view>
      <view class="comment__content">{{c.content}}</view>
    </view>
  </block>

  <!-- 固定底栏：Web 版是 sticky，这里用 fixed（.container 上没有 transform，固定定位不会退化） -->
  <view class="input-bar">
    <input class="input-bar__input" placeholder="{{post.kind === 'topic' ? '留下你的群号 / 联系方式' : '友善评论，理性发言'}}" value="{{commentText}}" bindinput="onComment" confirm-type="send" bindconfirm="sendComment" />
    <view class="input-bar__send {{commentText ? '' : 'input-bar__send--off'}} tap" bindtap="sendComment">发送</view>
  </view>
</view>
