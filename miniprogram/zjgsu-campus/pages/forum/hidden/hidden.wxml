<!-- pages/forum/hidden/hidden.wxml —— 被举报暂停展示的内容 -->
<app-header title="暂停展示的内容" showBack />

<view class="container">
  <view class="tip-card">
    <view class="tip-card__head">
      <view class="tip-card__icon">
        <image class="tip-card__icon-img" src="/assets/icons/lock--market.svg" mode="aspectFit" />
      </view>
      <view class="tip-card__title">这些内容因为被同学举报，暂时从列表里收起来了</view>
    </view>
    <view class="tip-card__body">不是删掉了：确认没有违规的话可以恢复，被举报也会继续记录，
      24 小时内凑够人数系统会自动处置，不用等人工确认。</view>
  </view>

  <view wx:if="{{posts.length === 0}}" class="empty">暂时没有暂停展示的内容</view>

  <view wx:for="{{posts}}" wx:key="id" wx:for-item="p" class="card post tap" data-id="{{p.id}}" bindtap="goDetail">
    <view class="post__head">
      <view class="tag tag--gray">{{p.board}}</view>
      <view class="post__lock">
        <image class="post__mini-icon" src="/assets/icons/lock--market.svg" mode="aspectFit" />
        <text>暂停展示</text>
      </view>
    </view>
    <view class="title-md post__title">{{p.title}}</view>
    <view class="post__content">{{p.content}}</view>
    <view class="post__foot">
      <text class="muted post__author">{{p.showAuthor}} · {{p.time}}</text>
      <text class="muted post__stat">点开可以看看，也可以补充举报</text>
    </view>
  </view>
</view>
