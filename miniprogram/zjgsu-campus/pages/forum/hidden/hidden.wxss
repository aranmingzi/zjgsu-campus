.tip-card {
  background: #fff8e6;
  border: 2rpx solid #ffe1a6;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
}
.tip-title {
  color: #8a6310;
  font-size: 27rpx;
  font-weight: 600;
}
.tip-body {
  color: #9c7430;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 8rpx;
}

.lock-badge {
  font-size: 21rpx;
  color: #b08a3e;
  background: #fdefd2;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.lock-badge {
  margin-left: auto;
}
.post-content {
  color: #555;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.post-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.stat {
  font-size: 22rpx;
}
