.label {
  font-weight: 600;
  margin-bottom: 18rpx;
}
.label-sub {
  font-weight: 400;
  font-size: 24rpx;
  color: #9aa0a6;
  margin-left: 14rpx;
}
.board-grid {
  display: flex;
  flex-wrap: wrap;
}
/* 帖子形式两选一：做成并排的两张卡，比一排小按钮好点，
   因为「只发主题」到底什么是主题，光看按钮说不清楚 */
.kind-row {
  display: flex;
  gap: 20rpx;
}
.kind-item {
  flex: 1;
  border: 2rpx solid #e6e9ee;
  border-radius: 14rpx;
  padding: 20rpx 16rpx;
  background: #fff;
}
.kind-item.on {
  border-color: #2f7de1;
  background: #f2f7ff;
}
.kind-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.kind-item.on .kind-name {
  color: #2f7de1;
}
.kind-sub {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.5;
}
/* 「这个主题不需要正文」的说明框：正文区被换成这块，得让同学一眼明白
   为什么这里没有输入框 —— 空白最容易让人以为页面坏了 */
.topic-box {
  background: #f7f9fc;
  border: 2rpx dashed #c8d4e6;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  margin-top: 8rpx;
}
.topic-line {
  font-size: 25rpx;
  line-height: 1.7;
  color: #55606e;
}
.topic-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #1a5fb4;
  background: #f0f5fc;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}
/* 「这个板块可以留联系方式」的说明：不写明没人敢贴群号，板块就白开了 */
.contact-ok {
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #1f7a4d;
  background: #eefaf3;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}
.board-chip {
  font-size: 26rpx;
  color: #5a6068;
  background: #f0f1f3;
  border-radius: 12rpx;
  padding: 16rpx 30rpx;
  margin: 0 18rpx 18rpx 0;
}
.board-chip.on {
  color: #1a5fb4;
  background: #eef3fb;
  font-weight: 600;
}
.field {
  font-size: 30rpx;
  /* 定高修复：input 只给 padding 不给高度会截字 */
  height: 88rpx;
  padding: 0;
}
.textarea {
  width: 100%;
  height: 280rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.counter {
  text-align: right;
  color: #b0b6be;
  font-size: 22rpx;
}
.draft-btn {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
.picked-course {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #eef3fb;
  color: #1a5fb4;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
}
.clear-course {
  font-size: 26rpx;
  color: #5a6068;
}
.course-pick {
  margin-top: 12rpx;
  max-height: 380rpx;
  overflow-y: auto;
}
.course-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid #f0f1f3;
}
.course-item:last-child {
  border-bottom: none;
}
.ci-name {
  font-size: 28rpx;
}
.ci-college {
  font-size: 23rpx;
}
.ci-none {
  margin-top: 12rpx;
  line-height: 1.7;
}
.btn-primary {
  margin-top: 12rpx;
}
.img-grid {
  display: flex;
  flex-wrap: wrap;
}
.img-cell {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f0f1f3;
}
.img-cell.add {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa0a6;
  font-size: 56rpx;
  background: #f7f8fa;
  border: 2rpx dashed #d9dde3;
}
.img-preview {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  font-size: 30rpx;
  border-bottom-left-radius: 12rpx;
}

/* 匿名发布开关（树洞） */
.anon-card {
  padding: 24rpx 28rpx;
}
.anon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.anon-left {
  display: flex;
  align-items: center;
}
.anon-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}
.anon-title {
  font-size: 28rpx;
  color: #1f2329;
}
.anon-sub {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.switch {
  width: 84rpx;
  height: 46rpx;
  border-radius: 46rpx;
  background: #d9dde3;
  position: relative;
  transition: background 0.2s;
}
.switch.on {
  background: #1a5fb4;
}
.switch-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #fff;
  transition: left 0.2s;
}
.switch.on .switch-dot {
  left: 42rpx;
}
.anon-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #1a5fb4;
  background: #f0f5fc;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
}
