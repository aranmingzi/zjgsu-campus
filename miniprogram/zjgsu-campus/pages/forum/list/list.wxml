<!-- pages/forum/list/list.wxml —— 论坛信息流（tab 页，用原生导航条） -->
<view class="container">
  <view wx:if="{{offline}}" class="net-bar">当前处于离线状态，下面显示的是本地缓存</view>


  <view wx:if="{{loading}}" class="sk-wrap">
    <view class="sk-card">
      <view class="sk-line sk-title"></view>
      <view class="sk-line sk-mid"></view>
      <view class="sk-line sk-short"></view>
    </view>
    <view class="sk-card">
      <view class="sk-line sk-title"></view>
      <view class="sk-line sk-short"></view>
    </view>
  </view>

  <block wx:else>
  <!-- 搜索：图标一律用线性 outline，不用功能类 emoji -->
  <view class="search-bar">
    <view class="search-box">
      <image class="search-box__icon" src="/assets/icons/search--faint.svg" mode="aspectFit" />
      <input class="search-box__input" placeholder="搜标题 / 内容 / 作者" value="{{keyword}}"
        confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
      <view wx:if="{{keyword}}" class="search-box__clear pressable" catchtap="onClearSearch">
        <image class="search-box__clear-icon" src="/assets/icons/x--muted.svg" mode="aspectFit" />
      </view>
    </view>
    <view wx:if="{{keyword}}" class="search-box__go pressable" catchtap="onSearchConfirm">搜索</view>
  </view>

  <view wx:if="{{!searching}}" class="search-panel">
    <view wx:if="{{searchHistory.length}}" class="panel-row">
      <text class="panel-label">最近搜索</text>
      <text class="panel-more tap" catchtap="onClearHistory">清空</text>
    </view>
    <view wx:if="{{searchHistory.length}}" class="filters">
      <view wx:for="{{searchHistory}}" wx:key="*this" class="chip tap" data-k="{{item}}" catchtap="onTapHistory">{{item}}</view>
    </view>
    <view class="panel-row panel-row--topic">
      <text class="panel-label">热门话题</text>
      <text class="panel-more">大家都在讨论</text>
    </view>
    <view class="filters">
      <view wx:for="{{hotKeywords}}" wx:key="*this" class="topic-pill tap" data-k="{{item}}" catchtap="onTapHistory"># {{item}}</view>
      <view wx:if="{{!hotKeywords.length}}" class="topic-pill topic-pill--empty"># 还没有人带起话题</view>
    </view>
  </view>

  <view wx:if="{{searching}}" class="result-bar">
    <text class="result-text">「{{keyword}}」找到 {{resultCount}} 条</text>
    <text class="result-reset tap" catchtap="onClearSearch">退出搜索</text>
  </view>

  <!-- 板块筛选：沿用 .chip（onBoard 仍读 dataset.b，这里不额外接一层事件） -->
  <scroll-view wx:if="{{!searching}}" class="filters" scroll-x="true">
    <view wx:for="{{boards}}" wx:key="*this" class="chip {{board === item ? 'chip-on' : ''}} tap" data-b="{{item}}" bindtap="onBoard">{{item}}</view>
  </scroll-view>

  <!-- 树洞独立入口：匿名内容只在树洞页出现，主论坛不混排 -->
  <view class="hole-entry-wrap">
    <treehole-entry iconVariant="night-light" bindtap="goHole" />
  </view>

  <!-- 校园盲盒 / 漂流瓶入口 -->
  <view wx:if="{{!searching}}" class="bb-entry tap" bindtap="goBlindbox">
    <view class="bb-entry__icon">
      <image class="bb-entry__icon-img" src="/assets/icons/gift--white.svg" mode="aspectFit" />
    </view>
    <view class="bb-entry__main">
      <view class="bb-entry__title">校园盲盒 · 漂流瓶</view>
      <view class="bb-entry__sub">捞一个同学的匿名心里话，每天 3 次</view>
    </view>
    <image class="bb-entry__go" src="/assets/icons/chevron-right--white.svg" mode="aspectFit" />
  </view>

  <!-- 被举报暂停展示的内容：留一个能补举报的口子 -->
  <view wx:if="{{!searching && hiddenCount > 0}}" class="muted-entry tap" bindtap="goHidden">
    <view class="muted-entry__icon">
      <image class="muted-entry__icon-img" src="/assets/icons/lock--market.svg" mode="aspectFit" />
    </view>
    <view class="muted-entry__main">
      <view class="muted-entry__title">有 {{hiddenCount}} 条内容因举报暂停展示</view>
      <view class="muted-entry__sub">觉得处理错了可以申诉，新收到的举报也会继续记录</view>
    </view>
    <image class="muted-entry__go" src="/assets/icons/chevron-right--market.svg" mode="aspectFit" />
  </view>

  <!-- 排序：最新 / 热门 / 最多赞 / 最多踩 / 最多留言 -->
  <view wx:if="{{!searching}}" class="sort-seg">
    <view class="segmented">
      <view wx:for="{{sortOptions}}" wx:key="k"
            class="segmented-item {{sort === item.k ? 'segmented-item-on' : ''}} tap"
            data-s="{{item.k}}" bindtap="onSortPick">
        <image class="sort-seg__icon" src="{{item.k === 'latest' ? '/assets/icons/clock--muted.svg' : (item.k === 'hot' ? '/assets/icons/flame--brand.svg' : (item.k === 'likes' ? '/assets/icons/thumbs-up--brand600.svg' : (item.k === 'dislikes' ? '/assets/icons/thumbs-down--muted.svg' : '/assets/icons/message-circle--muted.svg')))}}" mode="aspectFit" />
        <text class="sort-seg__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!searching && isCourseBoard && courseFilter.length}}" class="filters course-filter">
    <view class="chip {{courseId === '' ? 'chip-on' : ''}} tap" data-c="" bindtap="onCourseFilter">全部课程</view>
    <view wx:for="{{courseFilter}}" wx:key="courseId" class="chip {{courseId === item.courseId ? 'chip-on' : ''}} tap" data-c="{{item.courseId}}" bindtap="onCourseFilter">{{item.courseName}} · {{item.count}}</view>
  </view>

  <view wx:if="{{posts.length === 0 && !searched}}" class="empty">{{courseId ? '这门课还没有讨论，来发第一条吧～' : '这个板块还没有帖子，去发一条吧～'}}</view>
  <view wx:if="{{searched && posts.length === 0}}" class="empty">没有找到相关帖子，换个词或者删掉几个字再试试～</view>

  <!-- 卡片入场：只淡入，不动 transform（.container 上有 transform 会废掉 .fab 的固定定位） -->
  <view
    wx:for="{{posts}}"
    wx:key="id"
    wx:for-item="p"
    wx:for-index="i"
    class="card post post-in"
    style="animation-delay: {{(i % 10) * 30}}ms"
    data-id="{{p.id}}"
    bindtap="goDetail"
  >
    <view class="post__head">
      <view wx:if="{{p.pinned}}" class="post__pin">置顶</view>
      <view class="tag tag--forum post__board">{{p.board}}</view>
      <!-- 信息墙标记：正文区是空的，不打这个标，列表里看着就像条没写完的帖 -->
      <view wx:if="{{p.kind === 'topic'}}" class="tag tag--campus post__topic">
        <image class="post__mini-icon" src="/assets/icons/list-checks--campus.svg" mode="aspectFit" />
        <text>信息墙</text>
      </view>
      <!-- 热榜前三给个序号：从众效应，大家更愿意点「排第一的那条」 -->
      <view wx:if="{{sort === 'hot' && i < 3}}" class="post__rank post__rank--{{i + 1}}">{{i + 1}}</view>
      <view wx:elif="{{sort === 'hot'}}" class="post__score">
        <image class="post__mini-icon" src="/assets/icons/flame--market.svg" mode="aspectFit" />
        <text>{{p.hotScore}}</text>
      </view>
      <view wx:if="{{p.anonymous}}" class="tag tag--gray post__anon">
        <image class="post__mini-icon" src="/assets/icons/eye-off--muted.svg" mode="aspectFit" />
        <text>匿名</text>
      </view>
      <text class="post__time">{{p.time}}</text>
    </view>

    <view wx:if="{{p.courseName}}" class="post__course tap" data-id="{{p.courseId}}" catchtap="goCourse">
      <image class="post__mini-icon" src="/assets/icons/book-open--brand.svg" mode="aspectFit" />
      <text class="post__course-text">{{p.courseName}}</text>
      <image class="post__course-go" src="/assets/icons/chevron-right--brand.svg" mode="aspectFit" />
    </view>

    <view class="title-md post__title">
      <block wx:if="{{p.titleParts}}">
        <text wx:for="{{p.titleParts}}" wx:key="idx" wx:for-item="sp" class="{{sp.hit ? 'search-hit' : ''}}">{{sp.t}}</text>
      </block>
      <text wx:else>{{p.title}}</text>
    </view>
    <!-- 信息墙没有正文，补一句「信息收在评论区」，顺带告诉他去哪儿看 -->
    <view wx:if="{{p.kind === 'topic'}}" class="post__content post__content--hint">只有主题，信息收在评论区</view>
    <view wx:else class="post__content">
      <block wx:if="{{p.contentParts}}">
        <text wx:for="{{p.contentParts}}" wx:key="idx" wx:for-item="cp" class="{{cp.hit ? 'search-hit' : ''}}">{{cp.t}}</text>
      </block>
      <text wx:else>{{p.content}}</text>
    </view>

    <view wx:if="{{p.images.length}}" class="post__images">
      <image wx:for="{{p.images}}" wx:for-item="img" wx:key="*this" class="post__img tap" src="{{img}}" mode="aspectFill" data-imgs="{{p.images}}" catchtap="previewImages"></image>
    </view>

    <view class="post__foot">
      <text class="muted post__author">{{p.showAuthor}}</text>
      <view class="post__actions">
        <view class="post__act {{p.liked ? 'post__act--on' : ''}} tap" data-id="{{p.id}}" data-v="like" catchtap="onPostVote">
          <image class="post__act-icon" src="{{p.liked ? '/assets/icons/thumbs-up--brand600.svg' : '/assets/icons/thumbs-up--muted.svg'}}" mode="aspectFit" />
          <text>{{p.likes}}</text>
        </view>
        <view class="post__act {{p.disliked ? 'post__act--no' : ''}} tap" data-id="{{p.id}}" data-v="dislike" catchtap="onPostVote">
          <image class="post__act-icon" src="{{p.disliked ? '/assets/icons/thumbs-down--brand600.svg' : '/assets/icons/thumbs-down--muted.svg'}}" mode="aspectFit" />
          <text>{{p.dislikes}}</text>
        </view>
        <view class="post__act tap" data-id="{{p.id}}" catchtap="goDetail">
          <image class="post__act-icon" src="/assets/icons/message-circle--muted.svg" mode="aspectFit" />
          <text>{{p.comments.length}}</text>
        </view>
        <view class="post__act post__act--text {{p.reported ? 'post__act--done' : ''}} tap"
              data-id="{{p.id}}" data-openid="{{p.authorOpenid}}"
              catchtap="onReportPost">{{p.reported ? '已举报' : '举报'}}</view>
        <button class="post__share tap" open-type="share" catchtap="onSharePost" data-id="{{p.id}}">
          <image class="post__act-icon" src="/assets/icons/share-2--muted.svg" mode="aspectFit" />
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{posts.length && !noMore}}" class="load-more">加载中…</view>
  <view wx:elif="{{posts.length && noMore}}" class="load-more">已经到底啦，没有更多了</view>
  </block>

  <view class="fab tap" bindtap="goPost">
    <image class="fab__icon" src="/assets/icons/plus--white.svg" mode="aspectFit" />
  </view>
</view>
