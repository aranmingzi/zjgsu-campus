/* pages/forum/list/list.wxss —— 论坛信息流（tab 页，用原生导航条）
   只写本页面专用的语义类；通用令牌全部走 app.wxss。 */

/* --------------------------------------------------------------------------
   顶部 Banner（utils/banner.wxml 被 include 到这里，样式跟着本页走）
   -------------------------------------------------------------------------- */
.top-banner {
  height: 168rpx;
  margin-bottom: 20rpx;
  border-radius: 32rpx;
  overflow: hidden;
}
.top-banner-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 168rpx;
  padding: 28rpx 32rpx;
  color: #ffffff;
  background: linear-gradient(120deg, #2b5aed 0%, #7357ff 100%);
}
/* banner.wxml 现在渲染的是线性 outline 图标（utils/banner.js 给出图标名），
   渐变底上直接放白色图标，不再套一块半透明底板。 */
.top-banner-icon {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
}
.top-banner-main { flex: 1; min-width: 0; }
.top-banner-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  display: inline-block;
}
.top-banner-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.top-banner-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.top-banner-go {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  opacity: 0.75;
}
.top-banner-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.top-banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #dfe5ef;
}
.top-banner-dot.on { width: 28rpx; background: #7357ff; }

/* --------------------------------------------------------------------------
   搜索
   -------------------------------------------------------------------------- */
.search-bar { margin-bottom: 20rpx; }
.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 8rpx 0 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.search-box__icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.search-box__input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
  color: #172033;
}
.search-box__clear {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.search-box__clear-icon { width: 32rpx; height: 32rpx; }
.search-box__go {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2047c9;
}

.search-panel { margin-bottom: 8rpx; }
.panel-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.panel-row--topic { margin-top: 12rpx; }
.panel-label { font-size: 24rpx; color: #6f7b91; font-weight: 600; }
.panel-more { font-size: 24rpx; color: #98a3b8; }
.search-panel .filters { margin-bottom: 4rpx; }
/* 热门话题胶囊：论坛紫，和树洞入口同色系，扫一眼就知道这是论坛的内容 */
.topic-pill {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #7357ff;
  background: #f1edff;
}
.topic-pill--empty { color: #98a3b8; background: #f6f8fb; }

.result-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.result-text { font-size: 26rpx; color: #6f7b91; }
.result-reset { font-size: 26rpx; color: #2047c9; }

/* --------------------------------------------------------------------------
   筛选 / 排序
   -------------------------------------------------------------------------- */
.filters { white-space: nowrap; margin-bottom: 20rpx; }
.filters .chip { margin-bottom: 8rpx; }
.course-filter { margin-bottom: 16rpx; }

.sort-seg { margin-bottom: 20rpx; }
.sort-seg .segmented {
  display: flex;
  background: #eef1f6;
  border-radius: 999rpx;
  padding: 6rpx;
}
.sort-seg .segmented-item {
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
  min-height: 88rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #6f7b91;
  line-height: 1.2;
}
.sort-seg .segmented-item-on { font-weight: 600; }
.sort-seg__icon { width: 30rpx; height: 30rpx; }
.sort-seg__label { max-width: 100%; overflow: hidden; white-space: nowrap; }

/* --------------------------------------------------------------------------
   帖子卡
   -------------------------------------------------------------------------- */
@keyframes postIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
/* 只淡入，不动 transform：.container 有 transform 会让 .fab 掉出固定定位 */
.post-in { animation: postIn 0.28s ease-out both; }

.post__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 44rpx;
  margin-bottom: 12rpx;
}
.post__pin {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  background: #dd4b55;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.post__board { flex-shrink: 0; }
.post__topic,
.post__anon { flex-shrink: 0; }
.post__mini-icon { width: 24rpx; height: 24rpx; }
.post__rank {
  flex-shrink: 0;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  text-align: center;
  line-height: 36rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: #c0c6cc;
}
.post__rank--1 { background: #e64340; }
.post__rank--2 { background: #f0882e; }
.post__rank--3 { background: #f5b400; }
.post__score {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #d9731f;
  background: #fff3e9;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.post__time {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #98a3b8;
}

.post__course {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: #eff4ff;
  color: #2047c9;
  font-size: 24rpx;
}
.post__course-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.post__course-go { width: 26rpx; height: 26rpx; flex-shrink: 0; }

.post__title { margin-bottom: 8rpx; }
.post__content {
  color: #47536b;
  font-size: 26rpx;
  line-height: 1.65;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.post__content--hint { color: #98a3b8; }

.search-hit { color: #dd4b55; font-weight: 600; }

.post__images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 4rpx;
}
.post__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: #eff1f6;
}

.post__foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #e8edf5;
}
/* 左边作者：太长截断，不许折行顶开右边操作区 */
.post__author {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #6f7b91;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 右边操作：整体右推，320 宽度下也不跟作者名重叠 */
.post__actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.post__act {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 88rpx;
  padding: 0 4rpx;
  font-size: 24rpx;
  color: #6f7b91;
}
.post__act-icon { width: 30rpx; height: 30rpx; }
.post__act--on { color: #2047c9; font-weight: 600; }
.post__act--on .post__act-icon { width: 32rpx; height: 32rpx; }
.post__act--no { color: #128a56; font-weight: 600; }
.post__act--done { color: #98a3b8; }
.post__act--text { padding: 0 4rpx; font-size: 24rpx; }
/* 微信 button 默认灰底边框，这里改成纯图标热区 */
.post__share {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
}
.post__share::after { border: none; }

.load-more {
  text-align: center;
  color: #b0b6be;
  font-size: 24rpx;
  padding: 24rpx 0 30rpx;
}

/* --------------------------------------------------------------------------
   断网提示
   -------------------------------------------------------------------------- */
.net-bar {
  background: #fff3e9;
  color: #d9731f;
  font-size: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

/* --------------------------------------------------------------------------
   首屏骨架屏
   -------------------------------------------------------------------------- */
.sk-wrap { margin-top: 8rpx; }
.sk-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.sk-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f0f1f3 25%, #e6e8eb 37%, #f0f1f3 63%);
  background-size: 400% 100%;
  animation: sk 1.2s ease-in-out infinite;
  margin-bottom: 16rpx;
}
.sk-title { width: 55%; height: 30rpx; }
.sk-short { width: 35%; }
.sk-mid { width: 80%; margin-bottom: 0; }
@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* --------------------------------------------------------------------------
   树洞入口（组件 treehole-entry 自带紫色渐变，这里只补间距）
   -------------------------------------------------------------------------- */
.hole-entry-wrap { margin-bottom: 24rpx; }

/* 校园盲盒：和树洞并排，海青色区分，两张卡挨着也不会被看成同一件事 */
.bb-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #0e7c86 0%, #2fa8b5 100%);
  box-shadow: 0 8rpx 24rpx rgba(14, 124, 134, 0.22);
}
.bb-entry__icon {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
}
.bb-entry__icon-img { width: 52rpx; height: 52rpx; }
.bb-entry__main { flex: 1; min-width: 0; }
.bb-entry__title { font-size: 30rpx; font-weight: 700; color: #ffffff; }
.bb-entry__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bb-entry__go { flex-shrink: 0; width: 36rpx; height: 36rpx; }

/* 被举报暂停展示：低调的入口，别和内容抢注意力 */
.muted-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: #fff3e9;
  border: 2rpx solid #ffe1a6;
}
.muted-entry__icon {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
}
.muted-entry__icon-img { width: 40rpx; height: 40rpx; }
.muted-entry__main { flex: 1; min-width: 0; }
.muted-entry__title { font-size: 26rpx; font-weight: 600; color: #a86a1c; }
.muted-entry__sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #b08a3e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.muted-entry__go { flex-shrink: 0; width: 32rpx; height: 32rpx; }

/* --------------------------------------------------------------------------
   悬浮发帖按钮
   -------------------------------------------------------------------------- */
.fab {
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #7357ff;
  box-shadow: 0 12rpx 32rpx rgba(115, 87, 255, 0.34);
}
.fab__icon { width: 48rpx; height: 48rpx; }
