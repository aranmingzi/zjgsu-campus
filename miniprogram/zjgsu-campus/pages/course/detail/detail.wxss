/* pages/course/detail —— 课程决策页。
   类名一律 dp-*；app.wxss 里已有的 .card / .title-lg / .muted / .tag 直接复用。 */

.dp-page {
  padding-bottom: 200rpx; /* 给固定底栏的「写评价」留位 */
}

/* ---------- 决策卡 ---------- */
.dp-decision {
  padding-bottom: 24rpx;
}
.dp-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

/* 课程类型行：类型标签 + 纠错链接，纠错不该抢主按钮的戏 */
.dp-ctype {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.dp-ctype-badge {
  font-size: 20rpx;
  color: #2047c9;
  background: #eff4ff;
  border-radius: 8rpx;
  padding: 6rpx 18rpx;
}
.dp-ctype-edit {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #6f7b91;
}
.dp-builtin {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #2047c9;
  background: #eff4ff;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.dp-score {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  flex-wrap: wrap;
}
.dp-score-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #d98c0b;
  line-height: 1.1;
  margin-right: 18rpx;
}
.dp-stars {
  display: flex;
  align-items: center;
  min-width: 0;
}
.dp-star-icon {
  font-size: 28rpx;
  color: #e0e5ee;
  margin-right: 2rpx;
}
.dp-star-icon { width: 28rpx; height: 28rpx; }
.dp-score-count {
  margin-left: 16rpx;
  font-size: 24rpx;
}

/* 评分分布：5 行细条，宽度用百分比，不用任何浏览器专属函数 */
.dp-dist {
  margin-top: 20rpx;
}
.dp-dist-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.dp-dist-star {
  width: 68rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #6f7b91;
}
.dp-dist-bar {
  flex: 1;
  height: 14rpx;
  min-width: 0;
  background: #f0f1f3;
  border-radius: 999rpx;
  overflow: hidden;
}
.dp-dist-fill {
  height: 100%;
  background: #d98c0b;
  border-radius: 999rpx;
}
.dp-dist-count {
  width: 48rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 22rpx;
  color: #98a3b8;
}

/* 标签热度 */
.dp-heat {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.dp-heat-item {
  font-size: 24rpx;
  color: #6f7b91;
  background: #f6f8fb;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}
.dp-heat-item--top {
  color: #2047c9;
  background: #eff4ff;
  font-weight: 600;
}

.dp-summary {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f2f6fd;
  color: #2b5aed;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 课程大纲：默认收起 */
.dp-outline {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f6f8fb;
}
.dp-outline-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dp-outline-arrow { font-size: 24rpx; }
.dp-outline-body {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #4b5159;
  line-height: 1.75;
}

/* 收藏 / 删除 / 申请删除：胶囊热区 88rpx，删除用红底以示破坏性 */
.dp-acts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.dp-act {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #eff4ff;
  color: #2047c9;
  font-size: 26rpx;
  font-weight: 600;
}
.dp-act-on {
  color: #128a56;
  background: #e9f8f1;
}
.dp-act-danger {
  color: #dd4b55;
  background: #fff0f1;
}
.dp-act-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}
.dp-act-sub {
  margin-left: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
}
.dp-req-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.7;
}

/* ---------- 分段 ---------- */
.dp-tabs {
  margin: 8rpx 0 20rpx;
}

/* ---------- 老师档 ---------- */
.dp-tch {
  display: flex;
  align-items: center;
}
.dp-tch-left {
  flex: 1;
  min-width: 0;
}
.dp-tch-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dp-tch-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
}
.dp-tch-verified {
  display: inline-flex;
  align-items: center;
  margin-right: 8rpx;
  color: #128a56;
}
.dp-tch-check {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}
.dp-tch-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
}
/* 320 宽度下给左边的姓名留出空间：右栏只按内容宽，不抢 */
.dp-tch-right {
  flex-shrink: 0;
  max-width: 220rpx;
  margin-left: 16rpx;
  text-align: right;
}
.dp-tch-stars {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 40rpx;
}
.dp-star-none {
  font-size: 22rpx;
  color: #98a3b8;
}
.dp-tch-scores {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}
.dp-tch-score {
  font-size: 26rpx;
  color: #d98c0b;
}
.dp-tch-score--muted { color: #6f7b91; }
.dp-tip {
  margin-top: 4rpx;
  font-size: 24rpx;
}

/* ---------- 评价列表 ---------- */
.dp-empty {
  padding: 48rpx 32rpx;
  text-align: center;
}
.dp-empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
}
.dp-empty .empty-desc {
  margin-top: 8rpx;
}

.dp-review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.dp-review-name {
  font-size: 28rpx;
  font-weight: 600;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dp-review-badge {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #2047c9;
  background: #eff4ff;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.dp-review-op {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.dp-review-time { font-size: 22rpx; }
.dp-op {
  margin-left: 24rpx;
  font-size: 24rpx;
  color: #2b5aed;
}
.dp-op-danger { color: #dd4b55; }

.dp-review-score {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #d98c0b;
}
.dp-review-content {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #172033;
  line-height: 1.7;
}
.dp-review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.dp-more {
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #2b5aed;
}

/* ---------- 固定底栏 ---------- */
.dp-bar {
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 2rpx solid #e8edf5;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

/* ---------- 「这门课找不到了」兜底 ---------- */
.dp-nf {
  text-align: center;
  padding: 56rpx 36rpx 48rpx;
}
.dp-nf-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: #f6f8fb;
}
.dp-nf-icon image { width: 56rpx; height: 56rpx; }
.dp-nf-title { font-size: 34rpx; }
.dp-nf-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
}
.dp-nf-acts {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-top: 32rpx;
}
.dp-nf-hint {
  margin-top: 24rpx;
  font-size: 22rpx;
  line-height: 1.7;
}
