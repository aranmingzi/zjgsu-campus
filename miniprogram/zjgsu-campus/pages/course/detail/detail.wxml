<!-- pages/course/detail/detail.wxml
     这一页对查课的同学是「决策页」：顶部先给结论（综合分 / 评分分布 / 大家都在说 /
     一句话判断），下面才是原始评价。结构和原来一致，只把配色、圆角、热区换成新设计系统。 -->
<app-header title="{{navTitle}}" showBack />

<view class="container dp-page" wx:if="{{course}}">
  <view class="card dp-decision">
    <view class="title-lg">{{course.name}}</view>
    <view class="muted dp-meta">{{course.college}} · {{course.major}} · {{course.credit}} 学分</view>

    <!-- 课程类型 + 纠错入口：类型是按课名猜的，猜错难免，给个当场改掉的口子 -->
    <view class="dp-ctype">
      <text class="dp-ctype-badge">{{course.ctype || '专业必修'}}</text>
      <text class="dp-ctype-edit tap" bindtap="onEditType">类型不对？改一下</text>
    </view>
    <view wx:if="{{course.builtin === false}}" class="dp-builtin">同学共建课程</view>

    <view class="dp-score">
      <text class="dp-score-num">{{course.avgScore}}</text>
      <view class="dp-stars">
        <image wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="dp-star-icon" src="/assets/icons/star--{{s <= course.starOn ? 'amber' : 'faint'}}.svg" mode="aspectFit" />
      </view>
      <text class="muted dp-score-count">{{course.reviewCount}} 人评价</text>
    </view>

    <!-- 评分分布：一眼看出「是不是普遍好评」 -->
    <view wx:if="{{course.reviewCount}}" class="dp-dist">
      <view wx:for="{{course.dist}}" wx:key="star" class="dp-dist-row">
        <text class="dp-dist-star">{{item.star}}星</text>
        <view class="dp-dist-bar">
          <view class="dp-dist-fill" style="width: {{item.count / course.reviewCount * 100}}%"></view>
        </view>
        <text class="dp-dist-count">{{item.count}}</text>
      </view>
    </view>

    <view wx:if="{{course.tags.length}}" class="dp-heat">
      <text
        wx:for="{{course.tags}}"
        wx:key="name"
        class="dp-heat-item {{index === 0 ? 'dp-heat-item--top' : ''}} tap"
        data-t="{{item.name}}"
        bindtap="onTag"
      >{{item.name}} · {{item.count}}</text>
    </view>

    <view wx:if="{{course.summary}}" class="dp-summary">{{course.summary}}</view>

    <!-- 课程大纲：默认收起，多数人是来看评分的 -->
    <view class="dp-outline tap" bindtap="toggleOutline">
      <view class="dp-outline-head">
        <text class="title-sm">课程大纲</text>
        <text class="muted dp-outline-arrow">{{outlineOpen ? '收起' : '展开'}} ›</text>
      </view>
      <view wx:if="{{outlineOpen}}" class="dp-outline-body">{{course.description}}</view>
    </view>

    <view class="dp-acts">
      <view class="dp-act {{favorited ? 'dp-act-on' : ''}} tap" bindtap="onFavorite">
        <image class="dp-act-icon" src="{{favorited ? '/assets/icons/star--campus.svg' : '/assets/icons/star--faint.svg'}}" mode="aspectFit" />
        {{favorited ? '已收藏' : '收藏这门课'}}
      </view>
      <view wx:if="{{isMineCourse}}" class="dp-act dp-act-danger tap" bindtap="onRemoveCourse">
        <image class="dp-act-icon" src="/assets/icons/trash-2--danger.svg" mode="aspectFit" />
        删除这门课
      </view>
      <!-- 别人误加的课：加课人不管了，这门课就永远删不掉，给一条申请通道 -->
      <view
        wx:elif="{{course.builtin === false}}"
        class="dp-act dp-act-danger tap"
        bindtap="onRequestRemove"
      >{{reqMine ? '已申请删除' : '申请删除这门课'}}<text wx:if="{{reqVotes}}" class="dp-act-sub">（{{reqVotes}}/{{reqNeed}} 人同意）</text></view>
    </view>
    <view wx:if="{{course.builtin === false && !isMineCourse && !reqMine}}" class="muted dp-req-hint">
      这门课是别的同学加的，你删不掉。如果它确实是误加的（名字重复、根本不存在），
      可以申请删除：凑够 {{reqNeed}} 人同意、或者审核员出手，就会清掉。
    </view>
    <view wx:if="{{reqMine}}" class="muted dp-req-hint">
      你已申请删除，正在等其他人同意（{{reqVotes}}/{{reqNeed}}）。审核员也可以直接删掉。
    </view>
  </view>

  <!-- 课程评价 / 老师评价 两个分段 -->
  <view class="segmented dp-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="segmented-item {{tabMap[item.key] ? 'segmented-item-on' : ''}} tap"
      data-k="{{item.key}}"
      bindtap="onTab"
    >{{item.label}}<text wx:if="{{item.key === 'course'}}">（{{reviews.length}}）</text><text wx:elif="{{teacherCount}}">（{{teacherCount}}）</text></view>
  </view>

  <!-- ========== 按老师 ========== -->
  <block wx:if="{{tab === 'teacher'}}">
    <view wx:if="{{teacherGroups.length === 0}}" class="dp-empty">
      <image class="dp-empty-icon" src="/assets/icons/users-round--faint.svg" mode="aspectFit" />
      <view class="empty-title">还没有人点名评价过老师</view>
      <view class="empty-desc">写评价时填上任课老师，别人就能按老师查到你的评价</view>
    </view>

    <view wx:else>
      <view class="muted dp-tip">老师分和课程分是两档，点进去看细节</view>
      <view
        wx:for="{{teacherGroups}}"
        wx:key="name"
        class="card dp-tch pressable"
        data-name="{{item.name}}"
        bindtap="goTeacher"
      >
        <view class="dp-tch-left">
          <view class="title-sm dp-tch-name">{{item.name}}</view>
          <view class="muted dp-tch-meta">
            <text wx:if="{{item.verified}}" class="dp-tch-verified">
              <image class="dp-tch-check" src="/assets/icons/check--campus.svg" mode="aspectFit" />官方名录
            </text>
            <text wx:else>待补充</text>
            · {{item.count}} 条评价
          </view>
          <view wx:if="{{item.scoredCount}}" class="muted dp-tch-sub">其中 {{item.scoredCount}} 人单独打了老师分</view>
        </view>
        <view class="dp-tch-right">
          <view class="dp-tch-stars">
            <block wx:if="{{item.avg > 0}}">
              <image wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="dp-star-icon" src="/assets/icons/star--{{s <= item.avgRound ? 'amber' : 'faint'}}.svg" mode="aspectFit" />
            </block>
            <text wx:else class="dp-star-none">还没人打分</text>
          </view>
          <view class="dp-tch-scores">
            <text wx:if="{{item.avg > 0}}" class="dp-tch-score">老师 {{item.avg}}</text>
            <text wx:if="{{item.courseAvg > 0}}" class="dp-tch-score dp-tch-score--muted">课程 {{item.courseAvg}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ========== 课程整体 ========== -->
  <block wx:else>
    <view wx:if="{{reviews.length === 0}}" class="dp-empty">
      <image class="dp-empty-icon" src="/assets/icons/notebook-pen--faint.svg" mode="aspectFit" />
      <view class="empty-title">还没有评价，来做第一个吧～</view>
    </view>

    <view wx:for="{{reviews}}" wx:key="id" wx:for-item="rv" wx:if="{{expanded || index < 3}}" class="card">
      <view class="dp-review-head">
        <!-- 匿名评价只显示「匿名同学」；自己那条即使匿名也能认出是自己 -->
        <text class="dp-review-name">{{rv.showName}}<text wx:if="{{rv.isMine && rv.anonymous}}" class="dp-review-badge">我 · 匿名</text></text>
        <view class="dp-review-op">
          <text class="muted dp-review-time">{{rv.time}}</text>
          <text wx:if="{{rv.isMine}}" class="dp-op tap" data-id="{{rv.id}}" catchtap="goEdit">修改</text>
          <text wx:if="{{rv.isMine}}" class="dp-op dp-op-danger tap" data-id="{{rv.id}}" catchtap="onRemove">删除</text>
        </view>
      </view>
      <view class="dp-stars">
        <image wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="dp-star-icon" src="/assets/icons/star--{{s <= rv.starOn ? 'amber' : 'faint'}}.svg" mode="aspectFit" />
        <text class="dp-review-score">{{rv.score}}.0</text>
      </view>
      <view class="dp-review-content">{{rv.content}}</view>
      <view wx:if="{{rv.tags.length}}" class="dp-review-tags">
        <text wx:for="{{rv.tags}}" wx:key="*this" wx:for-item="t" class="tag tag--gray">{{t}}</text>
      </view>
    </view>

    <view wx:if="{{reviews.length > 3}}" class="dp-more tap" bindtap="toggleExpand">
      {{expanded ? '收起' : '展开全部 ' + reviews.length + ' 条'}}
    </view>
  </block>

  <view class="fixed-bar dp-bar">
    <base-button block bindtap="goReview">写评价</base-button>
  </view>
</view>

<!-- 找不到这门课时的兜底：绝不能留白屏。
     最可能的原因是这条数据是本机早期同步留下的坏数据（id 是空的），
     所以除了「重新同步」，还要给一个能把它清掉的出口。 -->
<view class="container dp-page" wx:else>
  <view class="card dp-nf">
    <view class="dp-nf-icon">
      <image src="/assets/icons/search--faint.svg" mode="aspectFit" />
    </view>
    <view class="title-lg dp-nf-title">这门课找不到了</view>
    <view class="muted dp-nf-desc">
      可能是课程数据还没同步全，也可能已经被其他同学删掉了。
    </view>
    <view class="dp-nf-acts">
      <view class="dp-act tap" bindtap="onRetryLoad">重新同步试试</view>
      <view class="dp-act dp-act-danger tap" bindtap="onDropBroken">清掉这条数据</view>
    </view>
    <view class="muted dp-nf-hint">
      「清掉这条数据」只影响你手机上这份缓存，其他同学照常能看到。
    </view>
  </view>
</view>
