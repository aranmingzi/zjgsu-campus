<!-- pages/course/list/list.wxml
     课程评价 / 老师评价 两个档位共用一套吸顶筛选：
     分段 → 搜索 → 学院 → 课程类型 → 排序档位。搜索框在吸顶区里，滑到哪都还在手上。
     课程档用 course-card（组件内自己判「暂无评分」），老师档还是原来那张两档分的卡片。 -->
<view>
  <sticky-filter>
    <view class="ls-filter">
      <!-- 分段控件：课程评价 / 老师评价 -->
      <view class="segmented">
        <view
          wx:for="{{scopes}}"
          wx:key="key"
          class="segmented-item {{scopeMap[item.key] ? 'segmented-item-on' : ''}} tap"
          data-s="{{item.key}}"
          bindtap="onScope"
        >{{item.label}}<text wx:if="{{item.key === 'teacher' && teacherCount}}" class="ls-seg-num">{{teacherCount}}</text></view>
      </view>

      <!-- 搜索：换档时 placeholder 跟着变，底下搜的东西完全两样 -->
      <view class="ls-search">
        <image class="ls-search-icon" src="/assets/icons/search--faint.svg" mode="aspectFit" />
        <input
          class="ls-search-input"
          placeholder="{{scope === 'teacher' ? '搜索老师姓名或学院' : '搜索课程名或专业'}}"
          value="{{keyword}}"
          bindinput="onSearch"
          confirm-type="search"
        />
        <view wx:if="{{hasKeyword}}" class="ls-clear tap" bindtap="onClear">
          <image class="ls-clear-icon" src="/assets/icons/x--muted.svg" mode="aspectFit" />
        </view>
      </view>

      <!-- 学院 + 课程类型只有课程档用得上：老师档筛的是人，学院写在人名下面 -->
      <block wx:if="{{scope === 'course'}}">
        <scroll-view class="no-scrollbar ls-scroll {{hasKeyword ? 'ls-dim' : ''}}" scroll-x="true">
          <view class="chip-row">
            <view wx:for="{{colleges}}" wx:key="*this" class="chip {{college === item ? 'chip-on' : ''}} tap" data-c="{{item}}" bindtap="onCollege">{{item}}</view>
          </view>
        </scroll-view>
        <!-- 课程类型二级分类：学院下面再挑一层「这门课是什么性质」 -->
        <scroll-view class="no-scrollbar ls-scroll {{hasKeyword ? 'ls-dim' : ''}}" scroll-x="true">
          <view class="chip-row">
            <view wx:for="{{ctypes}}" wx:key="*this" class="chip {{ctype === item ? 'chip-on' : ''}} {{item !== '全部' && ctypeCounts[item] === 0 ? 'chip-empty' : ''}} tap" data-t="{{item}}" bindtap="onCtype">
              {{item}}<text wx:if="{{item !== '全部'}}" class="ls-chip-num">{{ctypeCounts[item] || 0}}</text>
            </view>
          </view>
        </scroll-view>
        <view wx:if="{{hasKeyword}}" class="ls-dim-hint">搜索时不分学院和类型，这样才不会漏掉别的学院的课</view>
      </block>

      <!-- 条数 + 排序档位 -->
      <view class="ls-bar">
        <text class="ls-count">{{scope === 'teacher' ? '共 ' + total + ' 位老师' : '共 ' + total + ' 门'}}<text wx:if="{{fuzzyCount}}" class="ls-fuzzy">（{{fuzzyCount}} {{scope === 'teacher' ? '位' : '门'}}是模糊匹配到的）</text></text>
        <scroll-view class="no-scrollbar ls-sorts" scroll-x="true">
          <view class="ls-sort-row">
            <view
              wx:for="{{sortItems}}"
              wx:key="k"
              class="ls-sort {{sort === item.k ? 'ls-sort-on' : ''}} tap"
              data-s="{{item.k}}"
              bindtap="onSortPick"
            >{{item.label}}</view>
          </view>
        </scroll-view>
      </view>
    </view>
  </sticky-filter>

  <view class="container">
    <!-- ========== 老师档 ========== -->
    <block wx:if="{{scope === 'teacher'}}">
      <view
        wx:for="{{display}}"
        wx:key="name"
        class="card ls-tch pressable"
        data-name="{{item.name}}"
        bindtap="onTapItem"
      >
        <view class="ls-tch-left">
          <view class="title-sm ls-tch-name">{{item.name}}</view>
          <view class="ls-tch-meta">
            <text wx:if="{{item.verified}}" class="ls-tch-verified">
              <image class="ls-tch-check" src="/assets/icons/check--campus.svg" mode="aspectFit" />官方名录
            </text>
            <text wx:elif="{{item.count}}" class="ls-tch-pending">待补充</text>
            <text wx:if="{{item.count}}">· {{item.count}} 条评价</text>
            <text wx:elif="{{item.verified}}">· 还没有人评价</text>
          </view>
          <view wx:if="{{item.courseNames}}" class="muted ls-tch-sub">教过：{{item.courseNames}}<text wx:if="{{item.courseCount > 2}}"> 等 {{item.courseCount}} 门</text></view>
          <view wx:elif="{{item.scoredCount}}" class="muted ls-tch-sub">其中 {{item.scoredCount}} 人单独打了老师分</view>
        </view>
        <view class="ls-tch-right">
          <view class="ls-stars">
            <block wx:if="{{item.hasScore}}">
              <image wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="ls-star-icon" src="/assets/icons/star--{{s <= item.avgRound ? 'amber' : 'faint'}}.svg" mode="aspectFit" />
            </block>
            <text wx:else class="ls-star-none">还没人打分</text>
          </view>
          <view class="ls-tch-scores">
            <text wx:if="{{item.hasScore}}" class="ls-tch-score">老师 {{item.avg}}</text>
            <text wx:if="{{item.courseAvg > 0}}" class="ls-tch-score ls-tch-score--muted">课程 {{item.courseAvg}}</text>
          </view>
          <view wx:if="{{item.goodRate >= 0}}" class="ls-tch-good">好评率 {{item.goodRate}}%</view>
        </view>
      </view>
    </block>

    <!-- ========== 课程档 ========== -->
    <block wx:else>
      <course-card
        wx:for="{{display}}"
        wx:key="id"
        wx:for-item="course"
        courseName="{{course.name}}"
        score="{{course.avgScore}}"
        tags="{{course.tags}}"
        reviewsCount="{{course.reviewCount}}"
        college="{{course.college}}"
        major="{{course.major}}"
        credit="{{course.credit}}"
        goodRate="{{course.goodRate}}"
        to="/pages/course/detail/detail?id={{course.id}}"
      />
    </block>

    <!-- ========== 空状态：四种成因文案不一样，按钮也不一样 ========== -->
    <view wx:if="{{display.length === 0}}" class="ls-empty">
      <view wx:if="{{hasKeyword}}">
        <view wx:if="{{scope === 'teacher'}}">
          <view class="empty-title">没有叫「{{keyword}}」的老师</view>
          <view class="empty-desc">错字也找过了，确实没有。老师名是同学写评价时填的，你要是认识这位老师，在评价里写上名字就能建出来</view>
          <view class="ls-btn tap" data-s="course" bindtap="onScope">回到课程评价</view>
        </view>
        <view wx:else>
          <view class="empty-title">课程库里还没有「{{keyword}}」</view>
          <view class="empty-desc">错字也找过了，确实没有。这门课缺失？由同学添加后，全校都能看到并评价</view>
          <view class="ls-btn tap" bindtap="goAdd">＋ 添加这门课</view>
        </view>
      </view>
      <view wx:elif="{{scope === 'course' && ctype !== '全部'}}">
        <view class="empty-title">{{college === '全部' ? '课程库里暂时没有' : college + '暂时没有'}}「{{ctype}}」的课</view>
        <view class="empty-desc">官方课目录收录的是各专业核心课，体育课 / 思政课 / 通识课多半还没在里面。同学添加课程时可以自己选类型，加进来就会出现在这里</view>
        <view class="ls-btn tap" data-t="{{ctype}}" bindtap="goAdd">＋ 添加一门{{ctype}}</view>
      </view>
      <view wx:else>
        <view class="empty-title">{{scope === 'teacher' ? '还没有老师评价，写评价时填上老师名就有了' : '没有匹配的课程，换个关键词试试～'}}</view>
      </view>
    </view>

    <view wx:if="{{display.length === 0}}" class="ls-tail">没有更多了</view>
    <view wx:elif="{{hasMore}}" class="ls-tail">上滑加载更多…</view>

    <!-- 可信度提示：匿名展示这件事得说清楚，不然同学以为这是官方数据 -->
    <view class="card ls-trust">
      <view class="ls-trust-icon">
        <image src="/assets/icons/book-open--brand.svg" mode="aspectFit" />
      </view>
      <view class="ls-trust-main">
        <view class="title-sm">这些评价可信吗？</view>
        <view class="muted ls-trust-sub">课程评价默认匿名展示，评分和标签均由同学共建。</view>
      </view>
    </view>
  </view>
</view>
