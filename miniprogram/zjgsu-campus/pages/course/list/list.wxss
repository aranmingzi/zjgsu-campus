/* 课程评价 / 老师评价 分类：放在搜索框上面，因为「搜什么」比「怎么搜」更靠前。
   两个 chip 用分段控件的样子，一眼看出是一组单选，不是一个筛选条件 */
.scope-row {
  display: flex;
  background: #eceff4;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 18rpx;
}
.scope-chip {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #5a6068;
  padding: 14rpx 0;
  border-radius: 999rpx;
}
.scope-chip.on {
  background: #fff;
  color: #1a5fb4;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(26, 95, 180, .12);
}
.scope-num {
  font-size: 21rpx;
  color: #b0b6be;
  margin-left: 8rpx;
}
.scope-chip.on .scope-num { color: #1a5fb4; }

/* 老师档没有「按评分」排序，换成一句静态说明，不留一个按不动的按钮 */
.sort-hint { font-size: 23rpx; color: #b0b6be; }

/* 老师卡片：和课程卡片同款，但右边是两档分 */
.tch-card { display: flex; align-items: center; }
.tch-meta { font-size: 23rpx; margin-top: 6rpx; }
.tch-pending { color: #b0b6be; margin-right: 8rpx; }

/* 搜索条右下角的清除：搜索框留着一个字没法快速清掉的体验很差 */
.search-clear {
  font-size: 26rpx;
  color: #b0b6be;
  padding: 0 6rpx 0 14rpx;
}

/* 精准 / 模糊 切换 */
.mode-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.mode-chip {
  font-size: 24rpx;
  color: #6b7280;
  background: #fff;
  border: 1rpx solid #e6e9ee;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin-right: 14rpx;
}
.mode-chip.on {
  color: #fff;
  background: #1a5fb4;
  border-color: #1a5fb4;
  font-weight: 600;
}
.mode-hint {
  font-size: 21rpx;
  color: #b0b6be;
  margin-left: auto;
}

/* 有关键字时学院筛选不生效，视觉上也淡掉，免得同学以为筛了却没用 */
.filters-off { opacity: .45; }
.filter-off-hint {
  font-size: 21rpx;
  color: #b0b6be;
  margin: -8rpx 0 18rpx 6rpx;
}
.fuzzy-note { color: #b0b6be; }

.filters {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #5a6068;
}
.chip-on {
  background: #1a5fb4;
  color: #fff;
}
.bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 4rpx 4rpx 16rpx;
}
.sort {
  font-size: 26rpx;
  color: #5a6068;
  padding: 6rpx 8rpx;
}
.sort-on {
  color: #1a5fb4;
  font-weight: 600;
}
/* 排序四档（综合 / 评分 / 好评率 / 评论数）：一排小按钮，两个档位共用 */
.sort-group {
  display: flex;
  align-items: center;
}
/* 课程类型行：和学院 chip 同款，但描个浅边区分层级（学院是一级、类型是二级） */
.chip-type {
  border: 1rpx solid #e6e9ee;
}
/* 类型后面的门数：数字比文字轻，别抢了类型名的位置 */
.chip-num {
  font-size: 21rpx;
  color: #b0b6be;
  margin-left: 8rpx;
}
.chip-on .chip-num { color: rgba(255, 255, 255, .8); }
/* 这一档一门都没有：整个 chip 淡掉，点进去之前就该知道是空的 */
.chip-type.chip-empty {
  color: #b0b6be;
  background: #fafbfc;
}
.ctype-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #1a5fb4;
  background: #eef3fb;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
}
.good-rate { color: #1f9d55; }
.tch-good {
  font-size: 22rpx;
  color: #1f9d55;
  text-align: right;
  margin-top: 4rpx;
}
.course-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.score-badge {
  color: #ff9f1c;
  font-weight: 700;
  font-size: 36rpx;
}
.course-meta {
  margin: 10rpx 0 14rpx;
}
.stars {
  display: flex;
  align-items: center;
}
.score-num {
  margin-left: 14rpx;
}
.tag-row {
  margin-top: 6rpx;
}
.empty-sub {
  margin-top: 14rpx;
  line-height: 1.7;
}
.empty-btn {
  display: inline-block;
  margin-top: 26rpx;
}
.hot-tag {
  font-size: 22rpx;
  color: #8a6d3b;
  background: #fdf6e7;
  border-radius: 6rpx;
  padding: 6rpx 14rpx;
  margin-top: 10rpx;
}
.empty-tail {
  text-align: center;
  color: #9aa0a6;
  font-size: 24rpx;
  padding: 24rpx 0 40rpx;
}
