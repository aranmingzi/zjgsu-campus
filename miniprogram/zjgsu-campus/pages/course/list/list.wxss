/* pages/course/list —— 课程评价 / 老师评价 两个档位。
   吸顶筛选放在 <sticky-filter> 里（组件自带 position:sticky + 降级毛玻璃），
   页面主体仍然是普通文档流，靠 .container 的 24rpx 内边距留白。
   类名一律 ls-*，避免和 app.wxss 里已有的语义类重名。 */

/* ---------- 吸顶筛选区 ---------- */
.ls-filter {
  padding: 8rpx 24rpx 12rpx;
}

/* 分段控件里的老师人数 */
.ls-seg-num {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #98a3b8;
}
.segmented-item-on .ls-seg-num { color: #2b5aed; }

/* 搜索框：胶囊 + 白底 + 轻投影，和 .search-bar 同款但不重复定义它 */
.ls-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 28rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.ls-search-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}
.ls-search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #172033;
}
.ls-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: -8rpx;
  border-radius: 999rpx;
  background: #eef1f6;
  flex-shrink: 0;
}
.ls-clear-icon {
  width: 28rpx;
  height: 28rpx;
}

/* chip 行：横向滚动，热区 88rpx（app.wxss 的 .chip 已经给了） */
.ls-scroll { margin-top: 12rpx; }
.ls-dim { opacity: 0.45; }
.ls-dim-hint {
  margin: 2rpx 4rpx 0;
  font-size: 22rpx;
  color: #98a3b8;
}
.ls-chip-num {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #98a3b8;
}
.chip-on .ls-chip-num { color: rgba(255, 255, 255, 0.8); }
/* 某一类型一门都没有：.chip-empty（app.wxss）已经把整枚 chip 淡掉 */

/* 条数 + 排序档位 */
.ls-bar {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  gap: 16rpx;
}
.ls-count {
  font-size: 24rpx;
  color: #6f7b91;
  flex-shrink: 0;
  max-width: 340rpx;
}
.ls-fuzzy { color: #98a3b8; }
.ls-sorts { flex: 1; min-width: 0; }
.ls-sort-row { display: flex; align-items: center; }
.ls-sort {
  flex-shrink: 0;
  padding: 0 18rpx;
  font-size: 26rpx;
  color: #6f7b91;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
}
.ls-sort-on {
  color: #2b5aed;
  font-weight: 600;
  background: #eff4ff;
}

/* ---------- 老师档卡片 ---------- */
.ls-tch {
  display: flex;
  align-items: center;
}
.ls-tch-left {
  flex: 1;
  min-width: 0;
}
.ls-tch-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ls-tch-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6f7b91;
}
.ls-tch-verified {
  display: inline-flex;
  align-items: center;
  margin-right: 10rpx;
  color: #128a56;
}
.ls-tch-check {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}
.ls-tch-pending { margin-right: 10rpx; color: #98a3b8; }
.ls-tch-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 320 宽度下左栏只剩 216rpx：右栏不设最小宽度，超限就让评分自己截断 */
.ls-tch-right {
  flex-shrink: 0;
  max-width: 220rpx;
  margin-left: 16rpx;
  text-align: right;
}
.ls-stars {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 36rpx;
}
.ls-star-icon {
  margin-left: 2rpx;
}
.ls-star-icon { width: 28rpx; height: 28rpx; }
.ls-star-none {
  font-size: 22rpx;
  color: #98a3b8;
}
.ls-tch-scores {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}
.ls-tch-score {
  font-size: 26rpx;
  color: #d98c0b;
}
.ls-tch-score--muted { color: #6f7b91; }
.ls-tch-good {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #128a56;
}

/* ---------- 空状态 / 分页提示 ---------- */
.ls-empty {
  padding: 48rpx 32rpx;
  text-align: center;
}
/* .empty-title / .empty-desc 来自 app.wxss：30rpx 600 + 24rpx 次要色 */
.ls-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 40rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #eff4ff;
  color: #2047c9;
  font-size: 28rpx;
  font-weight: 600;
}
.ls-tail {
  padding: 16rpx 0 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #98a3b8;
}

/* ---------- 底部可信度提示卡 ---------- */
.ls-trust {
  display: flex;
  align-items: center;
  gap: 20rpx;
  /* 虚线描边压住权重：它是说明，不是可点的操作 */
  box-shadow: none;
  border: 2rpx dashed #dce7ff;
  background: #f7faff;
}
.ls-trust-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #eff4ff;
}
.ls-trust-icon image { width: 40rpx; height: 40rpx; }
.ls-trust-main {
  flex: 1;
  min-width: 0;
}
.ls-trust-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
