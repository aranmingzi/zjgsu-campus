<!-- pages/course/teacher/teacher.wxml —— 某位老师的评价页。
     一条评价里老师分 / 课程分是两档，分行排列，谁跟谁对不上就不会看错。
     没有独立入口（tabBar 满了），从课程详情页的「老师评价」进来。 -->
<app-header title="{{navTitle}}" showBack />

<view class="container tc-page" wx:if="{{name}}">
  <view class="card tc-head">
    <view class="title-lg">{{name}}</view>
    <view class="tc-meta">
      <text wx:if="{{verified}}" class="tc-verified">
        <image class="tc-check" src="/assets/icons/check--campus.svg" mode="aspectFit" />已在学校官方名录中<text wx:if="{{college}}"> · {{college}}</text>
      </text>
      <text wx:else class="muted">名录里还没查到这位老师，同学补充</text>
    </view>
    <view wx:if="{{count || otherCount}}" class="tc-score">
      <block wx:if="{{avg > 0}}">
        <text class="tc-avg">{{avg}}</text>
        <view class="tc-stars">
          <image wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="tc-star-icon" src="/assets/icons/star--{{s <= avgRound ? 'amber' : 'faint'}}.svg" mode="aspectFit" />
        </view>
        <text class="muted tc-scored">{{scoredCount}} 人给老师打分</text>
      </block>
      <block wx:else>
        <text class="muted">还没有人单独给这位老师打分</text>
      </block>
      <!-- 课程分是另一档：说「提到这位老师的这些评价里，课本身怎么样」 -->
      <view wx:if="{{courseAvg > 0}}" class="tc-course-line">这些评价里的课程分：{{courseAvg}}</view>
    </view>
  </view>

  <view class="title-md tc-section">{{courseName || '这门课'}}的评价（{{count}}）</view>

  <view wx:if="{{count === 0}}" class="tc-empty">
    <image class="tc-empty-icon" src="/assets/icons/notebook-pen--faint.svg" mode="aspectFit" />
    <view class="empty-title">还没有针对 {{name}} 的评价</view>
  </view>

  <view wx:for="{{reviews}}" wx:key="id" wx:for-item="rv" class="card">
    <view class="tc-review-head">
      <text class="tc-review-name">{{rv.showName}}</text>
      <text class="muted tc-review-time">{{rv.time}}</text>
    </view>
    <view class="tc-scores">
      <view wx:if="{{rv.hasTeacherScore}}" class="tc-score-row">
        <text class="tc-score-label">老师</text>
        <view class="tc-stars">
          <image wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="tc-star-icon" src="/assets/icons/star--{{s <= rv.teacherStarOn ? 'amber' : 'faint'}}.svg" mode="aspectFit" />
        </view>
        <text class="tc-score-text">{{rv.scoreText}}</text>
      </view>
      <view class="tc-score-row">
        <text class="tc-score-label">课程</text>
        <view class="tc-stars">
          <image wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="tc-star-icon" src="/assets/icons/star--{{s <= rv.starOn ? 'amber' : 'faint'}}.svg" mode="aspectFit" />
        </view>
        <text class="tc-score-text">{{rv.courseText}}</text>
      </view>
    </view>
    <view class="tc-review-content">{{rv.content}}</view>
  </view>

  <view wx:if="{{otherCount}}" class="title-md tc-section">其他课里的评价（{{otherCount}}）</view>
  <view wx:for="{{otherReviews}}" wx:key="id" wx:for-item="rv" class="card pressable" data-id="{{rv.courseId}}" bindtap="goCourse">
    <view class="tc-review-head">
      <text class="tc-review-course">{{rv.courseName}}</text>
      <text class="muted tc-review-time">{{rv.time}}</text>
    </view>
    <view class="tc-scores">
      <view wx:if="{{rv.hasTeacherScore}}" class="tc-score-row">
        <text class="tc-score-label">老师</text>
        <view class="tc-stars">
          <image wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="tc-star-icon" src="/assets/icons/star--{{s <= rv.teacherStarOn ? 'amber' : 'faint'}}.svg" mode="aspectFit" />
        </view>
        <text class="tc-score-text">{{rv.scoreText}}</text>
      </view>
      <view class="tc-score-row">
        <text class="tc-score-label">课程</text>
        <view class="tc-stars">
          <image wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="tc-star-icon" src="/assets/icons/star--{{s <= rv.starOn ? 'amber' : 'faint'}}.svg" mode="aspectFit" />
        </view>
        <text class="tc-score-text">{{rv.courseText}}</text>
      </view>
    </view>
    <view class="tc-review-content">{{rv.content}}</view>
  </view>

  <view class="fixed-bar tc-bar">
    <base-button block bindtap="goReview">写对 {{name}} 的评价</base-button>
  </view>
</view>
