/* pages/course/teacher —— 老师评价页。类名一律 tc-*，
   .card / .title-lg / .title-md / .muted 这些来自 app.wxss。 */
.tc-page {
  padding-bottom: 200rpx;
}

.tc-head {
  text-align: center;
}
.tc-meta {
  margin-top: 8rpx;
}
.tc-verified {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: #128a56;
}
.tc-check {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}
.tc-score {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.tc-avg {
  font-size: 56rpx;
  font-weight: 700;
  color: #d98c0b;
  line-height: 1.1;
  margin-right: 14rpx;
}
.tc-stars {
  display: flex;
  align-items: center;
}
.tc-star-icon {
  margin-right: 2rpx;
}
.tc-star-icon { width: 28rpx; height: 28rpx; }
.tc-scored {
  margin-left: 14rpx;
  font-size: 24rpx;
}
.tc-course-line {
  width: 100%;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6f7b91;
}

.tc-section {
  margin: 8rpx 4rpx 16rpx;
  font-size: 30rpx;
}

.tc-empty {
  padding: 48rpx 32rpx;
  text-align: center;
}
.tc-empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
}

/* 一条评价里两档分：老师分 / 课程分行排列，谁跟谁对不上就不会看错 */
.tc-review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.tc-review-name {
  font-size: 28rpx;
  font-weight: 600;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tc-review-course {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b5aed;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tc-review-time {
  flex-shrink: 0;
  font-size: 22rpx;
}
.tc-scores {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 14rpx;
}
.tc-score-row {
  display: flex;
  align-items: center;
}
.tc-score-label {
  width: 56rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #98a3b8;
}
.tc-score-text {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #d98c0b;
}
.tc-review-content {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #172033;
  line-height: 1.7;
  white-space: pre-wrap;
}

.tc-bar {
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 2rpx solid #e8edf5;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}
