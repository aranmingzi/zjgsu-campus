/* pages/course/review —— 写 / 改评价。类名一律 rv-*，
   app.wxss 里的 .card / .tag / .title-sm / .muted 直接复用。
   底部留出 200rpx 给最后一组按钮，别让「提交」贴着屏幕底边。 */
.rv-page {
  padding-bottom: 200rpx;
}

.rv-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.rv-course {
  margin-top: 6rpx;
}

/* ---------- 评分对象 + 星条 ---------- */
.rv-targets {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.rv-target {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #f4f6f9;
  border: 2rpx solid #e6e9ee;
  font-size: 26rpx;
  color: #6f7b91;
}
.rv-target-on {
  background: #2b5aed;
  border-color: #2b5aed;
  color: #ffffff;
  font-weight: 600;
}
.rv-target-num {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #98a3b8;
}
.rv-target-on .rv-target-num { color: #ffe0b2; }
.rv-target-off {
  border-style: dashed;
  color: #b0b6be;
}

.rv-scale-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #172033;
  margin-bottom: 12rpx;
}

.rv-stars {
  display: flex;
  align-items: center;
}
/* 星：热区 88rpx，图标 60rpx，够点也够看 */
.rv-star {
  width: 96rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rv-star-icon {
  width: 56rpx;
  height: 56rpx;
}
.rv-star-text {
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #d98c0b;
}
/* 老师分用偏暖的橙色，和课程分的蓝调区分开，一眼看得出在打哪个分 */
.rv-star-text--warm { color: #f58a32; }
.rv-star-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.rv-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6f7b91;
}
.rv-tip-ok {
  display: flex;
  align-items: center;
  color: #128a56;
}
.rv-tip-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

/* ---------- 匿名 ---------- */
.rv-anon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.rv-anon-main {
  min-width: 0;
}
.rv-anon-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
}

/* ---------- 标签多选 ---------- */
.rv-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
/* 没选中的标签盖掉 .tag 的场景色，保持「可多选但还没选」的观感 */
.rv-tag-off {
  background: #f0f1f3;
  color: #6f7b91;
}
.rv-picked {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.rv-picked-label { font-size: 24rpx; }
.rv-picked-tag { background: #eff4ff; color: #2047c9; }

/* ---------- 任课老师 ---------- */
.rv-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #172033;
  background: #f6f8fb;
  border-radius: 24rpx;
  box-sizing: border-box;
}
.rv-match {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.rv-match-chip {
  font-size: 24rpx;
  color: #6f7b91;
  background: #f2f4f7;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}
.rv-match-chip-on {
  background: #2b5aed;
  color: #ffffff;
  font-weight: 600;
}
.rv-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 88rpx;
  margin-top: 16rpx;
  border-radius: 24rpx;
  background: #eff4ff;
  color: #2047c9;
  font-size: 26rpx;
  font-weight: 600;
}
.rv-add-icon {
  width: 30rpx;
  height: 30rpx;
}
.rv-to-teacher {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #e3e7ec;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #2b5aed;
}

/* ---------- 正文 ---------- */
.rv-textarea {
  width: 100%;
  height: 260rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #172033;
  box-sizing: border-box;
  background: #f6f8fb;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}
.rv-counter {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: #98a3b8;
}

/* ---------- 底部按钮组 ---------- */
.rv-submit {
  display: block;
  margin-top: 12rpx;
}
.rv-submit base-button { margin-bottom: 20rpx; }
