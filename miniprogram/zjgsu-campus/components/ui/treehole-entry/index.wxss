/* components/ui/treehole-entry/index.wxss */
.ui-hole {
  position: relative;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #7357ff 0%, #5b46d6 55%, #4a3bb8 100%);
  box-shadow: 0 8rpx 24rpx rgba(115, 87, 255, 0.24);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.ui-hole--hover { opacity: 0.85; transform: scale(0.99); }

/* 星点颗粒 */
.ui-hole__star {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
}
.ui-hole__star--1 { width: 8rpx; height: 8rpx; top: 32rpx; left: 48rpx; }
.ui-hole__star--2 { width: 6rpx; height: 6rpx; top: 96rpx; left: 128rpx; opacity: 0.6; }
.ui-hole__star--3 { width: 8rpx; height: 8rpx; top: 48rpx; right: 96rpx; opacity: 0.55; }
.ui-hole__star--4 { width: 6rpx; height: 6rpx; top: 132rpx; right: 44rpx; opacity: 0.45; }

.ui-hole__inner {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
}

.ui-hole__art {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
}

.ui-hole__text { flex: 1; min-width: 0; }

.ui-hole__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.ui-hole__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.ui-hole__privacy {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  width: fit-content;
}

.ui-hole__shield { width: 24rpx; height: 24rpx; }

.ui-hole__go {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 24rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.ui-hole__go-icon { width: 28rpx; height: 28rpx; }
